"""
The host boundary: the few Rust interop calls the tool needs, kept in one module so the rest is plain Incan.

The standard library has no argument vector, no HTTP client, no symlink reading and no process control; those come
from Rust's standard library here and nowhere else. Downloads go through the host's `curl`.
"""

from rust::std::env import args, current_dir, current_exe, var
from rust::std::fs import canonicalize, read_link
from rust::std::process import Command, exit


pub def argv() -> list[str]:
    """Return the process arguments, program name first."""
    mut out: list[str] = []
    for argument in args():
        out.append(argument)
    return out


@derive(Clone)
pub model Ran:
    """What a program run under `run_program` left behind."""

    pub success: bool
    pub stdout: bytes
    pub stderr: bytes


pub def run_program(program: str, arguments: list[str], environment: Dict[str, str], directory: str) -> Result[Ran, str]:
    """Run `program` in `directory` with exactly `environment`: nothing of this process's environment leaks in."""
    mut command = Command.new(program.to_string())
    for argument in arguments:
        command.arg(argument.to_string())
    command.env_clear()
    for key in environment.keys():
        command.env(key.to_string(), environment[key].to_string())
    command.current_dir(directory.to_string())
    match command.output():
        Ok(output) => return Ok(Ran(success=output.status.success(), stdout=output.stdout, stderr=output.stderr))
        Err(error) => return Err(f"{program} could not run: {error}")


pub def run_passthrough(program: str, arguments: list[str]) -> Result[int, str]:
    """Run `program` with this process's environment, working directory and standard streams; return its exit code."""
    mut command = Command.new(program.to_string())
    for argument in arguments:
        command.arg(argument.to_string())
    match command.status():
        Ok(status) =>
            code: i32 = status.code().unwrap_or(1)
            wide: int = code
            return Ok(wide)
        Err(error) => return Err(f"{program} could not run: {error}")


pub def environment_value(name: str) -> Option[str]:
    """One variable of this process's environment."""
    match var(name.to_string()):
        Ok(value) => return Some(value)
        Err(_) => return None


pub def working_directory() -> Result[str, str]:
    """This process's working directory, canonical."""
    match current_dir():
        Ok(directory) => return canonical_path(directory.to_string_lossy().to_string())
        Err(error) => return Err(f"working directory: {error}")


pub def executable_path() -> Result[str, str]:
    """The running executable, canonical."""
    match current_exe():
        Ok(path) => return canonical_path(path.to_string_lossy().to_string())
        Err(error) => return Err(f"current executable: {error}")


pub def canonical_path(path: str) -> Result[str, str]:
    """`path` with every symlink and `.`/`..` resolved; it must exist."""
    match canonicalize(path.to_string()):
        Ok(resolved) => return Ok(resolved.to_string_lossy().to_string())
        Err(error) => return Err(f"{path}: {error}")


pub def link_target(path: str) -> Result[str, str]:
    """What the symlink at `path` points to, as written."""
    match read_link(path.to_string()):
        Ok(target) => return Ok(target.to_string_lossy().to_string())
        Err(error) => return Err(f"{path}: {error}")


pub def exit_with(code: int) -> None:
    narrow: i32 = code.saturating_resize[i32]()
    exit(narrow)


pub def download(url: str, destination: str) -> Result[None, str]:
    """Fetch `url` into the file `destination`, failing on any HTTP error status."""
    mut command = Command.new("curl")
    # Each argument is passed as its own copy: handing the parameter itself to a Rust method moves it (encero-systems/incan#1611).
    command.arg("-sSfL").arg("--retry").arg("3").arg("-o").arg(destination.to_string()).arg(url.to_string())
    match command.status():
        Ok(status) =>
            if status.success():
                return Ok(None)
            return Err(f"download failed: {url}")
        Err(error) => return Err(f"curl could not run: {error}")
