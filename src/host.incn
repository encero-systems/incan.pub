"""
The host boundary: the few Rust interop calls the tool needs, kept in one module so the rest is plain Incan.

The standard library has no argument vector and no HTTP client; both come from Rust's standard library here and
nowhere else. Downloads go through the host's `curl`, the one program adoption runs.
"""

from rust::std::env import args
from rust::std::process import Command


pub def argv() -> list[str]:
    """Return the process arguments, program name first."""
    mut out: list[str] = []
    for argument in args():
        out.append(argument)
    return out


pub def download(url: str, destination: str) -> Result[None, str]:
    """Fetch `url` into the file `destination`, failing on any HTTP error status."""
    mut command = Command.new("curl")
    # Each argument is passed as its own copy: handing the parameter itself to a Rust method moves it (encero-systems/incan#1611).
    command.arg("-sSfL").arg("--retry").arg("3").arg("-o").arg(destination.to_string()).arg(url.to_string())
    match command.status():
        Ok(status) =>
            if status.success():
                return Ok(None)
            return Err(f"download failed: {url}")
        Err(error) => return Err(f"curl could not run: {error}")
