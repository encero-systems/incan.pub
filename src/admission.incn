"""
Admission: folding the log into the registry's current state, applying every rule in order.

The registry is a notary, not a judge. These rules establish that an event is well-formed, that it names something
that exists, that nothing published is changed, and that committed bytes match the digests that name them. They
cannot establish that a `cfg` answer is true; that is what harvest evidence and attestation are for.
"""

from std.fs import Path
from std.json import JsonValue

from adoption import (
    Adoption,
    adoption_from_payload,
    among,
    content_path,
    loaf_name,
    render_adopted_manifest,
    required_dependencies,
)
from canonical import canonical, digest_bytes, digest_text, is_sha256_identity
from events import Event, member, string_list_member, string_member
from graph import validate_evidence
from registry import (
    Asset,
    Attestation,
    Binding,
    EnvironmentEntry,
    Fact,
    OutEntry,
    Record,
    binding_keys,
    builders,
    crates_io_index,
    fact_key,
    fact_keys,
    has_key,
    profiles,
    record_key,
    sorted_unique,
    status_attested,
    status_harvested,
)
from semver import parse_requirement, parse_version, satisfies


pub def replay(events: list[Event], root: Path) -> Result[Dict[str, Record], str]:
    """Fold the log into the current state, or say which event breaks which rule."""
    return replay_onto({}, events, root)


pub def replay_onto(initial: Dict[str, Record], events: list[Event], root: Path) -> Result[Dict[str, Record], str]:
    """
    Fold more events onto a state already folded from the events before them.

    Folding is a left fold, so the state after a prefix plus the events after it is the state after the whole log;
    that is what lets a drop fold the log once and then only what each proposal appends.
    """
    mut state = initial
    mut adopted = adopted_versions(state)
    for event in events:
        key = record_key(event.name, event.version)
        if event.kind == "publish":
            if key in state:
                return Err(f"{event.label}: {event.name} {event.version} is already published; versions are immutable")
            state[key] = fold_publish(event)?
            continue
        if event.kind == "adopt":
            state[key] = fold_adopt(state, adopted, event, root)?
            mut versions: list[str] = []
            if event.name in adopted:
                versions = adopted[event.name]
            if not versions.contains(event.version):
                versions.append(event.version)
            adopted[event.name] = versions
            continue
        if key not in state:
            return Err(f"{event.label}: {event.name} {event.version} has no publish or adopt event before this {event.kind}")
        state[key] = fold_record_event(state[key], event, root)?
    return Ok(state)


def fold_publish(event: Event) -> Result[Record, str]:
    """A v0 external-source record: the crates.io checksum, before anything is adopted or bound."""
    source = event.payload("source")
    checksum = string_member(source, "checksum")
    if string_member(source, "registry") != crates_io_index() or not is_sha256_identity(checksum):
        return Err(f"{event.label}: source must name the crates.io index and a `sha256:` checksum")
    return Ok(Record(
        name=event.name,
        version=event.version,
        registry=crates_io_index(),
        checksum=checksum,
        notes=string_member(event.body, "notes"),
        adopter=event.actor,
        facts={},
        yanked=false,
        assets=[],
        advisories=[],
        adopt=None,
        publisher="",
        adopted_at="",
    ))


pub def adopted_adoptions(state: Dict[str, Record]) -> Result[Dict[str, Adoption], str]:
    """What the log adopted for every adopted version, keyed `<package>\t<version>`; adoption plans across it."""
    mut out: Dict[str, Adoption] = {}
    for key in state.keys():
        record = state[key]
        match record.adopt:
            Some(payload) =>
                out[record.name + "\t" + record.version] = adoption_from_payload(payload, f"{record.name} {record.version}")?
            None => pass
    return Ok(out)


pub def adopted_versions(state: Dict[str, Record]) -> Dict[str, list[str]]:
    """The adopted versions of every package, which is what a dependency requirement is checked against."""
    mut out: Dict[str, list[str]] = {}
    for key in state.keys():
        record = state[key]
        match record.adopt:
            Some(_) =>
                mut versions: list[str] = []
                if record.name in out:
                    versions = out[record.name]
                versions.append(record.version)
                out[record.name] = versions
            None => pass
    return out


def fold_adopt(
    state: Dict[str, Record], adopted: Dict[str, list[str]], event: Event, root: Path
) -> Result[Record, str]:
    """
    Admit an `adopt` event: a payload in shape, a manifest digest the payload reproduces, and every dependency
    requirement active under its default features, on any target, already met by an adopted version.
    """
    label = event.label
    adoption = adoption_from_payload(event.body, label)?
    if adoption.package != event.name or adoption.version != event.version:
        return Err(f"{label}: the adopted package and version must be the event's subject")
    if not is_sha256_identity(adoption.checksum):
        return Err(f"{label}: adopted.checksum must be a `sha256:` identity")
    manifest = string_member(event.body, "manifest")
    archive = string_member(event.body, "archive")
    if not is_sha256_identity(manifest) or not is_sha256_identity(archive):
        return Err(f"{label}: `manifest` and `archive` must be `sha256:` identities")
    if digest_text(render_adopted_manifest(adoption)) != manifest:
        return Err(f"{label}: `manifest` is not the digest of the manifest this payload renders")
    validate_documents(event.body, root, label)?
    for dependency in required_dependencies(adoption):
        if not requirement_met(adopted, dependency.package, dependency.req, label)?:
            return Err(
                f"{label}: dependency `{dependency.key}` ({loaf_name(dependency.package)} {dependency.req}) has no adopted version; "
                + "adoption is closed under dependencies"
            )
    payload = adopt_payload(event.body)
    key = record_key(event.name, event.version)
    if key not in state:
        return Ok(Record(
            name=event.name,
            version=event.version,
            registry=crates_io_index(),
            checksum=adoption.checksum,
            notes="",
            adopter=event.actor,
            facts={},
            yanked=false,
            assets=[],
            advisories=[],
            adopt=Some(payload),
            publisher=event.actor,
            adopted_at=event.at,
        ))
    mut record = state[key]
    match record.adopt:
        Some(existing) =>
            if canonical(existing)? != canonical(payload)?:
                return Err(f"{label}: {event.name} {event.version} is already adopted differently; an adoption is immutable")
            return Ok(record)
        None => pass
    if record.checksum != adoption.checksum:
        return Err(f"{label}: the adopted checksum differs from the published record's")
    record.adopt = Some(payload)
    record.publisher = event.actor
    record.adopted_at = event.at
    return Ok(record)


const DOCUMENT_ROLES: FrozenList[str] = ["readme", "license", "license-notice", "changelog"]
const DOCUMENT_FORMATS: FrozenList[str] = ["markdown", "text", "restructuredtext", "asciidoc"]


def validate_documents(body: JsonValue, root: Path, label: str) -> Result[None, str]:
    """
    An adoption's `documents` in shape, each held to its bytes at `content/sha256/<hex>`: a role, the path in the
    archive, a `sha256:` digest, the byte count, a format and an origin. Adoptions recorded before documents have none.
    """
    match body.get("documents"):
        Some(value) =>
            match value.as_array():
                Some(documents) =>
                    for document in documents:
                        validate_document(document, root, label)?
                None => return Err(f"{label}: `documents` must be a list")
        None => pass
    return Ok(None)


def validate_document(document: JsonValue, root: Path, label: str) -> Result[None, str]:
    path = string_member(document, "path")
    for key in document.keys():
        if not ["role", "path", "digest", "bytes", "format", "origin"].contains(key):
            return Err(f"{label}: document {path} has an unknown key `{key}`")
    role = string_member(document, "role")
    if not among(DOCUMENT_ROLES, role):
        return Err(f"{label}: document {path} has role `{role}`, not one of readme, license, license-notice, changelog")
    if len(path) == 0 or path.startswith("/") or path.split("/").contains(".."):
        return Err(f"{label}: a document needs a plain relative path in the archive")
    if not among(DOCUMENT_FORMATS, string_member(document, "format")):
        return Err(f"{label}: document {path} has an unknown format")
    origin = string_member(document, "origin")
    if origin != "package" and origin != "registry":
        return Err(f"{label}: document {path} has origin `{origin}`, not package or registry")
    digest = string_member(document, "digest")
    if not is_sha256_identity(digest):
        return Err(f"{label}: document {path} needs a `sha256:` digest")
    content = root / content_path(digest)
    match content.read_bytes():
        Ok(data) =>
            if digest_bytes(data) != digest:
                return Err(f"{label}: document {path}: {content_path(digest)} does not hold its bytes")
            match document.get("bytes"):
                Some(count) =>
                    if count.as_int().unwrap_or(-1) != len(data):
                        return Err(f"{label}: document {path} states a byte count other than its bytes'")
                None => return Err(f"{label}: document {path} needs its byte count")
        Err(_) => return Err(f"{label}: document {path} names {content_path(digest)}, which the checkout lacks")
    return Ok(None)


pub def adopt_payload(body: JsonValue) -> JsonValue:
    """The members of an `adopt` event that state the adoption, without the event envelope."""
    mut payload: Dict[str, JsonValue] = {}
    for key in ["about", "files", "documents", "vcs", "taxonomy", "adopted", "rust", "features", "deps", "manifest", "archive"]:
        match body.get(key):
            Some(value) => payload[key] = value
            None => pass
    return JsonValue.object(payload)


pub def requirement_met(adopted: Dict[str, list[str]], package: str, requirement: str, label: str) -> Result[bool, str]:
    """Whether some adopted version of `package` satisfies `requirement`."""
    comparators = parse_requirement(requirement)?
    if package not in adopted:
        return Ok(false)
    for text in adopted[package]:
        match parse_version(text):
            Ok(version) =>
                if satisfies(version, comparators):
                    return Ok(true)
            Err(message) => return Err(f"{label}: {message}")
    return Ok(false)


def fold_record_event(initial: Record, event: Event, root: Path) -> Result[Record, str]:
    """Fold one event about an existing record: a bound fact, an attestation, an asset, a yank or an advisory."""
    mut record = initial
    if event.kind == "fact":
        validate_evidence(event.payload("evidence"), root, event.label)?
        fact = validate_fact(event.payload("fact"), event.name, event.version, event.label, root)?
        selected = fact.key()
        if has_key(record.facts, selected):
            if record.facts[selected].comparable != fact.comparable:
                return Err(f"{event.label}: binding {describe_binding(fact.binding)}{describe_owners(fact.owners)} already has a different record; a fact is immutable")
            return Ok(record)
        record.facts[selected] = fact
    elif event.kind == "attest":
        binding = validate_binding(event.payload("binding"), event.label)?
        mut owners: list[str] = []
        match string_list_member(event.body, "owners"):
            Some(values) =>
                if not sorted_unique(values):
                    return Err(f"{event.label}: owners must be a sorted, unique list")
                owners = values
            None => pass
        binding_key = fact_key(binding, owners)
        if not has_key(record.facts, binding_key):
            return Err(f"{event.label}: attestation names a binding with no fact record")
        attestation = event.payload("attestation")
        for field in ["asset", "unit_identity", "reference"]:
            if len(string_member(attestation, field)) == 0:
                return Err(f"{event.label}: attestation requires `{field}`")
        asset = string_member(attestation, "asset")
        unit_identity = string_member(attestation, "unit_identity")
        if not is_sha256_identity(asset) or not is_sha256_identity(unit_identity):
            return Err(f"{event.label}: attestation asset and unit identity must be `sha256:` identities")
        mut fact = record.facts[binding_key]
        fact.attestations.append(Attestation(
            asset=asset,
            unit_identity=unit_identity,
            reference=string_member(attestation, "reference"),
        ))
        fact.status = status_attested()
        record.facts[binding_key] = fact
    elif event.kind == "asset":
        record = admit_asset(record, event.payload("binding"), event.payload("asset"), event.label)?
    elif event.kind == "yank":
        record.yanked = true
    elif event.kind == "unyank":
        record.yanked = false
    elif event.kind == "advisory":
        advisory = event.payload("advisory")
        if len(string_member(advisory, "text").strip()) == 0:
            return Err(f"{event.label}: an advisory carries a non-empty `text`")
        record.advisories.append(advisory)
    return Ok(record)


pub def admit_asset(initial: Record, binding_value: JsonValue, asset: JsonValue, label: str) -> Result[Record, str]:
    """
    Add one baked unit to an adopted record, or return the record unchanged when it already holds that very asset.

    A unit compiles from the adopted source Loaf, so the version must be adopted. Facts are not checked: a unit's identity
    retains the cfg facts and generated inputs it compiled under (RFC 119 rule 9), so a unit compiled without the facts
    a plan selects never matches that plan, and only the crate archive, which admission does not read, says whether a
    binding needs a fact at all (a package without a build script needs none). One unit identity names one archive: a
    second archive for it is a determinism conflict and is refused, so a consumer is never offered two payloads for one
    identity (RFC 125).
    """
    mut record = initial
    for field in ["archive", "unit_identity", "entry", "payload", "builder", "attestation"]:
        if len(string_member(asset, field)) == 0:
            return Err(f"{label}: asset requires `{field}`")
    for field in ["archive", "unit_identity", "entry", "payload"]:
        if not is_sha256_identity(string_member(asset, field)):
            return Err(f"{label}: asset `{field}` must be a `sha256:` identity")
    if not builders().contains(string_member(asset, "builder")):
        return Err(f"{label}: asset builder must be publisher, registry or local")
    location = member(asset, "location")
    for field in ["registry", "repository", "tag"]:
        if len(string_member(location, field)) == 0:
            return Err(f"{label}: asset location requires `{field}`")
    binding = validate_binding(binding_value, label)?
    match record.adopt:
        Some(_) => pass
        None => return Err(f"{label}: an asset is compiled from an adopted source Loaf; {record.name} {record.version} is not adopted")
    unit_identity = string_member(asset, "unit_identity")
    archive = string_member(asset, "archive")
    for present in record.assets:
        if present.unit_identity == unit_identity:
            if present.archive == archive:
                return Ok(record)
            return Err(f"{label}: unit {unit_identity} already has asset {present.archive}; a second archive for one unit is a determinism conflict")
    record.assets.append(Asset(
        binding=binding,
        archive=archive,
        unit_identity=unit_identity,
        entry=string_member(asset, "entry"),
        payload=string_member(asset, "payload"),
        builder=string_member(asset, "builder"),
        attestation=string_member(asset, "attestation"),
        location=location,
    ))
    return Ok(record)


pub def validate_binding(binding: JsonValue, label: str) -> Result[Binding, str]:
    """Check the four binding keys and return the typed binding."""
    for key in ["toolchain", "target", "profile", "features"]:
        if not binding.contains_key(key):
            return Err(f"{label}: missing binding key `{key}`")
    toolchain = string_member(binding, "toolchain")
    target = string_member(binding, "target")
    profile = string_member(binding, "profile")
    if len(toolchain.strip()) == 0 or toolchain.contains("\t") or toolchain.contains("\n"):
        return Err(f"{label}: toolchain must name the exact compiler")
    if len(target.strip()) == 0 or target.contains("\t") or target.contains("\n"):
        return Err(f"{label}: target must name a triple")
    if not profiles().contains(profile):
        allowed = ", ".join(profiles())
        return Err(f"{label}: profile must be one of {allowed}")
    match string_list_member(binding, "features"):
        Some(features) =>
            if not sorted_unique(features):
                return Err(f"{label}: features must be a sorted, unique list")
            for feature in features:
                if feature.contains("\t") or feature.contains("\n"):
                    return Err(f"{label}: features must be a sorted, unique list")
            return Ok(Binding(toolchain=toolchain, target=target, profile=profile, features=features))
        None => return Err(f"{label}: features must be a sorted, unique list")


pub def validate_fact(fact: JsonValue, name: str, version: str, label: str, root: Path) -> Result[Fact, str]:
    """Check one bound fact record against the vocabulary and the committed generated inputs it names."""
    binding = validate_binding(fact, label)?
    mut unknown: list[str] = []
    for key in sorted(fact.keys()):
        if not fact_keys().contains(key):
            unknown.append(key)
    if len(unknown) > 0:
        listed = ", ".join(unknown)
        return Err(f"{label}: unknown fact keys [{listed}]")
    mut cfg: list[str] = []
    match string_list_member(fact, "cfg"):
        Some(values) =>
            if not sorted_unique(values):
                return Err(f"{label}: cfg must be a sorted, unique list; an empty list is a stated fact")
            cfg = values
        None => return Err(f"{label}: cfg must be a sorted, unique list; an empty list is a stated fact")
    out_dir = root / "crates-io" / name / version
    mut out: list[OutEntry] = []
    mut names: list[str] = []
    mut out_items: list[JsonValue] = []
    match fact.get("out"):
        Some(value) =>
            match value.as_array():
                Some(items) => out_items = items
                None => return Err(f"{label}: out must be a list of entries")
        None => pass
    for entry in out_items:
        for field in ["name", "path", "digest"]:
            if not entry.contains_key(field):
                return Err(f"{label}: out entry missing `{field}`")
        entry_name = string_member(entry, "name")
        entry_path = string_member(entry, "path")
        entry_digest = string_member(entry, "digest")
        if entry_path.startswith("/") or entry_path.split("/").contains(".."):
            return Err(f"{label}: out `{entry_name}` must be a plain relative path")
        committed = out_dir / entry_path
        if not committed.is_file():
            return Err(f"{label}: out `{entry_name}` names a missing committed file {entry_path}")
        match committed.read_bytes():
            Ok(data) =>
                if digest_bytes(data) != entry_digest:
                    return Err(f"{label}: out `{entry_name}` digest does not match the committed bytes")
            Err(error) => return Err(f"{label}: out `{entry_name}`: {error.message()}")
        if names.contains(entry_name):
            return Err(f"{label}: out `{entry_name}` is declared twice")
        names.append(entry_name)
        out.append(OutEntry(name=entry_name, path=entry_path, digest=entry_digest))
    environment = validate_environment(fact, label)?
    validate_producers(fact, label)?
    validate_one_producer_per_generated_file(fact, names, label)?
    mut harvested_from: Option[str] = None
    match fact.get("harvested-from"):
        Some(_) =>
            harvested = string_member(fact, "harvested-from")
            if not is_sha256_identity(harvested):
                return Err(f"{label}: harvested-from must be a `sha256:` receipt identity")
            harvested_from = Some(harvested)
        None => pass
    link = producer_records(fact, "link", label)?
    tool = producer_records(fact, "tool", label)?
    return Ok(Fact(
        binding=binding,
        cfg=cfg,
        out=out,
        environment=environment,
        link=link,
        tool=tool,
        harvested_from=harvested_from,
        comparable=fact_comparable(fact)?,
        status=status_harvested(),
        attestations=[],
        owners=executable_owners(link + tool),
    ))


def validate_environment(fact: JsonValue, label: str) -> Result[list[EnvironmentEntry], str]:
    """
    The variables a fact sets for the crate's compile, as the compiler's RustFactRecord states them: sorted by unique
    name, each with exactly one of `literal` and `out`, an `out` a portable path below `OUT_DIR` (`.` for itself).
    """
    mut items: list[JsonValue] = []
    match fact.get("environment"):
        Some(value) =>
            match value.as_array():
                Some(found) => items = found
                None => return Err(f"{label}: environment must be a list of entries")
        None => return Ok([])
    mut entries: list[EnvironmentEntry] = []
    mut names: list[str] = []
    for item in items:
        name = string_member(item, "name")
        if len(name) == 0 or name.contains("="):
            return Err(f"{label}: an environment entry needs a name without `=`")
        for key in item.keys():
            if key != "name" and key != "literal" and key != "out":
                return Err(f"{label}: environment `{name}` has an unknown key `{key}`")
        has_literal = item.contains_key("literal")
        has_out = item.contains_key("out")
        if has_literal == has_out:
            return Err(f"{label}: environment `{name}` must state exactly one of `literal` and `out`")
        if names.contains(name):
            return Err(f"{label}: environment `{name}` is declared twice")
        if len(names) > 0 and name < names[len(names) - 1]:
            return Err(f"{label}: environment entries must be sorted by name")
        names.append(name)
        if has_out:
            path = string_member(item, "out")
            if not portable_out_path(path):
                return Err(f"{label}: environment `{name}` out `{path}` is not a portable path below OUT_DIR")
            entries.append(EnvironmentEntry(name=name, literal=None, out=Some(path)))
        else:
            entries.append(EnvironmentEntry(name=name, literal=Some(string_member(item, "literal")), out=None))
    return Ok(entries)


def portable_out_path(path: str) -> bool:
    """`.`, or relative segments without `.`, `..` or empty ones."""
    if path == ".":
        return true
    if len(path) == 0 or path.startswith("/") or path.endswith("/"):
        return false
    for segment in path.split("/"):
        if len(segment) == 0 or segment == "." or segment == "..":
            return false
    return true


pub def executable_owners(records: list[JsonValue]) -> list[str]:
    """The sorted, unique owner identities of the executables `link` and `tool` records run."""
    mut owners: list[str] = []
    for record in records:
        owner = string_member(member(record, "executable"), "owner")
        if not owners.contains(owner):
            owners.append(owner)
    return sorted(owners)


pub def fact_owners(fact: JsonValue) -> list[str]:
    """`executable_owners` of a fact as it is written in an event."""
    mut records: list[JsonValue] = []
    for table in ["link", "tool"]:
        match fact.get(table):
            Some(value) =>
                match value.as_array():
                    Some(items) => records = records + items
                    None => pass
            None => pass
    return executable_owners(records)


pub def fact_comparable(fact: JsonValue) -> Result[str, str]:
    """
    Everything a later record for the same binding must repeat exactly: every fact key except the binding itself and
    `harvested-from`, which names the observation rather than the answer.

    Reading the keys off the record instead of naming `cfg` and `out` means a key the vocabulary gains later is
    immutable on the day it is admitted, rather than silently ignorable until someone remembers this function.
    An omitted key and a stated absence — an empty list or table — are the same fact, and the rendered record
    spells both by omitting the key.
    """
    mut subset: Dict[str, JsonValue] = {}
    for key in sorted(fact.keys()):
        if binding_keys().contains(key) or key == "harvested-from":
            continue
        match fact.get(key):
            Some(value) =>
                if not is_stated_absence(value):
                    subset[key] = value
            None => pass
    return canonical(JsonValue.object(subset))


def is_stated_absence(value: JsonValue) -> bool:
    """Whether a value says exactly what omitting its key says: an empty list or an empty table."""
    if value.is_array():
        return value.len() == 0
    if value.is_object():
        return len(value.keys()) == 0
    return false


pub def describe_binding(binding: Binding) -> str:
    features = ", ".join(binding.features)
    return f"({binding.toolchain}, {binding.target}, {binding.profile}, [{features}])"


pub def describe_owners(owners: list[str]) -> str:
    """` under owners [...]` for a fact whose link or tool executables name owners; nothing for one without."""
    if len(owners) == 0:
        return ""
    listed = ", ".join(owners)
    return f" under owners [{listed}]"


# ---------------------------------------------------------------- producers -------------------------------------
#
# `link` and `tool` are the publisher-side work RFC 119 declares: a native compile into a named library, and a
# generator run. A record declares the work and its complete inputs; the product bytes are an asset, which is why an
# output carries no digest. The registry admits the declaration, never runs it, and refuses anything it cannot bind:
# an executable without an identity, an input without a digest, an argument naming something undeclared.


def validate_one_producer_per_generated_file(fact: JsonValue, out_names: list[str], label: str) -> Result[None, str]:
    """
    Refuse a generated file that two producers claim.

    An `out` entry's `name` and a tool output's `path` are the same `OUT_DIR`-relative namespace — an `out` entry's
    `path` only says where the committed bytes sit — so a generated file is declared exactly once: committed because
    it was merely observed, or produced by a declared tool. Two claims on one file is the ambiguity RFC 119 refuses
    rather than resolves by order.
    """
    for record in producer_records(fact, "tool", label)?:
        producer = string_member(record, "name")
        for output in producer_records(record, "outputs", label)?:
            path = string_member(output, "path")
            for name in out_names:
                if paths_overlap(name, path):
                    return Err(f"{label}: generated file `{path}` is declared by tool `{producer}` and committed as out `{name}`")
    return Ok(None)


pub def validate_producers(fact: JsonValue, label: str) -> Result[None, str]:
    """Check both producer lists of one record: sorted by unique name, one name space across the two, each closed."""
    mut work_names: list[str] = []
    for kind in ["link", "tool"]:
        mut previous = ""
        for record in producer_records(fact, kind, label)?:
            name = string_member(record, "name")
            validate_producer_name(name, f"{label}: {kind} name")?
            if len(previous) > 0 and not (previous < name):
                return Err(f"{label}: {kind} must be sorted by unique name")
            previous = name.to_string()
            if work_names.contains(name):
                return Err(f"{label}: publisher work name `{name}` is declared twice")
            work_names.append(name.to_string())
            validate_producer(record, kind, f"{label}: {kind} `{name}`")?
    return Ok(None)


def producer_records(fact: JsonValue, kind: str, label: str) -> Result[list[JsonValue], str]:
    match fact.get(kind):
        Some(value) =>
            match value.as_array():
                Some(items) => return Ok(items)
                None => return Err(f"{label}: {kind} must be a list of producer records")
        None => return Ok([])


def validate_producer(record: JsonValue, kind: str, label: str) -> Result[None, str]:
    """Check one `link` or `tool` record against its closed shape and its own declared names."""
    mut allowed = ["environment", "executable", "name", "target"]
    if kind == "link":
        allowed = allowed + ["library", "objects", "sources"]
    else:
        allowed = allowed + ["arguments", "inputs", "outputs"]
    mut unknown: list[str] = []
    for key in sorted(record.keys()):
        if not allowed.contains(key):
            unknown.append(key)
    if len(unknown) > 0:
        listed = ", ".join(unknown)
        return Err(f"{label}: unknown keys [{listed}]")
    target = string_member(record, "target")
    if len(target.strip()) == 0 or target.strip() != target:
        return Err(f"{label}: target must name an exact triple or a `cfg(...)` predicate")
    validate_executable(member(record, "executable"), label)?
    input_key = producer_input_key(kind)
    input_names = validate_artifacts(record, input_key, label)?
    output_names = validate_outputs(record, label)?
    for name in input_names:
        if output_names.contains(name):
            return Err(f"{label}: logical name `{name}` is claimed as both an input and an output")
    for input_path in declared_paths(record, input_key, label)?:
        for output_path in declared_paths(record, "outputs", label)?:
            if paths_overlap(input_path, output_path):
                return Err(f"{label}: input path `{input_path}` overlaps output path `{output_path}`")
    validate_arguments(record, input_names, output_names, label)?
    validate_environment(record, input_names, label)?
    if kind == "link":
        if len(input_names) == 0:
            return Err(f"{label}: sources must declare the complete, non-empty source closure")
        validate_objects(record, input_names, label)?
        library = member(record, "library")
        mut library_unknown: list[str] = []
        for key in sorted(library.keys()):
            if not ["kind", "name"].contains(key):
                library_unknown.append(key)
        if len(library_unknown) > 0:
            listed = ", ".join(library_unknown)
            return Err(f"{label}: library has unknown keys [{listed}]")
        validate_producer_name(string_member(library, "name"), f"{label}: library name")?
        if not ["dynamic", "static"].contains(string_member(library, "kind")):
            return Err(f"{label}: library kind must be `static` or `dynamic`")
    elif len(output_names) == 0:
        return Err(f"{label}: outputs must declare the complete, non-empty output contract")
    return Ok(None)


def declared_paths(record: JsonValue, key: str, label: str) -> Result[list[str], str]:
    """The paths one declared list states, in declaration order."""
    mut paths: list[str] = []
    for entry in producer_records(record, key, label)?:
        paths.append(string_member(entry, "path"))
    return Ok(paths)


def producer_input_key(kind: str) -> str:
    """A link declares `sources`, a tool declares `inputs`; both are one complete, digest-bound input closure."""
    if kind == "tool":
        return "inputs"
    return "sources"


def validate_executable(executable: JsonValue, label: str) -> Result[None, str]:
    """An executable is identified, not carried: an owner identity, an owner-relative path, and its exact bytes."""
    mut unknown: list[str] = []
    for key in sorted(executable.keys()):
        if not ["digest", "name", "owner", "path"].contains(key):
            unknown.append(key)
    if len(unknown) > 0:
        listed = ", ".join(unknown)
        return Err(f"{label}: executable has unknown keys [{listed}]")
    validate_producer_name(string_member(executable, "name"), f"{label}: executable name")?
    validate_portable_path(string_member(executable, "path"), f"{label}: executable path")?
    for key in ["digest", "owner"]:
        if not is_sha256_identity(string_member(executable, key)):
            return Err(f"{label}: executable {key} must be a `sha256:` identity")
    return Ok(None)


def validate_artifacts(record: JsonValue, key: str, label: str) -> Result[list[str], str]:
    """Check one complete input closure: sorted by unique name, every byte bound, a tree cataloged in full."""
    mut names: list[str] = []
    mut paths: list[str] = []
    mut previous = ""
    for artifact in producer_records(record, key, label)?:
        mut unknown: list[str] = []
        for member_key in sorted(artifact.keys()):
            if not ["digest", "kind", "members", "name", "path"].contains(member_key):
                unknown.append(member_key)
        if len(unknown) > 0:
            listed = ", ".join(unknown)
            return Err(f"{label}: {key} has unknown keys [{listed}]")
        name = string_member(artifact, "name")
        validate_producer_name(name, f"{label}: {key} name")?
        if len(previous) > 0 and not (previous < name):
            return Err(f"{label}: {key} must be sorted by unique name")
        previous = name.to_string()
        kind = string_member(artifact, "kind")
        if not ["file", "tree"].contains(kind):
            return Err(f"{label}: {key} `{name}` kind must be `file` or `tree`")
        path = string_member(artifact, "path")
        # No overlap rule among declared inputs: an include directory legitimately contains the sources compiled
        # from it, which is how every C crate passes `-I`. Overlap matters only against what the work produces.
        #
        # A tree may name the owner root as `.`, which is how a crate that keeps its `config.h` beside its sources
        # passes itself as an include directory. Nothing else may: a file, an output or an executable at `.` names
        # a directory where bytes are expected.
        # Written as nested ifs rather than as one negated conjunction: the 0.5.1 toolchain that builds this tool
        # lowers a negated parenthesized `and` to a constant false, so the check it guards never runs.
        # Correct on 0.6, where fixtures now pin it (encero-systems/incan#1966); this shape goes when the tool
        # moves off 0.5.1, and `build.sh` refuses it until then.
        mut owner_root = false
        if kind == "tree":
            if path == ".":
                owner_root = true
        if not owner_root:
            validate_portable_path(path, f"{label}: {key} `{name}` path")?
        paths.append(path)
        if not is_sha256_identity(string_member(artifact, "digest")):
            return Err(f"{label}: {key} `{name}` digest must be a `sha256:` identity")
        members = producer_records(artifact, "members", label)?
        if kind == "file" and len(members) > 0:
            return Err(f"{label}: file {key} `{name}` cannot declare tree members")
        mut previous_member = ""
        for entry in members:
            member_path = string_member(entry, "path")
            validate_portable_path(member_path, f"{label}: tree {key} `{name}` member")?
            if len(previous_member) > 0 and not (previous_member < member_path):
                return Err(f"{label}: tree {key} `{name}` members must be sorted and unique")
            previous_member = member_path.to_string()
            if not is_sha256_identity(string_member(entry, "digest")):
                return Err(f"{label}: tree {key} `{name}` member `{member_path}` digest must be a `sha256:` identity")
        names.append(name.to_string())
    return Ok(names)


def validate_outputs(record: JsonValue, label: str) -> Result[list[str], str]:
    """An output is a contract, not bytes: a name, a kind and a path under the product root, with no digest."""
    mut names: list[str] = []
    mut paths: list[str] = []
    mut previous = ""
    for output in producer_records(record, "outputs", label)?:
        mut unknown: list[str] = []
        for key in sorted(output.keys()):
            if not ["kind", "name", "path"].contains(key):
                unknown.append(key)
        if len(unknown) > 0:
            listed = ", ".join(unknown)
            return Err(f"{label}: outputs has unknown keys [{listed}]; a product digest belongs to the asset")
        name = string_member(output, "name")
        validate_producer_name(name, f"{label}: outputs name")?
        if len(previous) > 0 and not (previous < name):
            return Err(f"{label}: outputs must be sorted by unique name")
        previous = name.to_string()
        path = string_member(output, "path")
        validate_portable_path(path, f"{label}: outputs `{name}` path")?
        for existing in paths:
            if paths_overlap(existing, path):
                return Err(f"{label}: outputs path `{path}` overlaps another declared path")
        paths.append(path)
        if not ["file", "tree"].contains(string_member(output, "kind")):
            return Err(f"{label}: outputs `{name}` kind must be `file` or `tree`")
        names.append(name.to_string())
    return Ok(names)


def validate_objects(record: JsonValue, sources: list[str], label: str) -> Result[None, str]:
    """
    Check a link record's object closure: one compile per object file, each naming what it compiles.

    An object states its own file name once, as the single output its argv references, so the name and the argv
    cannot drift. Every object compiles at least one declared source and every declared source is compiled by some
    object, which is what makes `sources` the closure rather than a bag.
    """
    objects = producer_records(record, "objects", label)?
    if len(objects) == 0:
        return Err(f"{label}: objects must declare the complete, non-empty object closure")
    mut previous = ""
    mut compiled: list[str] = []
    for object in objects:
        mut unknown: list[str] = []
        for key in sorted(object.keys()):
            if not ["arguments", "language", "name", "reads"].contains(key):
                unknown.append(key)
        if len(unknown) > 0:
            listed = ", ".join(unknown)
            return Err(f"{label}: objects has unknown keys [{listed}]")
        name = string_member(object, "name")
        validate_producer_name(name, f"{label}: objects name")?
        if len(previous) > 0 and not (previous < name):
            return Err(f"{label}: objects must be sorted by unique name")
        previous = name.to_string()
        if sources.contains(name):
            return Err(f"{label}: logical name `{name}` is claimed as both a source and an object")
        if not ["assembly", "c", "cpp"].contains(string_member(object, "language")):
            return Err(f"{label}: object `{name}` language must be `c`, `cpp` or `assembly`")
        arguments = producer_records(object, "arguments", label)?
        validate_argument_list(arguments, sources, [name], f"{label}: object `{name}`")?
        produced = argument_references(arguments, "output")
        if len(produced) != 1:
            return Err(f"{label}: object `{name}` argv names its own object file exactly once and no other output")
        referenced = argument_references(arguments, "input")
        if len(referenced) == 0:
            return Err(f"{label}: object `{name}` argv must reference at least one declared source")
        for source in referenced + object_reads(object, sources, name, label)?:
            if not compiled.contains(source):
                compiled.append(source)
    for source in sources:
        if not compiled.contains(source):
            return Err(f"{label}: source `{source}` is named by no object's arguments or reads; sources is the closure, not a bag")
    return Ok(None)


def object_reads(object: JsonValue, sources: list[str], name: str, label: str) -> Result[list[str], str]:
    """
    An object's `reads` (RFC 119): declared sources its compile reads without its arguments naming them, as its
    dependency output reported at recording. Sorted, unique, and every one declared.
    """
    if not object.contains_key("reads"):
        return Ok([])
    mut out: list[str] = []
    match string_list_member(object, "reads"):
        Some(names) =>
            if len(names) == 0:
                return Err(f"{label}: object `{name}` reads is omitted when empty, never stated as []")
            for read in names:
                if not sources.contains(read):
                    return Err(f"{label}: object `{name}` reads `{read}`, which is not a declared source")
                if len(out) > 0 and not (out[len(out) - 1] < read):
                    return Err(f"{label}: object `{name}` reads must be sorted and unique")
                out.append(read)
        None => return Err(f"{label}: object `{name}` reads must be a list of declared source names")
    return Ok(out)


def argument_references(arguments: list[JsonValue], key: str) -> list[str]:
    """Every name an argv references under `key`, which is `input` or `output`."""
    mut names: list[str] = []
    for argument in arguments:
        if argument.contains_key(key):
            names.append(string_member(argument, key))
    return names


def validate_arguments(record: JsonValue, inputs: list[str], outputs: list[str], label: str) -> Result[None, str]:
    """Check a record-level argv, which only a `tool` producer carries."""
    return validate_argument_list(producer_records(record, "arguments", label)?, inputs, outputs, label)


def validate_argument_list(arguments: list[JsonValue], inputs: list[str], outputs: list[str], label: str) -> Result[None, str]:
    """
    Every argument is a literal or a reference to something the record names; no host path reaches the command line.

    Four forms: a `literal`, a declared `input`, a declared `output`, and an `owner` path, which resolves inside the
    immutable owner the executable names — how a compile points at its SDK and resource directory without knowing
    where that owner sits on any particular machine.
    """
    for argument in arguments:
        keys = sorted(argument.keys())
        if len(keys) != 1 or not ["input", "literal", "output", "owner"].contains(keys[0]):
            return Err(f"{label}: each argument states exactly one of literal, input, output or owner")
        value = string_member(argument, keys[0])
        if keys[0] == "input" and not inputs.contains(value):
            return Err(f"{label}: argument references undeclared input `{value}`")
        if keys[0] == "output" and not outputs.contains(value):
            return Err(f"{label}: argument references undeclared output `{value}`")
        if keys[0] == "owner":
            validate_portable_path(value, f"{label}: owner argument")?
        if keys[0] == "literal" and value.contains("\0"):
            return Err(f"{label}: a literal argument cannot contain NUL")
    return Ok(None)


def validate_environment(record: JsonValue, inputs: list[str], label: str) -> Result[None, str]:
    """The environment is explicit and closed: a sorted set of names, each an inline value or a declared input."""
    mut previous = ""
    for entry in producer_records(record, "environment", label)?:
        mut unknown: list[str] = []
        for key in sorted(entry.keys()):
            if not ["input", "literal", "name"].contains(key):
                unknown.append(key)
        if len(unknown) > 0:
            listed = ", ".join(unknown)
            return Err(f"{label}: environment has unknown keys [{listed}]")
        name = string_member(entry, "name")
        if not is_environment_name(name):
            return Err(f"{label}: environment name `{name}` is invalid")
        if len(previous) > 0 and not (previous < name):
            return Err(f"{label}: environment must be sorted by unique name")
        previous = name.to_string()
        mut stated = 0
        for key in ["input", "literal"]:
            if entry.contains_key(key):
                stated += 1
        if stated != 1:
            return Err(f"{label}: environment `{name}` states exactly one of literal or input")
        if entry.contains_key("input") and not inputs.contains(string_member(entry, "input")):
            input_name = string_member(entry, "input")
            return Err(f"{label}: environment `{name}` references undeclared input `{input_name}`")
    return Ok(None)


def validate_producer_name(value: str, label: str) -> Result[None, str]:
    """A producer-local name is referenced from arguments and the environment, so it stays plain ASCII."""
    if not is_producer_name(value):
        return Err(f"{label} `{value}` must use ASCII letters, digits, `.`, `-` or `_`")
    return Ok(None)


def is_producer_name(value: str) -> bool:
    if len(value) == 0 or value.strip() != value:
        return false
    for character in value:
        if not "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-_".contains(character):
            return false
    return true


def is_environment_name(value: str) -> bool:
    if len(value) == 0:
        return false
    for character in value:
        if not "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_".contains(character):
            return false
    return true


def validate_portable_path(value: str, label: str) -> Result[None, str]:
    """
    A declared path is owner-relative and portable: no root, no drive, no URI, no `~`, no `..`, no trailing space.

    The owner is the record for a committed input, and the immutable owner the executable names for a producer
    input, so a path that leaves it would bind bytes nobody can name.
    """
    if len(value.strip()) == 0 or value.strip() != value or value.startswith("/") or value.startswith("~"):
        return Err(f"{label} `{value}` must be a plain owner-relative path")
    if value.startswith("//") or value.contains("\\") or value.contains("://") or value.startswith("file:"):
        return Err(f"{label} `{value}` must be a plain owner-relative path")
    if len(value) > 1 and value[1:2] == ":":
        return Err(f"{label} `{value}` must be a plain owner-relative path")
    for segment in value.split("/"):
        if len(segment) == 0 or segment == "." or segment == "..":
            return Err(f"{label} `{value}` must be a plain owner-relative path")
    return Ok(None)


def paths_overlap(left: str, right: str) -> bool:
    """Whether two owner-relative paths name the same place or one contains the other."""
    if left == right:
        return true
    return left.startswith(right + "/") or right.startswith(left + "/")

