"""
Projections: the rendered external-source record and the sparse index, derived from the folded state.

Nothing here is authored. `build` writes exactly these files; `check` refuses a checkout whose committed files differ
from them by a byte.
"""

from std.fs import Path
from std.json import JsonValue

from adoption import adoption_from_payload, loaf_name, render_adopted_manifest
from canonical import canonical, json_string, pretty
from events import member, read_text, string_member, write_text
from registry import Record, compare_versions, has_key, keys_of, producer_key_order, record_key


pub def manifest_notice() -> str:
    return "# Projection of the incan.pub event log; regenerate with `incan-pub build`, never edit."


pub def render_manifest(record: Record) -> Result[str, str]:
    """
    The record as the `loaf.toml` a consumer reads: the adopted Loaf's manifest followed by its bound facts, or, for a
    version not yet adopted, the v0 external-source record.
    """
    mut lines = header_comments(record)
    lines.append(manifest_notice())
    lines.append("")
    match record.adopt:
        Some(payload) =>
            adoption = adoption_from_payload(payload, f"{record.name} {record.version}")?
            lines.append(render_adopted_manifest(adoption).strip())
        None =>
            lines.append("[project]")
            lines.append("name = " + json_string(record.name))
            lines.append("version = " + json_string(record.version))
            lines.append("")
            lines.append("[source]")
            lines.append("registry = " + json_string(record.registry))
            lines.append("checksum = " + json_string(record.checksum))
    for fact_lines in render_facts(record):
        lines.append("")
        for line in fact_lines:
            lines.append(line)
    return Ok("\n".join(lines) + "\n")


def header_comments(record: Record) -> list[str]:
    """The record's notes and advisories, as the comment block above the manifest."""
    mut lines: list[str] = []
    notes = record.notes.strip()
    if len(notes) > 0:
        for line in notes.split("\n"):
            trimmed = rstrip(line)
            if len(trimmed) == 0:
                lines.append("#")
            else:
                lines.append("# " + trimmed)
        lines.append("#")
    for advisory in record.advisories:
        for line in string_member(advisory, "text").strip().split("\n"):
            trimmed = rstrip(line)
            if len(trimmed) == 0:
                lines.append("#")
            else:
                lines.append("# Advisory: " + trimmed)
        lines.append("#")
    return lines


def render_facts(record: Record) -> list[list[str]]:
    """Each bound fact as its `[[rust.facts]]` element, producer sub-tables included, in binding order."""
    mut blocks: list[list[str]] = []
    for fact in record.sorted_facts():
        mut lines: list[str] = []
        lines.append("[[rust.facts]]")
        lines.append("toolchain = " + json_string(fact.binding.toolchain))
        lines.append("target = " + json_string(fact.binding.target))
        lines.append("profile = " + json_string(fact.binding.profile))
        lines.append("features = " + toml_list(fact.binding.features))
        lines.append("cfg = " + toml_list(fact.cfg))
        if len(fact.out) > 0:
            mut entries: list[str] = []
            for entry in fact.out:
                entries.append(
                    "{ name = " + json_string(entry.name) + ", path = " + json_string(entry.path)
                    + ", digest = " + json_string(entry.digest) + " }"
                )
            lines.append("out = [" + ", ".join(entries) + "]")
        match fact.harvested_from:
            Some(receipt) => lines.append("harvested-from = " + json_string(receipt))
            None => pass
        # Publisher work renders after every key of its own `[[rust.facts]]` element: a sub-table header ends the
        # parent table, so a scalar written here would belong to the producer instead of the record.
        for index, producers in enumerate([fact.link, fact.tool]):
            kind = producer_kind(index)
            for producer in producers:
                lines.append("")
                lines.append("[[rust.facts." + kind + "]]")
                mut rendered: list[str] = []
                for key in producer_key_order():
                    match producer.get(key):
                        Some(value) =>
                            rendered.append(key)
                            if not is_stated_absence(value):
                                lines.append(key + " = " + toml_value(value))
                        None => pass
                for key in sorted(producer.keys()):
                    if not rendered.contains(key):
                        match producer.get(key):
                            Some(value) => lines.append(key + " = " + toml_value(value))
                            None => pass
        blocks.append(lines)
    return blocks


def producer_kind(index: int) -> str:
    """The producer list at this position: link first, then tool, as the record renders them."""
    if index == 1:
        return "tool"
    return "link"


def toml_value(value: JsonValue) -> str:
    """One JSON value as the TOML the compiler reads: strings quoted, collections inline, tables keyed in order."""
    match value.as_str():
        Some(text) => return json_string(text)
        None => pass
    match value.as_int():
        Some(number) => return str(number)
        None => pass
    match value.as_bool():
        Some(flag) =>
            if flag:
                return "true"
            return "false"
        None => pass
    match value.as_array():
        Some(items) =>
            mut parts: list[str] = []
            for item in items:
                parts.append(toml_value(item))
            return "[" + ", ".join(parts) + "]"
        None => pass
    mut members: list[str] = []
    for key in sorted(value.keys()):
        match value.get(key):
            Some(child) => members.append(key + " = " + toml_value(child))
            None => pass
    return "{ " + ", ".join(members) + " }"


def is_stated_absence(value: JsonValue) -> bool:
    """An empty list or table says what omitting the key says, and the record spells it by omitting the key."""
    if value.is_array():
        return value.len() == 0
    if value.is_object():
        return len(value.keys()) == 0
    return false


def toml_list(values: list[str]) -> str:
    mut items: list[str] = []
    for value in values:
        items.append(json_string(value))
    return "[" + ", ".join(items) + "]"


def rstrip(text: str) -> str:
    mut end = len(text)
    while end > 0 and (text[end - 1:end] == " " or text[end - 1:end] == "\t" or text[end - 1:end] == "\r"):
        end -= 1
    return text[0:end]


pub def index_line(record: Record) -> JsonValue:
    """
    One index line (RFC 125, "Sparse index"). An adopted version carries everything resolution needs before any
    record or archive is fetched: its Rust facet, its dependencies and its features, with `cksum` naming the source
    Loaf archive and `adopted` the crates.io version it came from. A version not yet adopted keeps the v0 shape, its
    `cksum` the crates.io checksum.
    """
    mut facts: list[JsonValue] = []
    for fact in record.sorted_facts():
        mut entry = fact.binding.to_json()
        entry.set("status", JsonValue.string(fact.status)).unwrap()
        # A native fact applies only where its executables' owners are present (RFC 119 rule 6); a client picks among
        # one binding's facts by the owners it has.
        if len(fact.owners) > 0:
            mut owners: list[JsonValue] = []
            for owner in fact.owners:
                owners.append(JsonValue.string(owner))
            entry.set("owners", JsonValue.array(owners)).unwrap()
        facts.append(entry)
    mut line: Dict[str, JsonValue] = {
        "name": JsonValue.string(loaf_name(record.name)),
        "vers": JsonValue.string(record.version),
        "manifest": JsonValue.string(f"crates-io/{record.name}/{record.version}/loaf.toml"),
        "yanked": JsonValue.bool(record.yanked),
        "facts": JsonValue.array(facts),
        "assets": JsonValue.int(len(record.assets)),
        "advisories": JsonValue.int(len(record.advisories)),
    }
    match record.adopt:
        Some(payload) =>
            line["cksum"] = member(payload, "archive")
            line["facets"] = JsonValue.array([JsonValue.string("rust")])
            mut facet = member(payload, "rust")
            mut facet_line = JsonValue.object({
                "name": member(facet, "name"),
                "type": member(facet, "type"),
                "edition": member(facet, "edition"),
            })
            match facet.get("build-script"):
                Some(flag) => facet_line.set("build-script", flag).unwrap()
                None => pass
            line["rust"] = facet_line
            line["deps"] = member(payload, "deps")
            line["features"] = member(payload, "features")
            line["adopted"] = member(payload, "adopted")
            line["publisher"] = JsonValue.string(record.publisher)
        None =>
            line["cksum"] = JsonValue.string(record.checksum)
            line["source"] = JsonValue.string("crates-io")
            line["adopter"] = JsonValue.string(record.adopter)
    return JsonValue.object(line)


pub def render_asset_manifest(record: Record) -> Result[str, str]:
    """
    The per-version asset manifest (RFC 125): every admitted asset with its binding, archive digest, unit and entry
    identities, payload digest, builder kind, attestation and registry location, ordered by binding and unit. A client
    decides from it which units it can fetch before it downloads anything.
    """
    mut by_key: Dict[str, JsonValue] = {}
    for asset in record.assets:
        by_key[asset.binding.key() + "\n\n" + asset.unit_identity] = asset.to_json()
    mut assets: list[JsonValue] = []
    for key in sorted(keys_of(by_key)):
        assets.append(by_key[key])
    return Ok(pretty(JsonValue.object({
        "name": JsonValue.string(loaf_name(record.name)),
        "vers": JsonValue.string(record.version),
        "assets": JsonValue.array(assets),
    }))? + "\n")


def is_projection_file(path: str) -> bool:
    """
    `crates-io/<name>/<version>/loaf.toml` and the `assets.json` beside it are rendered; everything else under a version
    is a generated input, `out/assets.json` included.
    """
    parts = path.split("/")
    return len(parts) == 4 and (parts[3] == "loaf.toml" or parts[3] == "assets.json")


pub def index_path(name: str) -> str:
    """Where a package's index file lives: `index/<scope>/<name>` (RFC 125), every package here in `crates-io`."""
    return "index/" + loaf_name(name)


pub def render_projections(state: Dict[str, Record]) -> Result[Dict[str, str], str]:
    """Every projection file, by path relative to the root."""
    mut files: Dict[str, str] = {}
    mut versions_by_name: Dict[str, list[str]] = {}
    for key in sorted(keys_of(state)):
        record = state[key]
        files[f"crates-io/{record.name}/{record.version}/loaf.toml"] = render_manifest(record)?
        if len(record.assets) > 0:
            files[f"crates-io/{record.name}/{record.version}/assets.json"] = render_asset_manifest(record)?
        mut versions: list[str] = []
        if has_key(versions_by_name, record.name):
            versions = versions_by_name[record.name]
        versions.append(record.version)
        versions_by_name[record.name] = versions
    for name in sorted(keys_of(versions_by_name)):
        mut text = ""
        for version in sort_versions(versions_by_name[name]):
            text = text + canonical(index_line(state[record_key(name, version)]))? + "\n"
        files[index_path(name)] = text
    return Ok(files)


def sort_versions(versions: list[str]) -> list[str]:
    """Selection sort by `compare_versions`; a package has few versions."""
    mut remaining = versions.clone()
    mut out: list[str] = []
    while len(remaining) > 0:
        mut best = 0
        mut index = 1
        while index < len(remaining):
            if compare_versions(remaining[index], remaining[best]) < 0:
                best = index
            index += 1
        out.append(remaining[best])
        remaining.remove(best)
    return out


pub def committed_projections(root: Path) -> Result[Dict[str, str], str]:
    """The projection files a checkout holds, by path relative to the root."""
    mut files: Dict[str, str] = {}
    collect_files(root / "index", "index", files, false)?
    collect_files(root / "crates-io", "crates-io", files, true)?
    return Ok(files)


def collect_files(directory: Path, relative: str, mut files: Dict[str, str], manifests_only: bool) -> Result[None, str]:
    if not directory.is_dir():
        return Ok(None)
    match directory.iterdir():
        Ok(children) =>
            for child in children:
                child_relative = relative + "/" + child.name()
                if child.is_dir():
                    collect_files(child, child_relative, files, manifests_only)?
                elif child.is_file() and (not manifests_only or is_projection_file(child_relative)):
                    files.insert(child_relative, read_text(child, child_relative)?)
            return Ok(None)
        Err(error) => return Err(f"{relative}/: {error.message()}")


pub def unclaimed_generated_inputs(root: Path, state: Dict[str, Record]) -> Result[list[str], str]:
    """
    Committed bytes under `crates-io/` that no fact names.

    A file staged for a proposal that then refused, or one a later record stopped naming, is not caught by comparing
    projections: the comparison reads what the records produce, and an unclaimed file is exactly what they do not.
    """
    mut claimed: list[str] = []
    for key in sorted(keys_of(state)):
        record = state[key]
        for fact in record.sorted_facts():
            for entry in fact.out:
                claimed.append(f"crates-io/{record.name}/{record.version}/{entry.path}")
    mut committed: list[str] = []
    collect_paths(root / "crates-io", "crates-io", committed)?
    mut unclaimed: list[str] = []
    for path in sorted(committed):
        if not is_projection_file(path) and not claimed.contains(path):
            unclaimed.append(path)
    return Ok(unclaimed)


def collect_paths(directory: Path, relative: str, mut paths: list[str]) -> Result[None, str]:
    """
    Every regular file below `directory`, by path relative to the root.

    Paths only: a committed generated input can be any bytes a build script wrote — `proto_descriptor.bin` is a
    protobuf descriptor — and reading one as text would refuse a record for being what it is.
    """
    if not directory.is_dir():
        return Ok(None)
    match directory.iterdir():
        Ok(children) =>
            for child in children:
                child_relative = relative + "/" + child.name()
                if child.is_dir():
                    collect_paths(child, child_relative, paths)?
                elif child.is_file():
                    paths.append(child_relative)
            return Ok(None)
        Err(error) => return Err(f"{relative}/: {error.message()}")


pub def stale_projections(committed: Dict[str, str], wanted: Dict[str, str]) -> list[str]:
    """Paths present on one side only, followed by paths whose content differs; empty when the sides agree."""
    mut stale: list[str] = []
    for path in sorted(keys_of(committed)):
        if not has_key(wanted, path):
            stale.append(path)
    for path in sorted(keys_of(wanted)):
        if not has_key(committed, path):
            stale.append(path)
    for path in sorted(keys_of(wanted)):
        if has_key(committed, path) and committed[path] != wanted[path]:
            stale.append(path)
    return stale


pub def write_projections(root: Path, committed: Dict[str, str], wanted: Dict[str, str]) -> Result[None, str]:
    """Replace the committed projections with the wanted ones, removing files no record produces any more."""
    for path in sorted(keys_of(committed)):
        if not has_key(wanted, path):
            match (root / path).unlink():
                Ok(_) => pass
                Err(error) => return Err(f"{path}: {error.message()}")
    for path in sorted(keys_of(wanted)):
        write_text(root / path, wanted[path], path)?
    return Ok(None)
