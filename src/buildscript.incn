"""
Recording build facts: compile a package's build script with the pinned `rustc`, run it sandboxed under one exact
binding, and read what it said (RFC 125, "Adoption from crates.io", rule 6).

A binding is a toolchain, target, profile and complete feature set. The script runs from a fresh copy of the adopted
Loaf's files, with an environment built only from the binding: the target's `cfg` answers as the selected `rustc`
prints them, the features, the package's metadata, an empty `OUT_DIR` and the profile's levels. Nothing of the
recorder's own environment reaches it; on the host it runs under `sandbox-exec` with the network closed and writes
confined to its work directory.

What the script prints becomes the fact: each `rustc-cfg` a `cfg` answer, each file written to `OUT_DIR` a committed
`out` input. `rerun-if-*`, `rustc-check-cfg` and `warning` carry no Oven authority and are ignored. Anything this
recorder cannot state yet is refused with the directive named: link and environment directives, metadata for
dependents, and a script with build dependencies each wait for a recorder of their own. The result is written as a
harvest proposal, so admission is the same path every other fact takes.
"""

from std.fs import Path
from std.json import JsonValue
from std.toml import TomlValue

from canonical import canonical, digest_bytes, digest_text, pretty
from closure import crates_io_lines, find_line
from events import member, string_list_member, string_member, write_text
from graph import graph_text
from host import Ran, canonical_path, environment_value, executable_path, run_program
from native import Compiler, Conversion, Invocation, convert, read_traces, trace_variable
from registry import crates_io_index
from semver import parse_version
from tar import TarEntry, read_archive


@derive(Clone)
pub model Selection:
    """The binding a fact is recorded for, and how its feature set was reached."""

    pub toolchain: str
    pub rustc: str
    pub target: str
    pub host: str
    pub profile: str
    pub features: list[str]
    pub domain: str
    pub graph: JsonValue
    pub cc: str
    pub cxx: str
    pub ar: str
    pub sysroot: str
    pub incan: str
    pub build_lock: str
    pub pin: str


pub def record_proposal(
    package: str,
    version: str,
    adopt: JsonValue,
    checksum: str,
    blobs: str,
    cache: str,
    work: str,
    selection: Selection,
) -> Result[Option[str], str]:
    """
    Run the build script for one binding and write a proposal directory under `work`; `None` when the package has no
    build script, so no fact is needed.
    """
    label = f"{package} {version}"
    files = archive_files(blobs, string_member(adopt, "archive"), label)?
    manifest = cargo_manifest(files, label)?
    match build_script(manifest, files, label)?:
        Some(script) =>
            base = work + "/" + package + "-" + version + "-" + selection.profile
            reset(base)?
            linked = build_dependencies(cache, blobs, package, version, base, selection, label)?
            package_dir = base + "/package"
            for file in files:
                write_file(package_dir + "/" + file.path, file.data)?
            for directory in ["out", "tmp", "home", "proposal"]:
                make_dir(base + "/" + directory)?
            package_environment = package_variables(package, version, manifest, package_dir, base)?
            edition = string_member(member(adopt, "rust"), "edition")
            executable = compile_script(script, package_dir, base, edition, linked, package_environment, selection, label)?
            ran = run_script(executable, package, version, manifest, package_dir, base, selection, label)?
            observed = directives(ran, label, manifest_string(manifest, "package.links") != "", base + "/out")?
            native = native_work(observed, base, selection, label)?
            included = out_dir_includes(files, script)
            return Ok(Some(write_proposal(package, version, checksum, base, observed.cfg, native, included, selection)?))
        None => return Ok(None)


def archive_files(blobs: str, digest: str, label: str) -> Result[list[TarEntry], str]:
    """The adopted Loaf's files from the blob store, checked against the digest the adoption names."""
    location = blobs + "/sha256/" + digest[7:] + ".tar"
    match Path(location).read_bytes():
        Ok(data) =>
            if digest_bytes(data) != digest:
                return Err(f"{label}: {location} is not the archive {digest}")
            return read_archive(data)
        Err(error) => return Err(f"{label}: {location}: {error.message()}")


def cargo_manifest(files: list[TarEntry], label: str) -> Result[TomlValue, str]:
    for file in files:
        if file.path == "Cargo.toml":
            match file.data.decode():
                Ok(text) =>
                    match TomlValue.parse(text):
                        Ok(document) => return Ok(document)
                        Err(error) => return Err(f"{label}: Cargo.toml does not parse: {error.message()}")
                Err(error) => return Err(f"{label}: Cargo.toml is not UTF-8: {error}")
    return Err(f"{label}: the archive has no Cargo.toml")


def build_script(manifest: TomlValue, files: list[TarEntry], label: str) -> Result[Option[str], str]:
    """The build script's path: `package.build` when it names one, `build.rs` when present and not turned off."""
    mut paths: list[str] = []
    for file in files:
        paths.append(file.path)
    match manifest.get_optional[str]("package.build"):
        Ok(found) =>
            match found:
                Some(path) =>
                    if not paths.contains(path):
                        return Err(f"{label}: package.build names `{path}`, which is not in the archive")
                    return Ok(Some(path))
                None => pass
        Err(_) =>
            match manifest.get_optional[bool]("package.build"):
                Ok(_) => return Ok(None)
                Err(error) => return Err(f"{label}: package.build: {error.message()}")
    if paths.contains("build.rs"):
        return Ok(Some("build.rs"))
    return Ok(None)


def build_dependencies(
    cache: str,
    blobs: str,
    package: str,
    version: str,
    base: str,
    selection: Selection,
    label: str,
) -> Result[list[list[str]], str]:
    """
    The `rustc` flags that link the build script against its build dependencies: Oven compiles them for the host from
    their adopted archives (`incan oven compile-closure`), and this recorder links against what it returns. None when
    the script has none.
    """
    roots = build_roots(cache, package, version, selection, label)?
    if len(roots) == 0:
        return Ok([])
    if len(selection.incan) == 0 or len(selection.build_lock) == 0:
        return Err(f"{label}: the build script has build dependencies; pass --incan and --build-lock to compile them")
    graph = JsonValue.object({
        "roots": JsonValue.array(roots),
        "target": JsonValue.string(selection.host),
        "host": JsonValue.string(selection.host),
    })
    write_text(Path(base + "/build-roots.json"), graph_text(graph)?, "build-roots.json")?
    commit = run_program("/usr/bin/git", ["-C", selection.pin, "rev-parse", "HEAD"], plain_environment(base), base)?
    if not commit.success:
        return Err(f"{label}: {selection.pin} is not a git checkout of the index")
    mut environment = plain_environment(base)
    environment["INCAN_HOME"] = environment_value("INCAN_HOME").unwrap_or(environment_value("HOME").unwrap_or("") + "/.incan")
    environment["INCAN_NO_BANNER"] = "1"
    closure = run_program(selection.incan, [
        "oven", "compile-closure",
        "--pin", selection.pin,
        "--index-commit", text_of(commit.stdout).strip(),
        "--roots", base + "/build-roots.json",
        "--profile", "debug",
        "--out", base + "/closure/closure.json",
        "--lock", selection.build_lock,
        "--blobs", blobs + "/sha256",
        "--rustc", selection.rustc,
    ], environment, base)?
    if not closure.success:
        return Err(f"{label}: compiling the build dependencies failed: {text_of(closure.stderr)}{text_of(closure.stdout)}")
    return closure_links(base + "/closure", label)


def closure_links(directory: str, label: str) -> Result[list[list[str]], str]:
    """`--extern` for each root and `-L dependency=` for every unit the closure compiled."""
    mut result = JsonValue.null()
    match Path(directory + "/closure.json").read_text("utf-8", "strict"):
        Ok(text) =>
            match JsonValue.parse(text):
                Ok(value) => result = value
                Err(error) => return Err(f"{label}: closure.json: {error.message()}")
        Err(error) => return Err(f"{label}: closure.json: {error.message()}")
    match result.get("refused"):
        Some(refused) =>
            if refused.len() > 0:
                return Err(f"{label}: Oven refused build dependencies: {canonical(refused)?}")
        None => pass
    mut out: list[list[str]] = []
    externs = member(result, "externs")
    for name in sorted(externs.keys()):
        out.append(["--extern", name.replace("-", "_") + "=" + string_member(member(externs, name), "path")])
    entries = directory + "/closure-store/store/entries"
    for entry in files_or_directories(entries)?:
        out.append(["-L", "dependency=" + entries + "/" + entry + "/artifacts"])
    return Ok(out)


def build_roots(cache: str, package: str, version: str, selection: Selection, label: str) -> Result[list[JsonValue], str]:
    """The build dependencies active for the binding's features, as Loaf root requests for the host."""
    line = find_line(crates_io_lines(cache, package)?, package, version)?
    mut raw: Dict[str, list[str]] = {}
    for table in ["features", "features2"]:
        match line.get(table):
            Some(value) =>
                for name in value.keys():
                    raw[name] = string_list_member(value, name).unwrap_or([])
            None => pass
    mut enabled_keys: list[str] = []
    for feature in selection.features:
        enabled_keys.append(feature)
        for item in raw.get(feature).unwrap_or([]):
            if item.startswith("dep:"):
                enabled_keys.append(item[4:])
            elif item.contains("/") and not item.contains("?/"):
                enabled_keys.append(item.split("/")[0])
    mut roots: list[JsonValue] = []
    match line.get("deps"):
        Some(value) =>
            for declaration in value.as_array().unwrap_or([]):
                if string_member(declaration, "kind") != "build":
                    continue
                key = string_member(declaration, "name")
                if flag_value(declaration, "optional", false) and not enabled_keys.contains(key):
                    continue
                if len(string_member(declaration, "target")) > 0:
                    return Err(f"{label}: build dependency `{key}` is target-conditional, which this recorder cannot select yet")
                mut package_name = string_member(declaration, "package")
                if len(package_name) == 0:
                    package_name = key
                roots.append(JsonValue.object({
                    "name": JsonValue.string(key),
                    "loaf": JsonValue.string("crates-io/" + package_name),
                    "req": JsonValue.string(string_member(declaration, "req")),
                    "features": JsonValue.array([JsonValue.string(item) for item in string_list_member(declaration, "features").unwrap_or([])]),
                    "default-features": JsonValue.bool(flag_value(declaration, "default_features", true)),
                    "optional": JsonValue.bool(false),
                }))
        None => pass
    return Ok(roots)


def flag_value(value: JsonValue, key: str, absent: bool) -> bool:
    match value.get(key):
        Some(found) => return found.as_bool().unwrap_or(absent)
        None => return absent


def files_or_directories(directory: str) -> Result[list[str], str]:
    mut names: list[str] = []
    match Path(directory).iterdir():
        Ok(children) =>
            for child in children:
                names.append(child.name())
        Err(error) => return Err(f"{directory}: {error.message()}")
    return Ok(sorted(names))


def compile_script(
    script: str,
    package_dir: str,
    base: str,
    edition: str,
    linked: list[list[str]],
    package_environment: Dict[str, str],
    selection: Selection,
    label: str,
) -> Result[str, str]:
    """
    `build_script_build` for the host, its features visible as `cfg(feature)`, linked against its build dependencies.

    The package variables are set while it compiles, as Cargo sets them: a script may read `env!("CARGO_PKG_NAME")`.
    """
    executable = base + "/build-script-build"
    mut arguments = [
        script,
        "--crate-name", "build_script_build",
        "--crate-type", "bin",
        "--edition", edition,
        "--target", selection.host,
        "-C", "opt-level=0",
        "--cap-lints", "allow",
        "-o", executable,
    ]
    for feature in selection.features:
        arguments.append("--cfg")
        arguments.append("feature=\"" + feature + "\"")
    for pair in linked:
        arguments.append(pair[0])
        arguments.append(pair[1])
    mut environment = package_environment
    environment["CARGO_CRATE_NAME"] = "build_script_build"
    ran = run_program(selection.rustc, arguments, environment, package_dir)?
    if not ran.success:
        return Err(f"{label}: the build script does not compile: {text_of(ran.stderr)}")
    return Ok(executable)


def run_script(
    executable: str,
    package: str,
    version: str,
    manifest: TomlValue,
    package_dir: str,
    base: str,
    selection: Selection,
    label: str,
) -> Result[Ran, str]:
    environment = script_environment(package, version, manifest, package_dir, base, selection, label)?
    sandbox = "(version 1)(allow default)(deny network*)(deny file-write*)(allow file-write* (subpath \"" + base + "\") (literal \"/dev/null\"))"
    ran = run_program("/usr/bin/sandbox-exec", ["-p", sandbox, executable], environment, package_dir)?
    if not ran.success:
        return Err(f"{label}: the build script failed: {text_of(ran.stderr)}")
    return Ok(ran)


def package_variables(package: str, version: str, manifest: TomlValue, package_dir: str, base: str) -> Result[Dict[str, str], str]:
    """What Cargo tells a build script about its package, both while compiling it and while running it."""
    mut environment = plain_environment(base)
    parsed = parse_version(version)?
    environment["CARGO_MANIFEST_DIR"] = package_dir
    environment["CARGO_MANIFEST_PATH"] = package_dir + "/Cargo.toml"
    environment["CARGO_PKG_NAME"] = package
    environment["CARGO_PKG_VERSION"] = version
    environment["CARGO_PKG_VERSION_MAJOR"] = str(parsed.major)
    environment["CARGO_PKG_VERSION_MINOR"] = str(parsed.minor)
    environment["CARGO_PKG_VERSION_PATCH"] = str(parsed.patch)
    environment["CARGO_PKG_VERSION_PRE"] = ".".join(parsed.pre)
    for key in ["description", "homepage", "repository", "license", "license-file", "rust-version", "readme"]:
        environment["CARGO_PKG_" + key.upper().replace("-", "_")] = manifest_string(manifest, "package." + key)
    environment["CARGO_PKG_AUTHORS"] = ":".join(manifest_strings(manifest, "package.authors"))
    return Ok(environment)


def script_environment(
    package: str,
    version: str,
    manifest: TomlValue,
    package_dir: str,
    base: str,
    selection: Selection,
    label: str,
) -> Result[Dict[str, str], str]:
    """The environment a build script reads, built from the binding and the package alone."""
    mut environment = package_variables(package, version, manifest, package_dir, base)?
    for feature in selection.features:
        environment["CARGO_FEATURE_" + feature.upper().replace("-", "_")] = "1"
    environment["CARGO_CFG_FEATURE"] = ",".join(selection.features)
    cfg = target_cfg(selection, base, label)?
    for key in cfg.keys():
        environment[key] = cfg[key]
    if selection.profile == "debug":
        environment["CARGO_CFG_DEBUG_ASSERTIONS"] = ""
        environment["OPT_LEVEL"] = "0"
        environment["DEBUG"] = "true"
    else:
        environment["OPT_LEVEL"] = "3"
        environment["DEBUG"] = "false"
    environment["PROFILE"] = selection.profile
    environment["OUT_DIR"] = base + "/out"
    environment["TARGET"] = selection.target
    environment["HOST"] = selection.host
    environment["NUM_JOBS"] = "1"
    environment["RUSTC"] = selection.rustc
    environment["RUSTDOC"] = selection.rustc.replace("/rustc", "/rustdoc")
    environment["CARGO_ENCODED_RUSTFLAGS"] = ""
    if len(selection.cc) > 0:
        native_wrappers(environment, base, selection)?
    return Ok(environment)


def plain_environment(base: str) -> Dict[str, str]:
    return {"PATH": "/usr/bin:/bin", "HOME": base + "/home", "TMPDIR": base + "/tmp"}


def target_cfg(selection: Selection, base: str, label: str) -> Result[Dict[str, str], str]:
    """`CARGO_CFG_*` from the selected `rustc`'s cfg answers for the target, repeated keys joined by commas."""
    ran = run_program(selection.rustc, ["--print", "cfg", "--target", selection.target], plain_environment(base), base)?
    if not ran.success:
        return Err(f"{label}: rustc --print cfg failed: {text_of(ran.stderr)}")
    mut out: Dict[str, str] = {}
    for line in text_of(ran.stdout).split("\n"):
        if len(line) == 0 or line == "debug_assertions":
            continue
        pieces = line.split("=")
        key = "CARGO_CFG_" + pieces[0].upper()
        mut value = ""
        if len(pieces) > 1:
            value = "=".join(pieces[1:]).replace("\"", "")
        if key in out and len(value) > 0:
            out[key] = out[key] + "," + value
        else:
            out[key] = value
    return Ok(out)


@derive(Clone)
model Directives:
    """What a build script said that becomes a fact: `cfg` answers and the static libraries it links."""

    pub cfg: list[str]
    pub libraries: list[str]


def directives(ran: Ran, label: str, links: bool, out_dir: str) -> Result[Directives, str]:
    """
    The script's directives, refusing any this recorder cannot state. A `static=` library is stated by the link record
    of its archive, so its search path must be `OUT_DIR`; a package that declares `links` may also print metadata for
    its dependents, which carries no Oven authority.
    """
    mut cfg: list[str] = []
    mut libraries: list[str] = []
    for line in text_of(ran.stdout).split("\n"):
        mut rest = ""
        if line.startswith("cargo::"):
            rest = line[7:]
        elif line.startswith("cargo:"):
            rest = line[6:]
        else:
            continue
        pieces = rest.split("=")
        key = pieces[0]
        value = "=".join(pieces[1:])
        if key == "rustc-cfg":
            if not cfg.contains(value):
                cfg.append(value)
        elif key == "rustc-link-lib":
            if not value.startswith("static="):
                return Err(f"{label}: the build script links `{value}`, which is not a static library it builds")
            libraries.append(value)
        elif key == "rustc-link-search":
            if value != "native=" + out_dir:
                return Err(f"{label}: the build script searches `{value}` for libraries, outside its OUT_DIR")
        elif key == "rustc-check-cfg" or key == "rerun-if-changed" or key == "rerun-if-env-changed" or key == "warning":
            pass
        elif not links or key.startswith("rustc-") or key == "error":
            return Err(f"{label}: the build script prints `{key}`, which this recorder cannot state yet")
    return Ok(Directives(cfg=sorted(cfg), libraries=libraries))


def native_wrappers(mut environment: Dict[str, str], base: str, selection: Selection) -> Result[None, str]:
    """`CC`, `CXX` and `AR` name copies of this tool that run the explicit tools and trace each successful run."""
    tool = executable_path()?
    make_dir(base + "/bin")?
    make_dir(base + "/trace")?
    for name in ["cc", "c++", "ar"]:
        match Path(tool).copy(Path(base + "/bin/" + name), true, true):
            Ok(_) => pass
            Err(error) => return Err(f"native wrapper {name}: {error.message()}")
    environment["CC"] = base + "/bin/cc"
    environment["CXX"] = base + "/bin/c++"
    environment["AR"] = base + "/bin/ar"
    environment[trace_variable()] = base + "/trace"
    environment["INCAN_PUB_NATIVE_CC"] = selection.cc
    environment["INCAN_PUB_NATIVE_CXX"] = selection.cxx
    environment["INCAN_PUB_NATIVE_AR"] = selection.ar
    # The explicit compiler finds its headers through SDKROOT; the link record names that sysroot as an owner path.
    environment["SDKROOT"] = canonical_path(selection.sysroot)?
    return Ok(None)


def native_work(observed: Directives, base: str, selection: Selection, label: str) -> Result[Conversion, str]:
    """The link records for what the script compiled and archived; none when it built no native code."""
    traces = read_traces(base + "/trace")?
    if len(observed.libraries) == 0 and len(traces) == 0:
        return Ok(Conversion(records=[], probes=[], products=[]))
    if len(selection.cc) == 0:
        return Err(f"{label}: the build script builds native code; pass --cc, --cxx, --ar and --sysroot")
    mut compilers: list[Compiler] = []
    for executable in [selection.cc, selection.cxx]:
        compilers.append(Compiler(
            executable=canonical_path(executable)?,
            resource_dir=resource_directory(executable, base)?,
            sysroot=canonical_path(selection.sysroot)?,
        ))
    match convert(traces, observed.libraries, compilers):
        Ok(conversion) =>
            mut products = conversion.products
            for trace in traces:
                for output in compile_outputs(trace):
                    if not products.contains(output):
                        products.append(output)
            return Ok(Conversion(records=conversion.records, probes=conversion.probes, products=products))
        Err(message) => return Err(f"{label}: {message}")


def resource_directory(compiler: str, base: str) -> Result[str, str]:
    ran = run_program(compiler, ["-print-resource-dir"], plain_environment(base), base)?
    if not ran.success:
        return Err(f"{compiler} did not report its resource directory")
    return canonical_path(text_of(ran.stdout).strip())


def compile_outputs(trace: Invocation) -> list[str]:
    """The files a compile wrote, probes included, so none of them is mistaken for a committed input."""
    mut out: list[str] = []
    mut index = 0
    while index + 1 < len(trace.arguments):
        if trace.arguments[index] == "-o":
            mut value = trace.arguments[index + 1]
            if not value.startswith("/"):
                value = trace.directory + "/" + value
            match canonical_path(value):
                Ok(resolved) => out.append(resolved)
                Err(_) => pass
        index += 1
    return out


def write_proposal(
    package: str,
    version: str,
    checksum: str,
    base: str,
    cfg: list[str],
    native: Conversion,
    included: list[str],
    selection: Selection,
) -> Result[str, str]:
    """
    A proposal directory in the harvest shape: proposal.json, its `out` files and the graph it names. `out` is the
    `OUT_DIR` files the crate's own sources include; what the script leaves there for C dependents, its compiler
    probes and its native products are not inputs of the Rust compile.
    """
    proposal_dir = base + "/proposal"
    out_dir = canonical_path(base + "/out")?
    mut out: list[JsonValue] = []
    for relative in files_below(Path(base + "/out"), "")?:
        if native.products.contains(out_dir + "/" + relative) or not included.contains(relative):
            continue
        mut data = b""
        match Path(base + "/out/" + relative).read_bytes():
            Ok(read) => data = read
            Err(error) => return Err(f"OUT_DIR/{relative}: {error.message()}")
        write_file(proposal_dir + "/out/" + relative, data)?
        out.append(JsonValue.object({
            "name": JsonValue.string(relative),
            "path": JsonValue.string("out/" + relative),
            "digest": JsonValue.string(digest_bytes(data)),
        }))
    mut features: list[JsonValue] = []
    for feature in sorted(selection.features):
        features.append(JsonValue.string(feature))
    mut cfg_values: list[JsonValue] = []
    for value in cfg:
        cfg_values.append(JsonValue.string(value))
    mut fact: Dict[str, JsonValue] = {
        "toolchain": JsonValue.string(selection.toolchain),
        "target": JsonValue.string(selection.target),
        "profile": JsonValue.string(selection.profile),
        "features": JsonValue.array(features),
        "cfg": JsonValue.array(cfg_values),
    }
    if len(out) > 0:
        fact["out"] = JsonValue.array(out)
    if len(native.records) > 0:
        fact["link"] = JsonValue.array(native.records)
    graph_line = graph_text(selection.graph)?
    write_text(Path(proposal_dir + "/graph.json"), graph_line, "graph.json")?
    proposal = JsonValue.object({
        "project": JsonValue.object({"name": JsonValue.string(package), "version": JsonValue.string(version)}),
        "source": JsonValue.object({"registry": JsonValue.string(crates_io_index()), "checksum": JsonValue.string(checksum)}),
        "rust": JsonValue.object({"facts": JsonValue.array([JsonValue.object(fact)])}),
        "evidence": JsonValue.object({
            "method": JsonValue.string("registry build-script run"),
            "domain": JsonValue.string(selection.domain),
            "graph": JsonValue.string(digest_text(canonical(selection.graph)?)),
            "host": JsonValue.string(selection.host),
            "sandbox": JsonValue.string("sandbox-exec: network denied, writes confined to the work directory"),
            "hazards": JsonValue.array([]),
            "compiler_probes": JsonValue.array([JsonValue.string(probe) for probe in native.probes]),
        }),
    })
    write_text(Path(proposal_dir + "/proposal.json"), pretty(proposal)? + "\n", "proposal.json")?
    return Ok(proposal_dir + "/proposal.json")


def out_dir_includes(files: list[TarEntry], script: str) -> list[str]:
    """
    The `OUT_DIR` paths the crate's Rust sources name in `concat!(env!("OUT_DIR"), ...)`: the generated inputs its
    compile reads through `include!`, `include_str!` or `include_bytes!`. The build script, tests, benches and examples
    are not the crate's compile.
    """
    marker = "env!(\"OUT_DIR\")"
    mut out: list[str] = []
    for file in files:
        if not file.path.endswith(".rs") or file.path == script:
            continue
        if file.path.startswith("tests/") or file.path.startswith("benches/") or file.path.startswith("examples/"):
            continue
        match file.data.decode():
            Ok(text) =>
                for piece in text.split(marker)[1:]:
                    name = joined_literals(piece.split(")")[0])
                    if name.startswith("/"):
                        relative = name[1:]
                        if len(relative) > 0 and not out.contains(relative):
                            out.append(relative)
            Err(_) => pass
    return out


def joined_literals(text: str) -> str:
    """The string literals of a `concat!` argument tail, concatenated."""
    pieces = text.split("\"")
    mut out = ""
    mut index = 1
    while index < len(pieces):
        out = out + pieces[index]
        index += 2
    return out


def files_below(directory: Path, prefix: str) -> Result[list[str], str]:
    """Every regular file below `directory`, relative to it, in sorted order."""
    mut out: list[str] = []
    if not directory.is_dir():
        return Ok(out)
    match directory.iterdir():
        Ok(children) =>
            for child in children:
                relative = prefix + child.name()
                if child.is_dir():
                    for nested in files_below(child, relative + "/")?:
                        out.append(nested)
                elif child.is_file():
                    out.append(relative)
        Err(error) => return Err(f"OUT_DIR: {error.message()}")
    return Ok(sorted(out))


def manifest_string(manifest: TomlValue, path: str) -> str:
    match manifest.get_optional[str](path):
        Ok(found) => return found.unwrap_or("")
        Err(_) => return ""


def manifest_strings(manifest: TomlValue, path: str) -> list[str]:
    match manifest.get_optional[list[str]](path):
        Ok(found) => return found.unwrap_or([])
        Err(_) => return []


def text_of(data: bytes) -> str:
    match data.decode("utf-8", "replace"):
        Ok(text) => return text
        Err(_) => return ""


def reset(base: str) -> Result[None, str]:
    path = Path(base)
    if path.is_dir():
        match path.remove_tree():
            Ok(_) => pass
            Err(error) => return Err(f"{base}: {error.message()}")
    return make_dir(base)


def make_dir(location: str) -> Result[None, str]:
    match Path(location).mkdir(parents=true, exist_ok=true):
        Ok(_) => return Ok(None)
        Err(error) => return Err(f"{location}: {error.message()}")


def write_file(location: str, data: bytes) -> Result[None, str]:
    path = Path(location)
    match path.parent().mkdir(parents=true, exist_ok=true):
        Ok(_) => pass
        Err(error) => return Err(f"{location}: {error.message()}")
    match path.write_bytes(data):
        Ok(_) => return Ok(None)
        Err(error) => return Err(f"{location}: {error.message()}")
