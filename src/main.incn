def flags() -> list[str]:
    """Options that take no value."""
    return ["propose", "publish", "records", "rewrite"]


def default_actor() -> str:
    return "encero-systems/incan.pub maintainers"


@derive(Clone)
class Invocation:
    """The parsed command line: the verb, its positional arguments and its `--flag value` options."""

    pub command: str
    pub positional: list[str]
    pub options: Dict[str, str]

    def option(self, name: str) -> Option[str]:
        if has_key(self.options, name):
            return Some(self.options[name])
        return None

    def root(self) -> Path:
        match self.option("root"):
            Some(directory) => return Path(directory)
            None => return Path(".")

    def actor(self) -> str:
        match self.option("actor"):
            Some(actor) => return actor
            None => return default_actor()

    def flag(self, name: str) -> bool:
        return has_key(self.options, name)

    def require(self, name: str) -> Result[str, str]:
        match self.option(name):
            Some(value) => return Ok(value)
            None => return Err(f"`--{name}` is required")


def parse_invocation(arguments: list[str]) -> Result[Invocation, str]:
    if len(arguments) < 2:
        return Err("usage: incan-pub <check|build|index-urls|publish|add-fact|attest> [arguments]")
    mut positional: list[str] = []
    mut options: Dict[str, str] = {}
    mut index = 2
    while index < len(arguments):
        argument = arguments[index]
        if argument.startswith("--"):
            if flags().contains(argument[2:]):
                options[argument[2:]] = "true"
                index += 1
                continue
            if index + 1 >= len(arguments):
                return Err(f"`{argument}` requires a value")
            options[argument[2:]] = arguments[index + 1]
            index += 2
        else:
            positional.append(argument)
            index += 1
    return Ok(Invocation(command=arguments[1], positional=positional, options=options))


def main() -> Result[None, str]:
    # Under a build script, copies of this tool stand in for the C compiler and the archiver (src/native.incn).
    match wrapper_role():
        Some(role) =>
            match run_wrapper(role):
                Ok(code) =>
                    if code != 0:
                        exit_with(code)
                    return Ok(None)
                Err(message) =>
                    println(f"incan-pub native wrapper: {message}")
                    exit_with(1)
                    return Ok(None)
        None => pass
    match run(argv()):
        Ok(_) => return Ok(None)
        Err(message) =>
            println(f"refused: {message}")
            return Err("refused")


def run(arguments: list[str]) -> Result[None, str]:
    invocation = parse_invocation(arguments)?
    if invocation.command == "check":
        return check(invocation)
    if invocation.command == "build":
        return build(invocation)
    if invocation.command == "index-urls":
        state = replay(load_events(invocation.root())?, invocation.root())?
        for line in index_urls(state):
            println(line)
        return Ok(None)
    if invocation.command == "publish":
        return publish(invocation)
    if invocation.command == "add-fact":
        return add_fact(invocation)
    if invocation.command == "admit-drop":
        return admit_drop(invocation)
    if invocation.command == "attest":
        return attest(invocation)
    if invocation.command == "advise":
        return advise(invocation)
    if invocation.command == "adopt":
        return adopt(invocation)
    if invocation.command == "readopt":
        return readopt(invocation)
    if invocation.command == "record-fact":
        return record_fact(invocation)
    if invocation.command == "native-convert":
        return native_convert(invocation)
    if invocation.command == "push-source":
        return push_source(invocation)
    if invocation.command == "pack-units":
        return pack_units(invocation)
    if invocation.command == "push-units":
        return push_units_verb(invocation)
    if invocation.command == "admit-assets":
        return admit_assets(invocation)
    if invocation.command == "fetch-sources":
        return fetch_sources(invocation)
    if invocation.command == "describe-packages":
        return describe_packages(invocation)
    if invocation.command == "record-about":
        return record_about(invocation)
    return Err(f"unknown command `{invocation.command}`; see the usage at the top of src/main.incn")


def check(invocation: Invocation) -> Result[None, str]:
    root = invocation.root()
    events = load_events(root)?
    state = replay(events, root)?
    wanted = render_projections(state)?
    committed = committed_projections(root)?
    stale = stale_projections(committed, wanted)
    if len(stale) > 0:
        listed = ", ".join(stale)
        return Err(f"projections are out of date for [{listed}]; run incan-pub build")
    unclaimed = unclaimed_generated_inputs(root, state)? + unclaimed_graphs(root, events)?
    if len(unclaimed) > 0:
        listed = ", ".join(unclaimed)
        return Err(f"committed bytes no record names: [{listed}]; remove them or admit the fact that names them")
    mut verified = false
    match invocation.option("crates-io-index"):
        Some(directory) =>
            problems = verify_checksums(state, Path(directory))?
            if len(problems) > 0:
                return Err("crates.io disagrees with the log: " + "; ".join(problems))
            verified = true
        None => pass
    mut verification = verification_note(verified)
    match invocation.option("blobs"):
        Some(directory) =>
            missing = verify_archives(state, Path(directory))?
            if len(missing) > 0:
                return Err("the blob store disagrees with the log: " + "; ".join(missing))
            verification = verification + ", source Loaf archives verified"
        None => pass
    mut facts = 0
    mut attested = 0
    for key in keys_of(state):
        for fact in state[key].sorted_facts():
            facts += 1
            if fact.status == "attested":
                attested += 1
    println(
        f"ok: {len(events)} event(s), {len(state)} record(s), {facts} bound fact(s) ({attested} attested), "
        + f"projections in sync, {verification}"
    )
    return Ok(None)


def build(invocation: Invocation) -> Result[None, str]:
    root = invocation.root()
    state = replay(load_events(root)?, root)?
    wanted = render_projections(state)?
    write_projections(root, committed_projections(root)?, wanted)?
    mut facts = 0
    for key in keys_of(state):
        facts += len(state[key].facts)
    println(f"built: {len(state)} record(s), {facts} bound fact(s)")
    return Ok(None)


def publish(invocation: Invocation) -> Result[None, str]:
    if len(invocation.positional) != 3:
        return Err("usage: incan-pub publish NAME VERSION CHECKSUM [--notes FILE]")
    name = invocation.positional[0]
    version = invocation.positional[1]
    checksum = invocation.positional[2]
    if not is_sha256_identity(checksum):
        return Err("checksum must be `sha256:` plus 64 lowercase hex digits")
    root = invocation.root()
    state = replay(load_events(root)?, root)?
    if has_key(state, record_key(name, version)):
        return Err(f"{name} {version} is already published; versions are immutable")
    mut notes = ""
    match invocation.option("notes"):
        Some(file) => notes = read_text(Path(file), file)?.strip()
        None => pass
    mut payload: Dict[str, JsonValue] = {}
    payload["source"] = JsonValue.object({
        "registry": JsonValue.string(crates_io_index()),
        "checksum": JsonValue.string(checksum),
    })
    payload["notes"] = JsonValue.string(notes)
    written = append_event(root, "publish", name, version, invocation.actor(), payload)?
    println(f"published record: {written}")
    return build(invocation)


def add_fact(invocation: Invocation) -> Result[None, str]:
    if len(invocation.positional) != 1:
        return Err("usage: incan-pub add-fact PROPOSAL.json")
    mut notes_override: Option[str] = None
    match invocation.option("notes"):
        Some(file) => notes_override = Some(read_text(Path(file), file)?.strip())
        None => pass
    root = invocation.root()
    admit_proposal(
        root,
        replay(load_events(root)?, root)?,
        Path(invocation.positional[0]),
        invocation.actor(),
        invocation.flag("publish"),
        notes_override,
        false,
    )?
    return build(invocation)


def admit_proposal(
    root: Path,
    state: Dict[str, Record],
    proposal_path: Path,
    actor: str,
    publish: bool,
    notes_override: Option[str],
    rewrite: bool,
) -> Result[str, str]:
    """
    Admit one harvest proposal against `state`, returning what it did: `published`, `admitted` or `no-op`.

    `state` is the fold of the log as it stands; the caller folds whatever this appends before the next proposal,
    and rebuilds the projections once it has admitted everything it means to.
    """
    proposal = parse_event(read_text(proposal_path, proposal_path.name())?, "proposal")?
    project = member(proposal, "project")
    source = member(proposal, "source")
    evidence = member(proposal, "evidence")
    name = string_member(project, "name")
    version = string_member(project, "version")
    mut facts: list[JsonValue] = []
    match member(proposal, "rust").get("facts"):
        Some(value) =>
            match value.as_array():
                Some(items) => facts = items
                None => pass
        None => pass
    if len(name) == 0 or len(version) == 0 or len(facts) != 1:
        return Err("a proposal names one package version and carries exactly one rust.facts record")
    match string_list_member(evidence, "hazards"):
        Some(names) =>
            if len(names) > 0:
                listed = ", ".join(names)
                return Err(f"the harvest ran under ambient state a stable publisher never has ({listed}); its answers are not facts of the toolchain")
        None => pass
    if string_member(source, "registry") != crates_io_index():
        return Err("source must name the crates.io index; this registry adopts no other upstream")
    checksum = string_member(source, "checksum")
    if not is_sha256_identity(checksum):
        return Err("checksum must be `sha256:` plus 64 lowercase hex digits")
    key = record_key(name, version)
    create = not has_key(state, key)
    if create and not publish:
        return Err(f"{name} {version} has no external-source record; publish it first or pass --publish")
    if not create and checksum != state[key].checksum:
        return Err("the proposal binds a different source checksum than the published record")
    # Everything the proposal can be refused for is decided before the log is touched. The log is append-only, so a
    # publish written for a proposal that then refuses is a record nothing can ever retract.
    mut fact = facts[0]
    receipt = string_member(evidence, "receipt")
    if len(receipt) > 0:
        fact.set("harvested-from", JsonValue.string(receipt)).unwrap()
    staged = stage_generated_inputs(fact, proposal_path.parent(), root / "crates-io" / name / version)?
    label = f"proposal {proposal_path.name()}"
    # A refused proposal leaves nothing behind: the files it staged would otherwise be bytes no record names.
    match settle_binding(root, state, key, name, version, fact, evidence, proposal_path, label, create, rewrite):
        Ok(outcome) =>
            if outcome != "new":
                return Ok(outcome)
        Err(message) =>
            for path in staged:
                path.unlink().unwrap()
            return Err(message)
    if create:
        mut notes = string_member(proposal, "notes").strip()
        match notes_override:
            Some(text) => notes = text
            None => pass
        mut publication: Dict[str, JsonValue] = {}
        publication["source"] = JsonValue.object({
            "registry": JsonValue.string(crates_io_index()),
            "checksum": JsonValue.string(checksum),
        })
        publication["notes"] = JsonValue.string(notes)
        published = append_event(root, "publish", name, version, actor, publication)?
        println(f"published record: {published}")
    mut payload: Dict[str, JsonValue] = {}
    payload["fact"] = fact
    payload["evidence"] = evidence
    written = append_event(root, "fact", name, version, actor, payload)?
    println(f"admitted fact: {written}")
    if create:
        return Ok("published")
    return Ok("admitted")


def settle_binding(
    root: Path,
    state: Dict[str, Record],
    key: str,
    name: str,
    version: str,
    fact: JsonValue,
    evidence: JsonValue,
    proposal_path: Path,
    label: str,
    create: bool,
    rewrite: bool,
) -> Result[str, str]:
    """
    Decide what a proposal's binding needs: `new` when nothing is on record, `no-op` when the record is the same, and
    a refusal when it differs, unless `rewrite` replaces a record that is wrong because of a bug in place.
    """
    typed = validate_fact(fact, name, version, label, root)?
    binding_key = typed.key()
    if create or not has_key(state[key].facts, binding_key):
        stage_graph(evidence, proposal_path.parent(), root)?
        return Ok("new")
    if state[key].facts[binding_key].comparable == typed.comparable:
        println(f"already admitted: {name} {version} {describe_binding(typed.binding)}")
        return Ok("no-op")
    if not rewrite:
        return Err(f"the proposal's binding{describe_owners(typed.owners)} already has a different record; a fact is immutable")
    for event in load_events(root)?:
        if event.kind == "fact" and event.name == name and event.version == version:
            recorded = member(event.body, "fact")
            if fact_key(validate_binding(recorded, event.label)?, fact_owners(recorded)) == binding_key:
                stage_graph(evidence, proposal_path.parent(), root)?
                rewrite_event(root, event.label, event.body, {"fact": fact, "evidence": evidence})?
                println(f"rewritten: {event.label}")
                return Ok("rewritten")
    return Err(f"{name} {version} {describe_binding(typed.binding)} has no fact event to rewrite")


def admit_drop(invocation: Invocation) -> Result[None, str]:
    """
    Admit a whole harvest drop: every `<name>-<version>-<profile>/proposal.json` under one directory.

    The drop is checked before anything is admitted, because a contradiction between what a harvest proposed and
    what it refused is invisible once the proposals are read one at a time: a fact that omits work the script does
    says nothing about the work it omits. A refusal names the drop and admits none of it.
    """
    if len(invocation.positional) != 1:
        return Err("usage: incan-pub admit-drop DIR")
    drop = Path(invocation.positional[0])
    proposals = drop_proposals(drop)?
    if len(proposals) == 0:
        return Err(f"{invocation.positional[0]} holds no `<name>-<version>-<profile>/proposal.json`")
    contradictions = drop_contradictions(proposal_subjects(drop, proposals)?, drop_refusals(drop)?)
    if len(contradictions) > 0:
        listed = ", ".join(contradictions)
        return Err(f"the drop both proposes and refuses [{listed}]; a record that omits the work its refusal names would declare less than the script does")
    root = invocation.root()
    mut state = replay(load_events(root)?, root)?
    mut folded = len(event_files(root)?)
    mut published = 0
    mut admitted = 0
    mut repeated = 0
    for subject in proposals:
        outcome = admit_proposal(root, state, drop / subject / "proposal.json", invocation.actor(), true, None, false)?
        appended = load_events_after(root, folded)?
        state = replay_onto(state, appended, root)?
        folded += len(appended)
        if outcome == "published":
            published += 1
            admitted += 1
        elif outcome == "admitted":
            admitted += 1
        else:
            repeated += 1
    println(f"drop admitted: {len(proposals)} proposal(s), {published} record(s) published, {admitted} fact(s) admitted, {repeated} already on record")
    return build(invocation)


def stage_generated_inputs(fact: JsonValue, proposal_dir: Path, out_dir: Path) -> Result[list[Path], str]:
    """
    Copy the proposal's `out` files under the record, refusing to overwrite a committed input with other bytes, and
    return the files it newly wrote so a refusal can take them back.
    """
    mut written: list[Path] = []
    mut entries: list[JsonValue] = []
    match fact.get("out"):
        Some(value) =>
            match value.as_array():
                Some(items) => entries = items
                None => pass
        None => pass
    for entry in entries:
        entry_name = string_member(entry, "name")
        entry_path = string_member(entry, "path")
        staged = proposal_dir / entry_path
        if not staged.is_file():
            return Err(f"proposal out `{entry_name}` names a missing file {entry_path}")
        destination = out_dir / entry_path
        mut staged_bytes: bytes = b""
        match staged.read_bytes():
            Ok(data) => staged_bytes = data
            Err(error) => return Err(f"proposal out `{entry_name}`: {error.message()}")
        if destination.exists():
            match destination.read_bytes():
                Ok(existing) =>
                    if existing != staged_bytes:
                        return Err(f"committed generated input {entry_path} already exists with different bytes")
                Err(error) => return Err(f"{entry_path}: {error.message()}")
            continue
        match destination.parent().mkdir(parents=true, exist_ok=true):
            Ok(_) => pass
            Err(error) => return Err(f"{entry_path}: {error.message()}")
        match destination.write_bytes(staged_bytes):
            Ok(_) => written.append(destination)
            Err(error) => return Err(f"{entry_path}: {error.message()}")
    return Ok(written)


def attest(invocation: Invocation) -> Result[None, str]:
    if len(invocation.positional) != 2:
        return Err("usage: incan-pub attest NAME VERSION --toolchain T --target TRIPLE --profile P [--features a,b] --asset SHA --unit-identity SHA --attestation REF")
    name = invocation.positional[0]
    version = invocation.positional[1]
    mut features: list[str] = []
    match invocation.option("features"):
        Some(text) =>
            for feature in text.split(","):
                if len(feature) > 0:
                    features.append(feature)
        None => pass
    mut feature_values: list[JsonValue] = []
    for feature in features:
        feature_values.append(JsonValue.string(feature))
    binding = JsonValue.object({
        "toolchain": JsonValue.string(invocation.require("toolchain")?),
        "target": JsonValue.string(invocation.require("target")?),
        "profile": JsonValue.string(invocation.require("profile")?),
        "features": JsonValue.array(feature_values),
    })
    typed = validate_binding(binding, "attest")?
    mut owners: list[str] = []
    for owner in invocation.option("owners").unwrap_or("").split(","):
        if len(owner) > 0:
            owners.append(owner)
    owners = sorted(owners)
    root = invocation.root()
    state = replay(load_events(root)?, root)?
    key = record_key(name, version)
    if not has_key(state, key) or not has_key(state[key].facts, fact_key(typed, owners)):
        return Err("attestation must name a published record and one of its bound facts")
    mut payload: Dict[str, JsonValue] = {}
    payload["binding"] = binding
    if len(owners) > 0:
        mut owner_values: list[JsonValue] = []
        for owner in owners:
            owner_values.append(JsonValue.string(owner))
        payload["owners"] = JsonValue.array(owner_values)
    payload["attestation"] = JsonValue.object({
        "asset": JsonValue.string(invocation.require("asset")?),
        "unit_identity": JsonValue.string(invocation.require("unit-identity")?),
        "reference": JsonValue.string(invocation.require("attestation")?),
    })
    written = append_event(root, "attest", name, version, invocation.actor(), payload)?
    println(f"attested: {written}")
    return build(invocation)


def advise(invocation: Invocation) -> Result[None, str]:
    """Record something a consumer of a record should know; rendered as a header comment and counted on the index line."""
    if len(invocation.positional) != 2:
        return Err("usage: incan-pub advise NAME VERSION --text TEXT")
    name = invocation.positional[0]
    version = invocation.positional[1]
    text = invocation.require("text")?.strip()
    if len(text) == 0:
        return Err("an advisory carries a non-empty `text`")
    root = invocation.root()
    state = replay(load_events(root)?, root)?
    if not has_key(state, record_key(name, version)):
        return Err(f"{name} {version} has no external-source record")
    mut payload: Dict[str, JsonValue] = {}
    payload["advisory"] = JsonValue.object({"text": JsonValue.string(text)})
    written = append_event(root, "advisory", name, version, invocation.actor(), payload)?
    println(f"advised: {written}")
    return build(invocation)


def adopt(invocation: Invocation) -> Result[None, str]:
    """
    Adopt versions and their dependency closure: plan everything, then append one `adopt` event per version in
    dependency order, folding each before the next so admission checks every one as it lands.
    """
    if len(invocation.positional) % 2 != 0:
        return Err("usage: incan-pub adopt [NAME VERSION]... [--records] --cache DIR --blobs DIR")
    cache = invocation.require("cache")?
    blobs = invocation.require("blobs")?
    root = invocation.root()
    mut state = replay(load_events(root)?, root)?
    mut targets: list[list[str]] = []
    mut index = 0
    while index < len(invocation.positional):
        targets.append([invocation.positional[index], invocation.positional[index + 1]])
        index += 2
    if invocation.flag("records"):
        for key in sorted(list(state.keys())):
            record = state[key]
            match record.adopt:
                Some(_) => pass
                None => targets.append([record.name, record.version])
    if len(targets) == 0:
        return Err("name at least one version, or pass --records")
    plan = plan_closure(adopted_adoptions(state)?, targets, cache, blobs)?
    mut folded = len(event_files(root)?)
    for item in plan:
        payload = adoption_payload(item.adoption, item.manifest, item.archive)
        written = append_event(root, "adopt", item.adoption.package, item.adoption.version, invocation.actor(), payload)?
        appended = load_events_after(root, folded)?
        state = replay_onto(state, appended, root)?
        folded += len(appended)
        println(f"adopted: {written}")
    println(f"adoption: {len(plan)} version(s) adopted for {len(targets)} target(s)")
    return build(invocation)


def readopt(invocation: Invocation) -> Result[None, str]:
    """
    Rewrite the `adopt` events of versions whose adoption is wrong because of a translation bug.

    Each named version is translated again with this tool; its `adopt` event keeps its place, time and actor and
    takes the corrected payload. A version whose translation comes out the same is right, and right adoptions are not
    rewritten, so it is refused. The whole log is folded again before the projections are rebuilt.
    """
    if len(invocation.positional) == 0 or len(invocation.positional) % 2 != 0:
        return Err("usage: incan-pub readopt NAME VERSION [NAME VERSION]... --cache DIR --blobs DIR")
    cache = invocation.require("cache")?
    blobs = invocation.require("blobs")?
    root = invocation.root()
    events = load_events(root)?
    mut index = 0
    while index < len(invocation.positional):
        name = invocation.positional[index]
        version = invocation.positional[index + 1]
        index += 2
        mut found = false
        for event in events:
            if event.kind == "adopt" and event.name == name and event.version == version:
                found = true
                item = prepare(cache, blobs, find_line(crates_io_lines(cache, name)?, name, version)?)?
                payload = adoption_payload(item.adoption, item.manifest, item.archive)
                if canonical(JsonValue.object(payload))? == canonical(adopt_payload(event.body))?:
                    return Err(f"{name} {version}: the translation comes out the same; a right adoption is not rewritten")
                rewrite_event(root, event.label, event.body, payload)?
                println(f"rewritten: {event.label}")
        if not found:
            return Err(f"{name} {version} has no adopt event to rewrite")
    replay(load_events(root)?, root)?
    return build(invocation)


def record_about(invocation: Invocation) -> Result[None, str]:
    """
    Record what each adopted package's manifest says about it (`about`: license, README, description, links) on the
    `adopt` events that predate it, so every Loaf carries a license and a README and its package page can name them.

    The recorded payload is kept as it is and only gains `about`, so the manifest is unchanged; the archive gains a
    LICENSE or README.md only where the package ships none. Each event keeps its place, time and actor. With no
    versions named, every adoption without `about` is recorded.
    """
    if len(invocation.positional) % 2 != 0:
        return Err("usage: incan-pub record-about [NAME VERSION]... --cache DIR --blobs DIR [--root DIR]")
    cache = invocation.require("cache")?
    blobs = invocation.require("blobs")?
    root = invocation.root()
    mut named: list[str] = []
    mut index = 0
    while index < len(invocation.positional):
        named.append(invocation.positional[index] + "\t" + invocation.positional[index + 1])
        index += 2
    mut rewritten = 0
    mut archives = 0
    for event in load_events(root)?:
        if event.kind != "adopt" or event.body.contains_key("about"):
            continue
        if len(named) > 0 and not named.contains(event.name + "\t" + event.version):
            continue
        label = f"{event.name} {event.version}"
        mut adoption = adoption_from_payload(event.body, label)?
        line = find_line(crates_io_lines(cache, event.name)?, event.name, event.version)?
        files = unpack_crate(event.name, event.version, crate_archive(cache, event.name, event.version, string_member(line, "cksum"))?)?
        adoption.about = Some(about_of_files(files, label)?)
        manifest = render_adopted_manifest(adoption)
        if digest_text(manifest) != string_member(event.body, "manifest"):
            return Err(f"{label}: recording `about` would change the manifest; it must only add files")
        archive = source_archive(manifest, loaf_files(adoption, files))?
        digest = digest_bytes(archive)
        path = blob_path(Path(blobs), digest)
        if not path.is_file():
            match Path(blobs + "/sha256").mkdir(parents=true, exist_ok=true):
                Ok(_) => pass
                Err(error) => return Err(f"{blobs}: {error.message()}")
            match path.write_bytes(archive):
                Ok(_) => pass
                Err(error) => return Err(f"{blobs}: {error.message()}")
        if digest != string_member(event.body, "archive"):
            archives += 1
        rewrite_event(root, event.label, event.body, adoption_payload(adoption, string_member(event.body, "manifest"), digest))?
        rewritten += 1
    println(f"recorded about: {rewritten} adoption(s), {archives} archive(s) gained a LICENSE or README")
    replay(load_events(root)?, root)?
    return build(invocation)


def record_fact(invocation: Invocation) -> Result[None, str]:
    """
    Record the build fact of one adopted version for one binding by running its build script, then admit it; with
    `--propose`, leave the proposal for `add-fact` instead (how a runner records facts the index admits elsewhere).

    The graph file holds the resolution the binding's feature set came from (`deps` or `roots`, `target`, `host`);
    it is committed with the fact. A version without a build script needs no fact and is reported as such.
    """
    if len(invocation.positional) != 2:
        return Err("usage: incan-pub record-fact NAME VERSION --features a,b --profile P --domain D --graph FILE --rustc PATH --cache DIR --blobs DIR --work DIR")
    name = invocation.positional[0]
    version = invocation.positional[1]
    root = invocation.root()
    state = replay(load_events(root)?, root)?
    key = record_key(name, version)
    if key not in state:
        return Err(f"{name} {version} is not adopted")
    mut adopt = JsonValue.null()
    match state[key].adopt:
        Some(payload) => adopt = payload
        None => return Err(f"{name} {version} is not adopted")
    selection = selection_of(invocation)?
    match record_proposal(name, version, adopt, state[key].checksum, invocation.require("blobs")?, invocation.require("cache")?, invocation.require("work")?, selection)?:
        Some(proposal) =>
            if invocation.flag("propose"):
                println(f"proposed: {proposal}")
                return Ok(None)
            admit_proposal(root, state, Path(proposal), invocation.actor(), false, None, invocation.flag("rewrite"))?
            return build(invocation)
        None =>
            println(f"no build script: {name} {version} needs no fact")
            return Ok(None)


def selection_of(invocation: Invocation) -> Result[Selection, str]:
    """The binding from the command line, its toolchain identity read from the `rustc` that will compile the script."""
    rustc = invocation.require("rustc")?
    version = run_program(rustc, ["--version"], {"PATH": "/usr/bin:/bin"}, ".")?
    if not version.success:
        return Err(f"{rustc} --version failed")
    mut toolchain = ""
    match version.stdout.decode():
        Ok(text) => toolchain = text.strip()
        Err(error) => return Err(f"{rustc} --version: {error}")
    mut features: list[str] = []
    for feature in invocation.option("features").unwrap_or("").split(","):
        if len(feature) > 0:
            features.append(feature)
    profile = invocation.require("profile")?
    domain = invocation.require("domain")?
    if profile != "debug" and profile != "release":
        return Err("`--profile` is debug or release")
    if domain != "host" and domain != "target":
        return Err("`--domain` is host or target")
    graph_file = invocation.require("graph")?
    described = parse_event(read_text(Path(graph_file), graph_file)?, graph_file)?
    mut roots = member(described, "roots")
    if described.contains_key("deps"):
        roots = member(described, "deps")
    graph = JsonValue.object({
        "roots": roots,
        "target": JsonValue.string(string_member(described, "target")),
        "host": JsonValue.string(string_member(described, "host")),
    })
    validate_graph(graph, graph_file)?
    return Ok(Selection(
        toolchain=toolchain,
        rustc=rustc,
        target=string_member(described, "target"),
        host=string_member(described, "host"),
        profile=profile,
        features=sorted(features),
        domain=domain,
        graph=graph,
        cc=invocation.option("cc").unwrap_or(""),
        cxx=invocation.option("cxx").unwrap_or(""),
        ar=invocation.option("ar").unwrap_or(""),
        sysroot=invocation.option("sysroot").unwrap_or(""),
        incan=invocation.option("incan").unwrap_or(""),
        build_lock=invocation.option("build-lock").unwrap_or(""),
        pin=canonical_path(invocation.option("root").unwrap_or("."))?,
    ))


def native_convert(invocation: Invocation) -> Result[None, str]:
    """Print the link records a directory of native traces converts to: the inspection side of `record-fact`."""
    compilers = [
        Compiler(
            executable=canonical_path(invocation.require("cc")?)?,
            resource_dir=compiler_resource_dir(invocation.require("cc")?)?,
            sysroot=canonical_path(invocation.require("sysroot")?)?,
        ),
        Compiler(
            executable=canonical_path(invocation.require("cxx")?)?,
            resource_dir=compiler_resource_dir(invocation.require("cxx")?)?,
            sysroot=canonical_path(invocation.require("sysroot")?)?,
        ),
    ]
    mut libraries: list[str] = []
    for library in invocation.require("libraries")?.split(","):
        if len(library) > 0:
            libraries.append(library)
    conversion = convert(read_traces(invocation.require("trace")?)?, libraries, compilers)?
    println(pretty(JsonValue.object({
        "link": JsonValue.array(conversion.records),
        "compiler_probes": JsonValue.array([JsonValue.string(probe) for probe in conversion.probes]),
    }))?)
    return Ok(None)


def compiler_resource_dir(compiler: str) -> Result[str, str]:
    ran = run_program(compiler, ["-print-resource-dir"], {"PATH": "/usr/bin:/bin"}, ".")?
    if not ran.success:
        return Err(f"{compiler} did not report its resource directory")
    match ran.stdout.decode():
        Ok(text) => return canonical_path(text.strip())
        Err(error) => return Err(f"{compiler}: {error}")


def push_source(invocation: Invocation) -> Result[None, str]:
    """
    Push an adopted version's source Loaf archive to the registry as `<namespace>/crates-io/<name>:<version>`.

    The archive comes from the blob store; on a machine whose store does not hold it, it is rebuilt from the crate and
    the manifest the adoption's own payload renders, and must have exactly the digest the index names, so a push can
    never carry other bytes than the adoption.
    """
    if len(invocation.positional) != 2:
        return Err("usage: incan-pub push-source NAME VERSION --cache DIR --blobs DIR --work DIR [--registry HOST] [--namespace NS]")
    name = invocation.positional[0]
    version = invocation.positional[1]
    root = invocation.root()
    state = replay(load_events(root)?, root)?
    key = record_key(name, version)
    if key not in state:
        return Err(f"{name} {version} is not adopted")
    mut payload = JsonValue.null()
    match state[key].adopt:
        Some(found) => payload = found
        None => return Err(f"{name} {version} is not adopted")
    digest = string_member(payload, "archive")
    blobs = invocation.require("blobs")?
    archive = blobs + "/sha256/" + digest[7:] + ".tar"
    if not Path(archive).is_file():
        cache = invocation.require("cache")?
        made = reproduce(cache, blobs, find_line(crates_io_lines(cache, name)?, name, version)?, payload)?
        if made != digest:
            return Err(f"{name} {version}: the crate and the adoption's own manifest give {made}, not the archive {digest} the index names")
    registry = registry_of(invocation)?
    repository_name = repository(registry, "crates-io", name)
    tag = version_tag(version)?
    layer = Layer(
        path=archive,
        media_type=SOURCE_LAYER,
        annotations={"org.opencontainers.image.title": f"{name}-{version}.tar", "dev.incan.loaf.archive": digest},
    )
    annotations: Dict[str, str] = {
        "org.opencontainers.image.source": SOURCE_REPOSITORY,
        "org.opencontainers.image.description": package_description("crates-io", name),
        "dev.incan.loaf.name": loaf_name(name),
        "dev.incan.loaf.version": version,
    }
    pushed = push(registry, repository_name, tag, SOURCE_ARTIFACT, [layer], annotations, false)?
    println(f"pushed: {registry.host}/{repository_name}:{tag} {pushed}")
    return Ok(None)


def pack_units(invocation: Invocation) -> Result[None, str]:
    """
    Pack the units one `incan oven compile-closure` run compiled, one archive each, and list them in `units.json`.

    `--only` keeps the units of the named `NAME@VERSION`s; each must match a unit the closure compiled. `--reproduces`
    names a second compile of the same closure in another root, and every unit must come out of it with the same unit
    identity, entry and archive bytes: a unit that depends on where it was compiled is refused before it is published.
    """
    if len(invocation.positional) != 1:
        return Err("usage: incan-pub pack-units CLOSURE_DIR --out DIR [--only NAME@VERSION,...] [--reproduces CLOSURE_DIR]")
    out = make_directory(invocation.require("out")?)?
    mut only: list[str] = []
    for item in invocation.option("only").unwrap_or("").split(","):
        if len(item) > 0:
            only.append(item)
    packed = pack_closure(invocation.positional[0], only, out)?
    match invocation.option("reproduces"):
        Some(other) =>
            again = pack_closure(other, only, make_directory(out + "/reproduction")?)?
            differences = reproduction_differences(packed, again)
            if len(differences) > 0:
                listed = "; ".join(differences)
                return Err(f"the closure does not reproduce in another root, so its units name the machine: {listed}")
            println(f"reproduced: {len(packed)} unit(s) identical in both roots")
        None => pass
    for item in packed:
        println(f"packed: {item.name} {item.version} {item.unit} {item.archive}")
    return write_units(out, packed)


def push_units_verb(invocation: Invocation) -> Result[None, str]:
    """Push packed units, one tag per binding, and write the asset proposals `admit-assets` records."""
    if len(invocation.positional) != 1:
        return Err("usage: incan-pub push-units DIR --builder KIND --attestation REF --proposals DIR --work DIR [--registry HOST] [--namespace NS]")
    builder = invocation.require("builder")?
    if not builders().contains(builder):
        return Err("--builder must be publisher, registry or local")
    attestation = invocation.require("attestation")?
    proposals = make_directory(invocation.require("proposals")?)?
    registry = registry_of(invocation)?
    for line in push_units(registry, read_units(invocation.positional[0])?, builder, attestation, proposals)?:
        println(f"pushed: {line}")
    return Ok(None)


def admit_assets(invocation: Invocation) -> Result[None, str]:
    """
    Record the asset proposals a bake wrote, then rebuild the projections.

    Each proposal is decided against the folded log before anything is written, and its archive is then pulled
    without credentials, as any consumer would, and must arrive with its digest: the index never names an asset that
    is private, missing or other bytes.
    """
    if len(invocation.positional) != 1:
        return Err("usage: incan-pub admit-assets DIR --work DIR [--actor ACTOR] [--root DIR]")
    directory = invocation.positional[0]
    root = invocation.root()
    mut state = replay(load_events(root)?, root)?
    work = make_directory(invocation.require("work")?)?
    mut names: list[str] = []
    match Path(directory).iterdir():
        Ok(children) =>
            for child in children:
                if child.name().endswith(".json"):
                    names.append(child.name())
        Err(error) => return Err(f"{directory}: {error.message()}")
    for file_name in sorted(names):
        label = f"asset proposal {file_name}"
        proposal = parse_event(read_text(Path(directory + "/" + file_name), file_name)?, label)?
        name = string_member(proposal, "name")
        version = string_member(proposal, "version")
        key = record_key(name, version)
        if not has_key(state, key):
            return Err(f"{label}: {name} {version} has no record")
        asset = member(proposal, "asset")
        record = admit_asset(state[key], member(proposal, "binding"), asset, label)?
        if len(record.assets) == len(state[key].assets):
            println(f"no-op: {label} is already recorded")
            continue
        location = member(asset, "location")
        source = Registry(host=string_member(location, "registry"), namespace="", work=work)
        anonymous_fetch(source, string_member(location, "repository"), string_member(asset, "archive"), work + "/fetched.tar")?
        mut payload: Dict[str, JsonValue] = {}
        payload["binding"] = member(proposal, "binding")
        payload["asset"] = asset
        written = append_event(root, "asset", name, version, invocation.actor(), payload)?
        state[key] = record
        println(f"admitted asset: {written}")
    return build(invocation)


def describe_packages(invocation: Invocation) -> Result[None, str]:
    """
    Set the package description on every tag the index knows of: each adopted version's source tag and each asset's
    binding tag. A tag that was never pushed is skipped; only manifests are written, never blobs.
    """
    root = invocation.root()
    state = replay(load_events(root)?, root)?
    registry = registry_of(invocation)?
    mut described = 0
    mut absent = 0
    for key in sorted(list(state.keys())):
        record = state[key]
        mut adopted = false
        match record.adopt:
            Some(_) => adopted = true
            None => pass
        if not adopted:
            continue
        repository_name = repository(registry, "crates-io", record.name)
        annotations: Dict[str, str] = {"org.opencontainers.image.description": package_description("crates-io", record.name)}
        mut tags: list[str] = [version_tag(record.version)?]
        for asset in record.assets:
            tag = string_member(asset.location, "tag")
            if not tags.contains(tag):
                tags.append(tag)
        for tag in tags:
            if annotate(registry, repository_name, tag, annotations)?:
                described += 1
            else:
                absent += 1
    println(f"described: {described} tag(s); {absent} not pushed")
    return Ok(None)


def fetch_sources(invocation: Invocation) -> Result[None, str]:
    """
    Put the source Loaf archive of every unit a resolution lock names into `--blobs`, pulled from the registry without
    credentials and checked against the digest the lock gives it; an archive already there is kept.
    """
    if len(invocation.positional) != 1:
        return Err("usage: incan-pub fetch-sources LOCK.json --blobs DIR --work DIR [--registry HOST] [--namespace NS]")
    lock = parse_event(read_text(Path(invocation.positional[0]), invocation.positional[0])?, "lock")?
    blobs = make_directory(invocation.require("blobs")? + "/sha256")?
    registry = registry_of(invocation)?
    match member(lock, "units").as_array():
        Some(units) =>
            for unit in units:
                loaf = string_member(unit, "loaf")
                digest = string_member(unit, "archive_digest")
                if not loaf.startswith("crates-io/") or not is_sha256_identity(digest):
                    return Err(f"lock: unit {canonical(unit)?} names no crates.io Loaf archive")
                destination = blobs + "/" + digest[7:] + ".tar"
                if not Path(destination).is_file():
                    anonymous_fetch(registry, repository(registry, "crates-io", loaf[10:]), digest, destination)?
                    version = string_member(unit, "version")
                    println(f"fetched: {loaf} {version} {digest}")
            return Ok(None)
        None => return Err("lock: no `units`")


def registry_of(invocation: Invocation) -> Result[Registry, str]:
    """The registry `--registry` and `--namespace` name (GHCR under this repository by default), working in `--work`."""
    return Ok(Registry(
        host=invocation.option("registry").unwrap_or("ghcr.io"),
        namespace=invocation.option("namespace").unwrap_or("encero-systems/incan.pub"),
        work=make_directory(invocation.require("work")?)?,
    ))


def make_directory(path: str) -> Result[str, str]:
    match Path(path).mkdir(parents=true, exist_ok=true):
        Ok(_) => return Ok(path)
        Err(error) => return Err(f"{path}: {error.message()}")


def verify_archives(state: Dict[str, Record], blobs: Path) -> Result[list[str], str]:
    """Every adopted record whose source Loaf archive is missing from the blob store or has other bytes."""
    mut problems: list[str] = []
    for key in sorted(list(state.keys())):
        record = state[key]
        match record.adopt:
            Some(payload) =>
                digest = string_member(payload, "archive")
                path = blob_path(blobs, digest)
                if not path.is_file():
                    problems.append(f"{record.name} {record.version}: no archive {digest}")
                    continue
                match path.read_bytes():
                    Ok(data) =>
                        if digest_bytes(data) != digest:
                            problems.append(f"{record.name} {record.version}: the stored archive is not {digest}")
                    Err(error) => problems.append(f"{record.name} {record.version}: {error.message()}")
            None => pass
    return Ok(problems)


def verification_note(verified: bool) -> str:
    if verified:
        return "crates.io checksums verified"
    return "checksums not verified: no crates.io index snapshot given"
