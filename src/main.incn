"""
incan-pub: the interim registry's tool. Admission (`check`), projection (`build`) and the publishing verbs.

    incan-pub check [--root DIR] [--crates-io-index DIR]
    incan-pub build [--root DIR]
    incan-pub index-urls [--root DIR]
    incan-pub publish NAME VERSION CHECKSUM [--notes FILE] [--actor ACTOR] [--root DIR]
    incan-pub add-fact PROPOSAL.json [--publish] [--notes FILE] [--actor ACTOR] [--root DIR]
    incan-pub admit-drop DIR [--actor ACTOR] [--root DIR]
    incan-pub attest NAME VERSION --toolchain T --target TRIPLE --profile P [--features a,b]
                     --asset SHA --unit-identity SHA --attestation REF [--owners SHA,...] [--actor ACTOR] [--root DIR]
    incan-pub advise NAME VERSION --text TEXT [--actor ACTOR] [--root DIR]
    incan-pub adopt [NAME VERSION]... [--records] --cache DIR --blobs DIR [--actor ACTOR] [--root DIR]
    incan-pub readopt NAME VERSION [NAME VERSION]... --cache DIR --blobs DIR [--root DIR]
    incan-pub record-about [NAME VERSION]... --cache DIR --blobs DIR [--root DIR]
    incan-pub record-fact NAME VERSION --features a,b --profile P --domain D --graph FILE --rustc PATH
                          --cache DIR --blobs DIR --work DIR [--cc PATH --cxx PATH --ar PATH --sysroot DIR]
                          [--incan PATH --build-lock LOCK.json]
                          [--propose] [--actor ACTOR] [--root DIR]
    incan-pub native-convert --trace DIR --libraries static=a,static=b --cc PATH --cxx PATH --sysroot DIR
    incan-pub push-source NAME VERSION --cache DIR --blobs DIR --work DIR [--registry HOST] [--namespace NS]
    incan-pub pack-units CLOSURE_DIR --out DIR [--only NAME@VERSION,...] [--reproduces CLOSURE_DIR]
    incan-pub push-units DIR --builder KIND --attestation REF --proposals DIR --work DIR [--registry HOST] [--namespace NS]
    incan-pub admit-assets DIR --work DIR [--actor ACTOR] [--root DIR]
    incan-pub fetch-sources LOCK.json --blobs DIR --work DIR [--registry HOST] [--namespace NS]
    incan-pub describe-packages --work DIR [--registry HOST] [--namespace NS] [--root DIR]

`--root` is the checkout of the `index` branch; the current directory when omitted. A refusal prints
`refused: <rule>` and exits non-zero. `adopt` adopts the named versions, or with `--records` every record not yet
adopted, together with their dependency closure; `--cache` keeps what it downloads from crates.io and `--blobs` is the
store source Loaf archives are written to by digest.
"""

