"""
The admission rules, the canonical identity and the projections, each exercised on a scratch checkout.

Every refusal the tool can give is produced here at least once, by the exact rule that gives it. The identity
test pins the canonical form to the seed events, so a change to the serializer that would orphan the published log
fails here first.
"""

from std.fs import Path
from std.json import JsonValue, parse
from std.tempfile import TemporaryDirectory
from std.testing import assert_eq, assert_is_err, assert_true

from admission import fact_comparable, replay, replay_onto
from canonical import canonical, digest_text, is_sha256_identity, pretty
from drop import drop_contradictions, drop_proposals, drop_refusals, proposal_subjects
from events import append_event, event_id, load_events, load_events_after, string_list_member, write_text
from projection import (
    committed_projections,
    render_projections,
    stale_projections,
    unclaimed_generated_inputs,
    write_projections,
)
from registry import compare_versions, record_key, sparse_index_path


def libm_checksum() -> str:
    return "sha256:b6d2cec3eae94f9f509c767b45932f1ada8350c4bdb85af2fcab4a3c14807981"


def toolchain() -> str:
    return "rustc 1.98.0 (88d9e12ae 2026-08-18)"


def target() -> str:
    return "aarch64-apple-darwin"


def seed_publish() -> str:
    return """{
  "actor": "encero-systems/incan.pub maintainers",
  "at": "2026-09-18T12:01:06Z",
  "id": "sha256:10a2b96c691803e48fc109a0b4baeae9f39dcbf2cee3b1a415fa9076a5184b95",
  "kind": "publish",
  "notes": "External-source record for the crates.io package `libm` 0.2.16.\\n\\n`build.rs` probes the opt-level, the enabled Cargo features and the target architecture, then emits\\n`rustc-cfg` answers. Under a frozen toolchain those answers are constants; each `[[rust.facts]]` record\\nbelow states them for one exact selection. The script also reemits `CFG_CARGO_FEATURES`, `CFG_OPT_LEVEL`\\nand `CFG_TARGET_FEATURES` through `rustc-env` for its own test logging; no compilation of the library\\nobserves them, so they are not facts and do not appear here.",
  "schema": "incan.pub/event/1",
  "signature": null,
  "source": {
    "checksum": "sha256:b6d2cec3eae94f9f509c767b45932f1ada8350c4bdb85af2fcab4a3c14807981",
    "registry": "https://github.com/rust-lang/crates.io-index"
  },
  "subject": {
    "name": "libm",
    "scope": "crates-io",
    "version": "0.2.16"
  }
}"""


def seed_fact() -> str:
    return """{
  "actor": "encero-systems/incan.pub maintainers",
  "at": "2026-09-18T12:01:06Z",
  "evidence": {
    "cargo_lock_digest": "sha256:b74440e4b6387c724c9a44b977572f5e8348bd19a47b3be7bd426e06909fa39a",
    "cargo_manifest_digest": "sha256:b3d7724708b38471d584c9292c009036fa51778418c24bc44c94572943737f2d",
    "cargo_version": "cargo 1.96.0-nightly (e84cb639e 2026-03-21)",
    "method": "compatibility publisher observation"
  },
  "fact": {
    "cfg": ["arch_enabled", "optimizations_enabled"],
    "features": ["arch", "default"],
    "profile": "release",
    "target": "aarch64-apple-darwin",
    "toolchain": "rustc 1.98.0 (88d9e12ae 2026-08-18)"
  },
  "id": "sha256:ff50e6bd5da4c049691e14ca5bc2900ffe1470e1b05cc371445f5f3c3f4fe07f",
  "kind": "fact",
  "schema": "incan.pub/event/1",
  "signature": null,
  "subject": {"name": "libm", "scope": "crates-io", "version": "0.2.16"}
}"""


# ---------------------------------------------------------------- identity ---------------------------------------


def test_the_seed_events_keep_their_identity() -> None:
    """The ids the seed log was published with are the digests this serializer computes."""
    publish = parse(seed_publish()).unwrap()
    assert_eq(event_id(publish).unwrap(), "sha256:10a2b96c691803e48fc109a0b4baeae9f39dcbf2cee3b1a415fa9076a5184b95")
    fact = parse(seed_fact()).unwrap()
    assert_eq(event_id(fact).unwrap(), "sha256:ff50e6bd5da4c049691e14ca5bc2900ffe1470e1b05cc371445f5f3c3f4fe07f")


def test_canonical_form_sorts_keys_and_escapes_only_what_json_requires() -> None:
    value = parse("{\"z\": [1, true, null], \"a\": {\"y\": \"q\\\"b\\\\s\\n\\t\\u0001\\u00e9\"}}").unwrap()
    assert_eq(canonical(value).unwrap(), "{\"a\":{\"y\":\"q\\\"b\\\\s\\n\\t\\u0001é\"},\"z\":[1,true,null]}")
    assert_is_err(canonical(parse("{\"x\": 1.5}").unwrap()))


def test_pretty_form_is_the_committed_spelling() -> None:
    value = parse("{\"b\": [], \"a\": {\"d\": 1, \"c\": [\"x\"]}, \"e\": {}}").unwrap()
    assert_eq(pretty(value).unwrap(), "{\n  \"a\": {\n    \"c\": [\n      \"x\"\n    ],\n    \"d\": 1\n  },\n  \"b\": [],\n  \"e\": {}\n}")


def test_sha256_identities_are_exactly_71_lowercase_characters() -> None:
    assert_true(is_sha256_identity(libm_checksum()))
    assert_true(not is_sha256_identity(libm_checksum().upper()))
    assert_true(not is_sha256_identity(libm_checksum() + "0"))
    assert_true(not is_sha256_identity("md5:b6d2cec3eae94f9f509c767b45932f1ada8350c4bdb85af2fcab4a3c14807981"))
    assert_eq(digest_text(""), "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")


def test_sparse_index_paths_follow_the_crates_io_scheme() -> None:
    assert_eq(sparse_index_path("a"), "1/a")
    assert_eq(sparse_index_path("ab"), "2/ab")
    assert_eq(sparse_index_path("abc"), "3/a/abc")
    assert_eq(sparse_index_path("serde_core"), "se/rd/serde_core")
    assert_eq(sparse_index_path("Proc-Macro2"), "pr/oc/proc-macro2")


def test_versions_order_numerically_and_longer_spellings_after_their_prefix() -> None:
    assert_true(compare_versions("0.9.0", "1.0.2") < 0)
    assert_true(compare_versions("1.0.2", "1.0.10") < 0)
    assert_true(compare_versions("1.0.10", "1.0.10") == 0)
    assert_true(compare_versions("1.0.0", "1.0.0-alpha") < 0)
    assert_true(compare_versions("1.0.0-alpha", "1.0.0-beta") < 0)


# ---------------------------------------------------------------- admission --------------------------------------


def scratch() -> TemporaryDirectory:
    return TemporaryDirectory.try_new().unwrap()


def publish_libm(root: Path) -> None:
    mut payload: Dict[str, JsonValue] = {}
    payload["source"] = JsonValue.object({
        "registry": JsonValue.string("https://github.com/rust-lang/crates.io-index"),
        "checksum": JsonValue.string(libm_checksum()),
    })
    payload["notes"] = JsonValue.string("A note.\n\nA second paragraph.")
    append_event(root, "publish", "libm", "0.2.16", "tests", payload).unwrap()


def binding(profile: str) -> Dict[str, JsonValue]:
    mut out: Dict[str, JsonValue] = {}
    out["toolchain"] = JsonValue.string(toolchain())
    out["target"] = JsonValue.string(target())
    out["profile"] = JsonValue.string(profile)
    out["features"] = JsonValue.array([JsonValue.string("arch"), JsonValue.string("default")])
    return out


def fact_with(profile: str, cfg: list[str]) -> JsonValue:
    mut members = binding(profile)
    mut values: list[JsonValue] = []
    for item in cfg:
        values.append(JsonValue.string(item))
    members["cfg"] = JsonValue.array(values)
    return JsonValue.object(members)


def add_fact(root: Path, fact: JsonValue) -> None:
    mut payload: Dict[str, JsonValue] = {}
    payload["fact"] = fact
    payload["evidence"] = JsonValue.object({"method": JsonValue.string("test")})
    append_event(root, "fact", "libm", "0.2.16", "tests", payload).unwrap()


def write_raw_event(root: Path, sequence: str, kind: str, body_text: str) -> None:
    """Write an event whose id is computed for it, so only the rule under test can refuse it."""
    mut body = parse(body_text).unwrap()
    identity = event_id(body).unwrap()
    body.set("id", JsonValue.string(identity)).unwrap()
    body.set("signature", JsonValue.null()).unwrap()
    write_text(root / "events" / f"{sequence}-{kind}-crates-io-libm-0.2.16.json", pretty(body).unwrap() + "\n", "event").unwrap()


def refusal(root: Path) -> str:
    match load_events(root):
        Ok(events) =>
            match replay(events, root):
                Ok(_) => return ""
                Err(message) => return message
        Err(message) => return message


def test_a_version_is_published_once() -> None:
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    publish_libm(root)
    assert_eq(refusal(root), "events/000002-publish-crates-io-libm-0.2.16.json: libm 0.2.16 is already published; versions are immutable")


def test_a_fact_needs_its_publish_event_first() -> None:
    directory = scratch()
    root = directory.path()
    add_fact(root, fact_with("release", []))
    assert_eq(refusal(root), "events/000001-fact-crates-io-libm-0.2.16.json: libm 0.2.16 has no publish or adopt event before this fact")


def test_a_publish_must_name_crates_io_and_a_checksum() -> None:
    directory = scratch()
    root = directory.path()
    write_raw_event(root, "000001", "publish", "{\"schema\": \"incan.pub/event/1\", \"kind\": \"publish\", \"at\": \"t\", \"actor\": \"tests\", \"subject\": {\"scope\": \"crates-io\", \"name\": \"libm\", \"version\": \"0.2.16\"}, \"source\": {\"registry\": \"https://example.invalid\", \"checksum\": \"" + libm_checksum() + "\"}}")
    assert_eq(refusal(root), "events/000001-publish-crates-io-libm-0.2.16.json: source must name the crates.io index and a `sha256:` checksum")


def test_the_log_has_no_gaps() -> None:
    directory = scratch()
    root = directory.path()
    write_raw_event(root, "000002", "publish", "{\"schema\": \"incan.pub/event/1\", \"kind\": \"publish\", \"at\": \"t\", \"actor\": \"tests\", \"subject\": {\"scope\": \"crates-io\", \"name\": \"libm\", \"version\": \"0.2.16\"}, \"source\": {\"registry\": \"https://github.com/rust-lang/crates.io-index\", \"checksum\": \"" + libm_checksum() + "\"}}")
    assert_eq(refusal(root), "events/000002-publish-crates-io-libm-0.2.16.json: sequence must be contiguous six-digit numbers in file order")


def test_a_tampered_event_is_refused_before_any_rule() -> None:
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    path = root / "events" / "000001-publish-crates-io-libm-0.2.16.json"
    text = path.read_text("utf-8", "strict").unwrap()
    write_text(path, text.replace("A second paragraph.", "A forged paragraph."), "event").unwrap()
    assert_eq(refusal(root), "events/000001-publish-crates-io-libm-0.2.16.json: id does not match the canonical event body")


def test_the_file_name_must_carry_the_event_kind() -> None:
    directory = scratch()
    root = directory.path()
    write_raw_event(root, "000001", "fact", "{\"schema\": \"incan.pub/event/1\", \"kind\": \"publish\", \"at\": \"t\", \"actor\": \"tests\", \"subject\": {\"scope\": \"crates-io\", \"name\": \"libm\", \"version\": \"0.2.16\"}, \"source\": {\"registry\": \"https://github.com/rust-lang/crates.io-index\", \"checksum\": \"" + libm_checksum() + "\"}}")
    assert_eq(refusal(root), "events/000001-fact-crates-io-libm-0.2.16.json: kind must be one of publish, adopt, fact, attest, asset, yank, unyank, advisory and match the file name")


def sha(seed: str) -> str:
    return digest_text(seed)


def executable(name: str) -> JsonValue:
    """An executable the publisher selected: identified by owner and bytes, never carried by the registry."""
    return JsonValue.object({
        "name": JsonValue.string(name),
        "owner": JsonValue.string(sha("owner")),
        "path": JsonValue.string("bin/" + name),
        "digest": JsonValue.string(sha(name)),
    })


def source_artifact(name: str, path: str) -> JsonValue:
    return JsonValue.object({
        "name": JsonValue.string(name),
        "kind": JsonValue.string("file"),
        "path": JsonValue.string(path),
        "digest": JsonValue.string(sha(path)),
    })


def object_record(name: str, source: str) -> JsonValue:
    """One compile: its own object file named once, as the single output its argv references."""
    return JsonValue.object({
        "name": JsonValue.string(name),
        "language": JsonValue.string("c"),
        "arguments": JsonValue.array([
            JsonValue.object({"literal": JsonValue.string("-O2")}),
            JsonValue.object({"input": JsonValue.string(source)}),
            JsonValue.object({"literal": JsonValue.string("-o")}),
            JsonValue.object({"output": JsonValue.string(name)}),
        ]),
    })


def link_record() -> JsonValue:
    return JsonValue.object({
        "name": JsonValue.string("helper"),
        "target": JsonValue.string("aarch64-apple-darwin"),
        "executable": executable("cc"),
        "environment": JsonValue.array([
            JsonValue.object({"name": JsonValue.string("SOURCE_DATE_EPOCH"), "literal": JsonValue.string("0")}),
        ]),
        "sources": JsonValue.array([source_artifact("helper_c", "c/helper.c")]),
        "objects": JsonValue.array([object_record("helper.o", "helper_c")]),
        "library": JsonValue.object({"name": JsonValue.string("sys_helper"), "kind": JsonValue.string("static")}),
    })


def tool_record() -> JsonValue:
    return JsonValue.object({
        "name": JsonValue.string("bindgen"),
        "target": JsonValue.string("aarch64-apple-darwin"),
        "executable": executable("bindgen"),
        "arguments": JsonValue.array([JsonValue.object({"output": JsonValue.string("bindings")})]),
        "environment": JsonValue.array([]),
        "inputs": JsonValue.array([source_artifact("header", "include/helper.h")]),
        "outputs": JsonValue.array([
            JsonValue.object({
                "name": JsonValue.string("bindings"),
                "kind": JsonValue.string("file"),
                "path": JsonValue.string("bindings.rs"),
            }),
        ]),
    })


def fact_with_producers(link: list[JsonValue], tool: list[JsonValue]) -> JsonValue:
    mut fact = fact_with("release", [])
    fact.set("link", JsonValue.array(link)).unwrap()
    fact.set("tool", JsonValue.array(tool)).unwrap()
    return fact


def producer_refusal(fact: JsonValue) -> str:
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    add_fact(root, fact)
    return refusal(root)


def test_declared_publisher_work_is_admitted_and_rendered_as_its_own_sub_tables() -> None:
    """A `link` and a `tool` record round-trip into the manifest the compiler parses, sub-tables after the record."""
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    add_fact(root, fact_with_producers([link_record()], [tool_record()]))
    assert_eq(refusal(root), "")
    state = replay(load_events(root).unwrap(), root).unwrap()
    manifest = render_projections(state).unwrap()["crates-io/libm/0.2.16/loaf.toml"]
    assert_true(manifest.contains("\ncfg = []\n\n[[rust.facts.link]]\nname = \"helper\"\n"))
    assert_true(manifest.contains("\nexecutable = { digest = \"" + sha("cc") + "\", name = \"cc\", owner = \"" + sha("owner") + "\", path = \"bin/cc\" }\n"))
    assert_true(manifest.contains("\nobjects = [{ arguments = [{ literal = \"-O2\" }, { input = \"helper_c\" }, { literal = \"-o\" }, { output = \"helper.o\" }], language = \"c\", name = \"helper.o\" }]\n"))
    assert_true(manifest.contains("\nsources = [{ digest = \"" + sha("c/helper.c") + "\", kind = \"file\", name = \"helper_c\", path = \"c/helper.c\" }]\n"))
    assert_true(manifest.contains("\nlibrary = { kind = \"static\", name = \"sys_helper\" }\n"))
    assert_true(manifest.contains("\n[[rust.facts.tool]]\nname = \"bindgen\"\n"))
    assert_true(manifest.contains("\noutputs = [{ kind = \"file\", name = \"bindings\", path = \"bindings.rs\" }]\n"))
    assert_true(not manifest.contains("environment = []"), "a stated absence renders as an omission")


def test_publisher_work_is_refused_when_it_names_what_it_does_not_declare() -> None:
    """Each refusal is one rule: a name claimed twice, a reference to nothing, an identity that is not bytes."""
    mut second = link_record()
    second.set("name", JsonValue.string("bindgen")).unwrap()
    assert_eq(
        producer_refusal(fact_with_producers([second], [tool_record()])),
        "events/000002-fact-crates-io-libm-0.2.16.json: publisher work name `bindgen` is declared twice",
    )
    mut dangling = tool_record()
    dangling.set("arguments", JsonValue.array([JsonValue.object({"input": JsonValue.string("absent")})])).unwrap()
    assert_eq(
        producer_refusal(fact_with_producers([], [dangling])),
        "events/000002-fact-crates-io-libm-0.2.16.json: tool `bindgen`: argument references undeclared input `absent`",
    )
    mut unbound = tool_record()
    unbound.set("executable", JsonValue.object({
        "name": JsonValue.string("bindgen"),
        "owner": JsonValue.string("bindgen-0.69"),
        "path": JsonValue.string("bin/bindgen"),
        "digest": JsonValue.string(sha("bindgen")),
    })).unwrap()
    assert_eq(
        producer_refusal(fact_with_producers([], [unbound])),
        "events/000002-fact-crates-io-libm-0.2.16.json: tool `bindgen`: executable owner must be a `sha256:` identity",
    )


def test_a_product_digest_belongs_to_the_asset_and_a_source_must_leave_no_gap() -> None:
    """The work/asset boundary and the closure rule, the two ways a record could quietly declare less than the work."""
    mut digested = tool_record()
    digested.set("outputs", JsonValue.array([JsonValue.object({
        "name": JsonValue.string("bindings"),
        "kind": JsonValue.string("file"),
        "path": JsonValue.string("bindings.rs"),
        "digest": JsonValue.string(sha("bindings.rs")),
    })])).unwrap()
    actual_a = producer_refusal(fact_with_producers([], [digested]))
    assert_eq(
        actual_a,
        "events/000002-fact-crates-io-libm-0.2.16.json: tool `bindgen`: outputs has unknown keys [digest]; a product digest belongs to the asset",
    )
    mut sourceless = link_record()
    sourceless.set("sources", JsonValue.array([])).unwrap()
    sourceless.set("objects", JsonValue.array([])).unwrap()
    assert_eq(
        producer_refusal(fact_with_producers([sourceless], [])),
        "events/000002-fact-crates-io-libm-0.2.16.json: link `helper`: sources must declare the complete, non-empty source closure",
    )
    mut escaping = link_record()
    escaping.set("sources", JsonValue.array([source_artifact("helper_c", "../../etc/passwd")])).unwrap()
    assert_eq(
        producer_refusal(fact_with_producers([escaping], [])),
        "events/000002-fact-crates-io-libm-0.2.16.json: link `helper`: sources `helper_c` path `../../etc/passwd` must be a plain owner-relative path",
    )


def test_immutability_covers_every_fact_key_the_vocabulary_gains() -> None:
    """
    The comparison reads the record's own keys, so a key admitted later is immutable from its first day.

    Simulated here by comparing two records that differ only outside `cfg` and `out`: the vocabulary refuses such a
    key today, so the check is on the comparison itself.
    """
    left = parse("{\"toolchain\": \"t\", \"target\": \"x\", \"profile\": \"release\", \"features\": [], \"cfg\": [], \"link\": [\"static=z\"]}").unwrap()
    right = parse("{\"toolchain\": \"t\", \"target\": \"x\", \"profile\": \"release\", \"features\": [], \"cfg\": [], \"link\": [\"static=q\"]}").unwrap()
    assert_true(fact_comparable(left).unwrap() != fact_comparable(right).unwrap())
    absent = parse("{\"toolchain\": \"t\", \"target\": \"x\", \"profile\": \"release\", \"features\": [], \"cfg\": []}").unwrap()
    empty = parse("{\"toolchain\": \"t\", \"target\": \"x\", \"profile\": \"release\", \"features\": [], \"cfg\": [], \"link\": [], \"tool\": {}}").unwrap()
    assert_eq(fact_comparable(absent).unwrap(), fact_comparable(empty).unwrap())
    other_receipt = parse("{\"toolchain\": \"t\", \"target\": \"x\", \"profile\": \"release\", \"features\": [], \"cfg\": [], \"harvested-from\": \"sha256:x\"}").unwrap()
    assert_eq(fact_comparable(absent).unwrap(), fact_comparable(other_receipt).unwrap())


def test_a_fact_speaks_only_the_record_vocabulary() -> None:
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    mut fact = fact_with("release", [])
    fact.set("env", JsonValue.object({})).unwrap()
    add_fact(root, fact)
    assert_eq(refusal(root), "events/000002-fact-crates-io-libm-0.2.16.json: unknown fact keys [env]; script-emitted environment has no key here")


def test_cfg_and_features_are_sorted_and_unique() -> None:
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    add_fact(root, fact_with("release", ["optimizations_enabled", "arch_enabled"]))
    assert_eq(refusal(root), "events/000002-fact-crates-io-libm-0.2.16.json: cfg must be a sorted, unique list; an empty list is a stated fact")


def test_the_profile_is_release_or_debug() -> None:
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    add_fact(root, fact_with("bench", []))
    assert_eq(refusal(root), "events/000002-fact-crates-io-libm-0.2.16.json: profile must be one of release, debug")


def test_a_committed_generated_input_must_exist_and_match_its_digest() -> None:
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    mut fact = fact_with("release", [])
    fact.set("out", JsonValue.array([JsonValue.object({
        "name": JsonValue.string("private.rs"),
        "path": JsonValue.string("out/private.rs"),
        "digest": JsonValue.string(digest_text("pub const X: u8 = 1;\n")),
    })])).unwrap()
    add_fact(root, fact)
    assert_eq(refusal(root), "events/000002-fact-crates-io-libm-0.2.16.json: out `private.rs` names a missing committed file out/private.rs")
    write_text(root / "crates-io" / "libm" / "0.2.16" / "out" / "private.rs", "pub const X: u8 = 2;\n", "out").unwrap()
    assert_eq(refusal(root), "events/000002-fact-crates-io-libm-0.2.16.json: out `private.rs` digest does not match the committed bytes")
    write_text(root / "crates-io" / "libm" / "0.2.16" / "out" / "private.rs", "pub const X: u8 = 1;\n", "out").unwrap()
    assert_eq(refusal(root), "")


def test_a_generated_input_path_stays_under_the_record() -> None:
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    mut fact = fact_with("release", [])
    fact.set("out", JsonValue.array([JsonValue.object({
        "name": JsonValue.string("escape"),
        "path": JsonValue.string("../../../etc/passwd"),
        "digest": JsonValue.string(digest_text("")),
    })])).unwrap()
    add_fact(root, fact)
    assert_eq(refusal(root), "events/000002-fact-crates-io-libm-0.2.16.json: out `escape` must be a plain relative path")


def test_a_fact_is_immutable_and_its_repetition_is_a_no_op() -> None:
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    add_fact(root, fact_with("release", ["arch_enabled"]))
    add_fact(root, fact_with("release", ["arch_enabled"]))
    assert_eq(refusal(root), "")
    add_fact(root, fact_with("release", []))
    assert_eq(refusal(root), "events/000004-fact-crates-io-libm-0.2.16.json: binding (" + toolchain() + ", " + target() + ", release, [arch, default]) already has a different record; a fact is immutable")


def attest_release(root: Path, asset: str) -> None:
    mut payload: Dict[str, JsonValue] = {}
    payload["binding"] = JsonValue.object(binding("release"))
    payload["attestation"] = JsonValue.object({
        "asset": JsonValue.string(asset),
        "unit_identity": JsonValue.string(digest_text("unit")),
        "reference": JsonValue.string("attestations/1"),
    })
    append_event(root, "attest", "libm", "0.2.16", "tests", payload).unwrap()


def test_an_attestation_names_a_bound_fact_with_sha256_identities() -> None:
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    attest_release(root, digest_text("asset"))
    assert_eq(refusal(root), "events/000002-attest-crates-io-libm-0.2.16.json: attestation names a binding with no fact record")


def test_an_attestation_turns_the_binding_attested() -> None:
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    add_fact(root, fact_with("release", []))
    attest_release(root, "not-a-digest")
    assert_eq(refusal(root), "events/000003-attest-crates-io-libm-0.2.16.json: attestation asset and unit identity must be `sha256:` identities")
    directory_two = scratch()
    root_two = directory_two.path()
    publish_libm(root_two)
    add_fact(root_two, fact_with("release", []))
    attest_release(root_two, digest_text("asset"))
    state = replay(load_events(root_two).unwrap(), root_two).unwrap()
    record = state[record_key("libm", "0.2.16")]
    assert_eq(record.sorted_facts()[0].status, "attested")
    assert_eq(len(record.sorted_facts()[0].attestations), 1)


def test_an_asset_names_a_known_builder() -> None:
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    add_fact(root, fact_with("release", []))
    mut payload: Dict[str, JsonValue] = {}
    payload["binding"] = JsonValue.object(binding("release"))
    payload["asset"] = JsonValue.object({
        "archive": JsonValue.string(digest_text("archive")),
        "unit_identity": JsonValue.string(digest_text("unit")),
        "entry": JsonValue.string(digest_text("entry")),
        "payload": JsonValue.string(digest_text("payload")),
        "builder": JsonValue.string("someone"),
        "attestation": JsonValue.string("attestations/1"),
    })
    append_event(root, "asset", "libm", "0.2.16", "tests", payload).unwrap()
    assert_eq(refusal(root), "events/000003-asset-crates-io-libm-0.2.16.json: asset builder must be publisher, registry or local")


# ---------------------------------------------------------------- projections ------------------------------------


def test_projections_are_rendered_from_the_fold_and_compared_byte_for_byte() -> None:
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    add_fact(root, fact_with("release", ["arch_enabled", "optimizations_enabled"]))
    add_fact(root, fact_with("debug", ["arch_enabled"]))
    state = replay(load_events(root).unwrap(), root).unwrap()
    wanted = render_projections(state).unwrap()
    assert_eq(len(stale_projections(committed_projections(root).unwrap(), wanted)), 2)
    write_projections(root, committed_projections(root).unwrap(), wanted).unwrap()
    assert_eq(len(stale_projections(committed_projections(root).unwrap(), wanted)), 0)
    manifest = wanted["crates-io/libm/0.2.16/loaf.toml"]
    assert_true(manifest.startswith("# A note.\n#\n# A second paragraph.\n#\n# Projection of the incan.pub event log"))
    assert_true(manifest.contains("\n[project]\nname = \"libm\"\nversion = \"0.2.16\"\n"))
    assert_true(manifest.contains("\n[source]\nregistry = \"https://github.com/rust-lang/crates.io-index\"\nchecksum = \"" + libm_checksum() + "\"\n"))
    assert_true(manifest.contains("\n[[rust.facts]]\ntoolchain = \"" + toolchain() + "\"\ntarget = \"" + target() + "\"\nprofile = \"debug\"\nfeatures = [\"arch\", \"default\"]\ncfg = [\"arch_enabled\"]\n\n[[rust.facts]]"))
    assert_true(manifest.endswith("profile = \"release\"\nfeatures = [\"arch\", \"default\"]\ncfg = [\"arch_enabled\", \"optimizations_enabled\"]\n"))
    index = wanted["index/crates-io/libm"]
    assert_eq(index, "{\"adopter\":\"tests\",\"advisories\":0,\"assets\":0,\"cksum\":\"" + libm_checksum() + "\",\"facts\":[{\"features\":[\"arch\",\"default\"],\"profile\":\"debug\",\"status\":\"harvested\",\"target\":\"" + target() + "\",\"toolchain\":\"" + toolchain() + "\"},{\"features\":[\"arch\",\"default\"],\"profile\":\"release\",\"status\":\"harvested\",\"target\":\"" + target() + "\",\"toolchain\":\"" + toolchain() + "\"}],\"manifest\":\"crates-io/libm/0.2.16/loaf.toml\",\"name\":\"crates-io/libm\",\"source\":\"crates-io\",\"vers\":\"0.2.16\",\"yanked\":false}\n")


def test_a_yank_shows_on_the_index_line_and_a_stale_projection_is_named() -> None:
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    state = replay(load_events(root).unwrap(), root).unwrap()
    write_projections(root, committed_projections(root).unwrap(), render_projections(state).unwrap()).unwrap()
    append_event(root, "yank", "libm", "0.2.16", "tests", {}).unwrap()
    yanked = replay(load_events(root).unwrap(), root).unwrap()
    wanted = render_projections(yanked).unwrap()
    assert_true(wanted["index/crates-io/libm"].contains("\"yanked\":true"))
    assert_eq(stale_projections(committed_projections(root).unwrap(), wanted), ["index/crates-io/libm"])


# ---------------------------------------------------------------- proposals --------------------------------------


def test_a_hazardous_harvest_is_named_in_its_evidence_and_refused_by_the_tool() -> None:
    """`add-fact` refuses `evidence.hazards`; the library-level rule is that such a fact never reaches the log."""
    proposal = parse("{\"evidence\": {\"method\": \"compatibility publisher observation\", \"hazards\": [\"RUSTC_BOOTSTRAP\"]}}").unwrap()
    match string_list_member(proposal.get("evidence").unwrap(), "hazards"):
        Some(names) => assert_eq(names, ["RUSTC_BOOTSTRAP"])
        None => assert_true(false, "hazards is a list of names")
    clean = parse("{\"evidence\": {\"hazards\": []}}").unwrap()
    match string_list_member(clean.get("evidence").unwrap(), "hazards"):
        Some(names) => assert_eq(len(names), 0)
        None => assert_true(false, "an empty hazards list is still a list")


def test_an_absent_out_and_an_empty_out_are_the_same_stated_absence() -> None:
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    add_fact(root, fact_with("release", ["arch_enabled"]))
    mut with_empty_out = fact_with("release", ["arch_enabled"])
    with_empty_out.set("out", JsonValue.array([])).unwrap()
    add_fact(root, with_empty_out)
    assert_eq(refusal(root), "")
    state = replay(load_events(root).unwrap(), root).unwrap()
    assert_eq(len(state[record_key("libm", "0.2.16")].facts), 1)


def test_an_advisory_is_rendered_on_the_record_and_counted_on_the_index_line() -> None:
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    mut payload: Dict[str, JsonValue] = {}
    payload["advisory"] = JsonValue.object({"text": JsonValue.string("The release binding was typed, not observed.\nSee the fact events.")})
    append_event(root, "advisory", "libm", "0.2.16", "tests", payload).unwrap()
    state = replay(load_events(root).unwrap(), root).unwrap()
    wanted = render_projections(state).unwrap()
    manifest = wanted["crates-io/libm/0.2.16/loaf.toml"]
    assert_true(manifest.contains("# A second paragraph.\n#\n# Advisory: The release binding was typed, not observed.\n# Advisory: See the fact events.\n#\n# Projection"))
    assert_true(wanted["index/crates-io/libm"].contains("\"advisories\":1"))
    mut empty: Dict[str, JsonValue] = {}
    empty["advisory"] = JsonValue.object({"text": JsonValue.string("  ")})
    append_event(root, "advisory", "libm", "0.2.16", "tests", empty).unwrap()
    assert_eq(refusal(root), "events/000003-advisory-crates-io-libm-0.2.16.json: an advisory carries a non-empty `text`")


# ---------------------------------------------------------------- drops -----------------------------------------


def test_a_drop_is_read_as_its_proposals_and_the_refusals_beside_them() -> None:
    directory = scratch()
    drop = directory.path()
    # The third directory carries a suffix, as a harvest adds when one package version has two bindings in a
    # closure: the subject comes from the proposal, so the contradiction is caught by content, not by file name.
    for subject in ["alpha-1.0.0-release", "alpha-1.0.0-debug", "gamma-3.0.0-release-9f2a"]:
        name = subject.split("-")[0]
        write_text(
            drop / subject / "proposal.json",
            "{\"project\": {\"name\": \"" + name + "\", \"version\": \"" + subject.split("-")[1] + "\"}, \"rust\": {\"facts\": [{\"profile\": \"" + subject.split("-")[2] + "\"}]}}\n",
            "proposal",
        ).unwrap()
    write_text(drop / "refusals-release.json", "[{\"package\": \"gamma\", \"version\": \"3.0.0\", \"reason\": \"linked-libraries\"}]\n", "refusals").unwrap()
    write_text(drop / "refusals-debug.json", "[]\n", "refusals").unwrap()
    proposals = drop_proposals(drop).unwrap()
    assert_eq(proposals, ["alpha-1.0.0-debug", "alpha-1.0.0-release", "gamma-3.0.0-release-9f2a"])
    refusals = drop_refusals(drop).unwrap()
    assert_eq(refusals, ["gamma-3.0.0-release"])
    subjects = proposal_subjects(drop, proposals).unwrap()
    assert_eq(subjects, ["alpha-1.0.0-debug", "alpha-1.0.0-release", "gamma-3.0.0-release"])
    assert_eq(drop_contradictions(subjects, refusals), ["gamma-3.0.0-release"])
    assert_eq(len(drop_contradictions(["alpha-1.0.0-release"], refusals)), 0)


def test_a_generated_file_has_exactly_one_producer() -> None:
    """`out.name` and a tool output's path are one namespace: committed because observed, or produced by a tool."""
    mut committed = fact_with("release", [])
    committed.set("out", JsonValue.array([JsonValue.object({
        "name": JsonValue.string("bindings.rs"),
        "path": JsonValue.string("out/bindings.rs"),
        "digest": JsonValue.string(digest_text("generated")),
    })])).unwrap()
    mut producing = tool_record()
    producing.set("outputs", JsonValue.array([JsonValue.object({
        "name": JsonValue.string("bindings"),
        "kind": JsonValue.string("file"),
        "path": JsonValue.string("bindings.rs"),
    })])).unwrap()
    committed.set("tool", JsonValue.array([producing])).unwrap()
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    write_text(root / "crates-io" / "libm" / "0.2.16" / "out" / "bindings.rs", "generated", "out").unwrap()
    add_fact(root, committed)
    assert_eq(
        refusal(root),
        "events/000002-fact-crates-io-libm-0.2.16.json: generated file `bindings.rs` is declared by tool `bindgen` and committed as out `bindings.rs`",
    )


def test_committed_bytes_no_record_names_are_named_by_check() -> None:
    """A file staged for a proposal that then refused is invisible to the projection comparison, so check names it."""
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    state = replay(load_events(root).unwrap(), root).unwrap()
    assert_eq(len(unclaimed_generated_inputs(root, state).unwrap()), 0)
    write_text(root / "crates-io" / "libm" / "0.2.16" / "out" / "orphan.rs", "staged and never admitted", "out").unwrap()
    assert_eq(unclaimed_generated_inputs(root, state).unwrap(), ["crates-io/libm/0.2.16/out/orphan.rs"])


def test_a_committed_generated_input_may_be_any_bytes() -> None:
    """A build script writes what it writes: a protobuf descriptor is not text, and naming it must not read it."""
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    state = replay(load_events(root).unwrap(), root).unwrap()
    binary = root / "crates-io" / "libm" / "0.2.16" / "out" / "proto_descriptor.bin"
    binary.parent().mkdir(parents=true, exist_ok=true).unwrap()
    binary.write_bytes(b"\x00\x01\x80\xff").unwrap()
    assert_eq(unclaimed_generated_inputs(root, state).unwrap(), ["crates-io/libm/0.2.16/out/proto_descriptor.bin"])


def test_every_object_compiles_a_source_and_every_source_is_compiled() -> None:
    """The object closure is what makes a link record checkable: one compile per file, nothing unaccounted for."""
    mut nameless = link_record()
    nameless.set("objects", JsonValue.array([JsonValue.object({
        "name": JsonValue.string("helper.o"),
        "language": JsonValue.string("c"),
        "arguments": JsonValue.array([JsonValue.object({"input": JsonValue.string("helper_c")})]),
    })])).unwrap()
    assert_eq(
        producer_refusal(fact_with_producers([nameless], [])),
        "events/000002-fact-crates-io-libm-0.2.16.json: link `helper`: object `helper.o` argv names its own object file exactly once and no other output",
    )
    mut borrowed = link_record()
    borrowed.set("objects", JsonValue.array([
        object_record("helper.o", "helper_c"),
        JsonValue.object({
            "name": JsonValue.string("other.o"),
            "language": JsonValue.string("c"),
            "arguments": JsonValue.array([
                JsonValue.object({"input": JsonValue.string("helper_c")}),
                JsonValue.object({"output": JsonValue.string("helper.o")}),
            ]),
        }),
    ])).unwrap()
    assert_eq(
        producer_refusal(fact_with_producers([borrowed], [])),
        "events/000002-fact-crates-io-libm-0.2.16.json: link `helper`: object `other.o`: argument references undeclared output `helper.o`",
    )
    mut unread = link_record()
    unread.set("sources", JsonValue.array([
        source_artifact("helper_c", "c/helper.c"),
        source_artifact("spare_c", "c/spare.c"),
    ])).unwrap()
    assert_eq(
        producer_refusal(fact_with_producers([unread], [])),
        "events/000002-fact-crates-io-libm-0.2.16.json: link `helper`: source `spare_c` is named by no object's arguments or reads; sources is the closure, not a bag",
    )
    mut read = link_record()
    read.set("sources", JsonValue.array([
        source_artifact("helper_c", "c/helper.c"),
        source_artifact("helper_h", "c/helper.h"),
    ])).unwrap()
    mut reading = object_record("helper.o", "helper_c")
    reading.set("reads", JsonValue.array([JsonValue.string("helper_h")])).unwrap()
    read.set("objects", JsonValue.array([reading])).unwrap()
    assert_eq(producer_refusal(fact_with_producers([read], [])), "")
    mut misread = object_record("helper.o", "helper_c")
    misread.set("reads", JsonValue.array([JsonValue.string("absent_h")])).unwrap()
    read.set("objects", JsonValue.array([misread])).unwrap()
    assert_eq(
        producer_refusal(fact_with_producers([read], [])),
        "events/000002-fact-crates-io-libm-0.2.16.json: link `helper`: object `helper.o` reads `absent_h`, which is not a declared source",
    )
    mut collided = link_record()
    collided.set("objects", JsonValue.array([object_record("helper_c", "helper_c")])).unwrap()
    assert_eq(
        producer_refusal(fact_with_producers([collided], [])),
        "events/000002-fact-crates-io-libm-0.2.16.json: link `helper`: logical name `helper_c` is claimed as both a source and an object",
    )


def test_a_crate_may_pass_its_own_root_as_an_include_tree() -> None:
    """A crate that keeps `config.h` beside its sources passes itself as `-I.`; only a tree may name the owner root."""
    mut whole_crate = link_record()
    whole_crate.set("sources", JsonValue.array([JsonValue.object({
        "name": JsonValue.string("crate_root"),
        "kind": JsonValue.string("tree"),
        "path": JsonValue.string("."),
        "digest": JsonValue.string(sha("root")),
        "members": JsonValue.array([
            JsonValue.object({"path": JsonValue.string("config.h"), "digest": JsonValue.string(sha("config.h"))}),
            JsonValue.object({"path": JsonValue.string("src/lzma.c"), "digest": JsonValue.string(sha("src/lzma.c"))}),
        ]),
    })])).unwrap()
    whole_crate.set("objects", JsonValue.array([object_record("lzma.o", "crate_root")])).unwrap()
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    add_fact(root, fact_with_producers([whole_crate], []))
    assert_eq(refusal(root), "")
    mut as_a_file = link_record()
    as_a_file.set("sources", JsonValue.array([source_artifact("crate_root", ".")])).unwrap()
    as_a_file.set("objects", JsonValue.array([object_record("lzma.o", "crate_root")])).unwrap()
    assert_eq(
        producer_refusal(fact_with_producers([as_a_file], [])),
        "events/000002-fact-crates-io-libm-0.2.16.json: link `helper`: sources `crate_root` path `.` must be a plain owner-relative path",
    )


def test_an_argument_may_point_into_the_owner_the_executable_names() -> None:
    """An SDK or resource directory is owner-relative: the compile names it without knowing where the owner sits."""
    mut with_sdk = link_record()
    with_sdk.set("objects", JsonValue.array([JsonValue.object({
        "name": JsonValue.string("helper.o"),
        "language": JsonValue.string("c"),
        "arguments": JsonValue.array([
            JsonValue.object({"literal": JsonValue.string("-isysroot")}),
            JsonValue.object({"owner": JsonValue.string("SDKs/MacOSX.sdk")}),
            JsonValue.object({"input": JsonValue.string("helper_c")}),
            JsonValue.object({"literal": JsonValue.string("-o")}),
            JsonValue.object({"output": JsonValue.string("helper.o")}),
        ]),
    })])).unwrap()
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    add_fact(root, fact_with_producers([with_sdk], []))
    assert_eq(refusal(root), "")
    state = replay(load_events(root).unwrap(), root).unwrap()
    manifest = render_projections(state).unwrap()["crates-io/libm/0.2.16/loaf.toml"]
    assert_true(manifest.contains("{ owner = \"SDKs/MacOSX.sdk\" }"))
    mut absolute = link_record()
    absolute.set("objects", JsonValue.array([JsonValue.object({
        "name": JsonValue.string("helper.o"),
        "language": JsonValue.string("c"),
        "arguments": JsonValue.array([
            JsonValue.object({"owner": JsonValue.string("/Library/Developer/CommandLineTools")}),
            JsonValue.object({"input": JsonValue.string("helper_c")}),
            JsonValue.object({"output": JsonValue.string("helper.o")}),
        ]),
    })])).unwrap()
    assert_eq(
        producer_refusal(fact_with_producers([absolute], [])),
        "events/000002-fact-crates-io-libm-0.2.16.json: link `helper`: object `helper.o`: owner argument `/Library/Developer/CommandLineTools` must be a plain owner-relative path",
    )


# ---------------------------------------------------------------- incremental fold ------------------------------


def test_folding_a_prefix_then_the_rest_equals_folding_the_whole_log() -> None:
    """
    A drop folds the log once and then only what each proposal appends, so the two must agree at every split.

    The log mixes a publish, facts, an attestation, an advisory and a yank, so every rule the fold applies is
    exercised on both sides of each split point.
    """
    directory = scratch()
    root = directory.path()
    publish_libm(root)
    add_fact(root, fact_with("release", ["arch_enabled", "optimizations_enabled"]))
    add_fact(root, fact_with("debug", ["arch_enabled"]))
    attest_release(root, digest_text("asset"))
    mut advisory: Dict[str, JsonValue] = {}
    advisory["advisory"] = JsonValue.object({"text": JsonValue.string("A note for consumers.")})
    append_event(root, "advisory", "libm", "0.2.16", "tests", advisory).unwrap()
    append_event(root, "yank", "libm", "0.2.16", "tests", {}).unwrap()
    whole = render_projections(replay(load_events(root).unwrap(), root).unwrap()).unwrap()
    for split in range(7):
        prefix = load_events(root).unwrap()[0:split]
        folded = replay_onto(replay(prefix, root).unwrap(), load_events_after(root, split).unwrap(), root).unwrap()
        assert_eq(render_projections(folded).unwrap(), whole)

