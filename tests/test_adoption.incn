"""
Adoption: the archive format, version requirements, target predicates, the translation rules and admission.

Each translation rule of RFC 125 "Adoption from crates.io" is exercised on one synthetic package whose index line
carries every case: a rename, a key declared once per target, a bare triple, dropped development and build
dependencies, an implicit optional feature, a weak member and a member that must also enable a feature.
"""

from std.compression import gzip
from std.fs import Path
from std.json import JsonValue, parse
from std.tempfile import TemporaryDirectory
from std.testing import assert_eq, assert_is_err, assert_true

from admission import check_recorded_adoption, replay
from adoption import (
    ADOPTION_VERSION,
    Adoption,
    Dependency,
    about_from_json,
    about_of_files,
    activations,
    adoption_from_payload,
    adoption_payload,
    build_activations,
    description_json,
    loaf_files,
    loaf_name,
    render_adopted_manifest,
    revision_keeps_sources,
    required_dependencies,
    shown,
    source_archive,
    translate,
    unpack_crate,
)
from canonical import canonical, digest_bytes, digest_text
from events import Event, append_event, load_events, string_member
from policy import is_reserved_scope, supported_toolchains
from projection import render_projections
from registry import first_recorded_form, is_toolchain_identity
from semver import compare, parse_requirement, parse_version, satisfies
from tar import TarEntry, read_archive, write_archive
from target import normalize_target


def error_of[T](result: Result[T, str]) -> str:
    """The refusal a result carries, or the empty string when it succeeded."""
    match result:
        Ok(_) => return ""
        Err(message) => return message


def repeat(text: str, count: int) -> str:
    mut out = ""
    for _ in range(count):
        out = out + text
    return out


def sample_entries() -> list[TarEntry]:
    return [
        TarEntry(path="src/lib.rs", executable=false, data=b"pub fn x() {}\n"),
        TarEntry(path="build.sh", executable=true, data=b"#!/bin/sh\n"),
        TarEntry(path=repeat("a", 60) + "/" + repeat("b", 80) + "/file.rs", executable=false, data=b"split\n"),
        TarEntry(path=repeat("c", 120) + "/" + repeat("d", 120) + ".rs", executable=false, data=b"pax\n"),
    ]


def test_an_archive_reads_back_what_was_written() -> None:
    written = write_archive(sample_entries()).unwrap()
    entries = read_archive(written).unwrap()
    assert_eq(len(entries), 4)
    mut paths: list[str] = []
    for entry in entries:
        paths.append(entry.path)
        if entry.path == "build.sh":
            assert_true(entry.executable)
            assert_eq(entry.data, b"#!/bin/sh\n")
        else:
            assert_true(not entry.executable)
    assert_eq(paths, sorted(paths))
    assert_true(paths.contains(repeat("c", 120) + "/" + repeat("d", 120) + ".rs"))
    assert_true(paths.contains(repeat("a", 60) + "/" + repeat("b", 80) + "/file.rs"))
    assert_eq(len(written) % 512, 0)


def test_the_same_entries_in_any_order_give_the_same_bytes() -> None:
    entries = sample_entries()
    reversed_entries = [entries[3], entries[2], entries[1], entries[0]]
    assert_eq(write_archive(entries).unwrap(), write_archive(reversed_entries).unwrap())
    duplicate = [entries[0], entries[0]]
    assert_eq(error_of(write_archive(duplicate)), "src/lib.rs: two entries with one path")


def test_a_crate_unpacks_under_its_own_root_only() -> None:
    packed = gzip.compress(write_archive([
        TarEntry(path="demo-1.0.0/Cargo.toml", executable=false, data=b"[package]\n"),
        TarEntry(path="demo-1.0.0/src/lib.rs", executable=false, data=b""),
    ]).unwrap()).unwrap()
    files = unpack_crate("demo", "1.0.0", packed).unwrap()
    assert_eq(files[0].path, "Cargo.toml")
    assert_eq(files[1].path, "src/lib.rs")
    stray = gzip.compress(write_archive([TarEntry(path="other/x.rs", executable=false, data=b"")]).unwrap()).unwrap()
    assert_eq(error_of(unpack_crate("demo", "1.0.0", stray)), "demo 1.0.0: archive entry `other/x.rs` is outside `demo-1.0.0/`")


def matches(version: str, requirement: str) -> bool:
    return satisfies(parse_version(version).unwrap(), parse_requirement(requirement).unwrap())


def test_requirements_match_as_the_crates_io_ecosystem_resolves() -> None:
    assert_true(matches("1.2.3", "^1.2"))
    assert_true(matches("1.9.0", "1.2"))
    assert_true(not matches("2.0.0", "^1.2"))
    assert_true(matches("0.2.5", "^0.2.3"))
    assert_true(not matches("0.3.0", "^0.2.3"))
    assert_true(matches("0.0.3", "^0.0.3"))
    assert_true(not matches("0.0.4", "^0.0.3"))
    assert_true(matches("1.2.9", "~1.2.3"))
    assert_true(not matches("1.3.0", "~1.2.3"))
    assert_true(matches("1.0.5", "=1.0.5"))
    assert_true(not matches("1.0.6", "=1.0.5"))
    assert_true(matches("0.3.1", ">=0.2, <0.4"))
    assert_true(not matches("0.4.0", ">=0.2, <0.4"))
    assert_true(matches("7.1.0", "*"))
    assert_true(matches("1.9.0", "1.*"))
    assert_true(not matches("2.0.0", "1.*"))
    assert_true(matches("1.2.7", "1.2.*"))


def test_a_pre_release_matches_only_a_requirement_that_names_its_release() -> None:
    assert_true(matches("1.0.0-beta.3", "^1.0.0-beta.2"))
    assert_true(matches("1.0.0", "^1.0.0-beta.2"))
    assert_true(not matches("1.0.1-alpha", "^1.0.0-beta.2"))
    assert_true(not matches("1.0.0-alpha", "*"))
    assert_true(not matches("1.2.0-alpha", ">=1.0.0-alpha"))
    order = ["1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-beta", "1.0.0-beta.2", "1.0.0-beta.11", "1.0.0"]
    mut index = 1
    while index < len(order):
        assert_eq(compare(parse_version(order[index - 1]).unwrap(), parse_version(order[index]).unwrap()), -1)
        index += 1
    assert_is_err(parse_requirement("^1.x.3"))
    assert_is_err(parse_version("1.2"))


def test_targets_normalize_to_the_canonical_predicate() -> None:
    assert_eq(normalize_target("cfg(any(unix,target_os=\"wasi\"))").unwrap(), "cfg(any(unix, target_os = \"wasi\"))")
    assert_eq(normalize_target("cfg( all( not( windows ) , target_arch = \"x86\" , ) )").unwrap(), "cfg(all(not(windows), target_arch = \"x86\"))")
    assert_eq(normalize_target("cfg(any())").unwrap(), "cfg(any())")
    assert_eq(normalize_target("x86_64-pc-windows-gnu").unwrap(), "x86_64-pc-windows-gnu")
    assert_eq(error_of(normalize_target("cfg(not(a, b))")), "target `cfg(not(a, b))`: not(...) takes exactly one predicate")
    assert_eq(error_of(normalize_target("cfg(foo(bar))")), "target `cfg(foo(bar))`: `foo(...)` is not all, any or not")
    assert_is_err(normalize_target("cfg(unix"))
    assert_is_err(normalize_target("cfg(unix) extra"))


def demo_line() -> JsonValue:
    return parse("""{"name":"demo","vers":"1.0.0","cksum":"1111111111111111111111111111111111111111111111111111111111111111","deps":[
{"name":"serde","req":"^1.0","features":["derive"],"optional":true,"default_features":true,"target":null,"kind":"normal"},
{"name":"log","req":"0.4","features":[],"optional":false,"default_features":false,"target":null,"kind":"normal"},
{"name":"futures","package":"futures-util","req":"^0.3","features":[],"optional":true,"default_features":true,"target":null,"kind":"normal"},
{"name":"libc","req":"^0.2","features":[],"optional":false,"default_features":true,"target":"cfg(unix)","kind":"normal"},
{"name":"libc","req":"^0.2.100","features":["extra_traits"],"optional":false,"default_features":true,"target":"cfg(any(target_os=\\"linux\\",target_os = \\"android\\"))","kind":"normal"},
{"name":"winapi","req":"^0.3","features":[],"optional":false,"default_features":true,"target":"x86_64-pc-windows-gnu","kind":"normal"},
{"name":"cc","req":"^1","features":[],"optional":true,"default_features":true,"target":null,"kind":"build"},
{"name":"proptest","req":"^1","features":[],"optional":false,"default_features":true,"target":null,"kind":"dev"}
],
"features":{"default":["std"],"std":["log/std","serde?/std"],"derive":["serde/derive"],"parallel":["cc/parallel"]},
"features2":{"async":["dep:futures"]},"yanked":false,"v":2}""").unwrap()


def demo_files(manifest: str) -> list[TarEntry]:
    return [
        TarEntry(path="Cargo.toml", executable=false, data=manifest.encode()),
        TarEntry(path="src/lib.rs", executable=false, data=b"pub fn x() {}\n"),
    ]


def demo_manifest() -> str:
    return "[package]\nedition = \"2021\"\nname = \"demo\"\nversion = \"1.0.0\"\n\n[lib]\nname = \"demo\"\npath = \"src/lib.rs\"\n"


def test_translation_keeps_normal_dependencies_one_per_declaration() -> None:
    adoption = translate(demo_line(), demo_files(demo_manifest())).unwrap()
    mut keys: list[str] = []
    for dependency in adoption.dependencies:
        keys.append(dependency.key)
        if dependency.key == "futures":
            assert_eq(dependency.package, "futures-util")
        if dependency.key == "winapi":
            assert_eq(dependency.target, Some("x86_64-pc-windows-gnu"))
    assert_eq(keys, ["futures", "libc", "libc", "log", "serde", "winapi"])
    mut targets: list[str] = []
    for dependency in adoption.dependencies:
        if dependency.key == "libc":
            targets.append(dependency.target.unwrap())
    assert_true(targets.contains("cfg(unix)"))
    assert_true(targets.contains("cfg(any(target_os = \"linux\", target_os = \"android\"))"))
    assert_eq(adoption.checksum, "sha256:1111111111111111111111111111111111111111111111111111111111111111")
    assert_eq(adoption.edition, "2021")
    assert_eq(adoption.rust_type, "lib")


def test_translation_rewrites_features_for_the_loaf_grammar() -> None:
    features = translate(demo_line(), demo_files(demo_manifest())).unwrap().features
    assert_eq(features["default"], ["std"])
    assert_eq(features["std"], ["log/std", "serde?/std"])
    assert_eq(features["derive"], ["dep:serde", "serde/derive"])
    assert_eq(features["serde"], ["dep:serde"])
    assert_eq(features["async"], ["dep:futures"])
    assert_true("futures" not in features)
    assert_eq(features["parallel"], [])
    assert_eq(features["cc"], [])


def test_dep_on_a_required_dependency_that_is_also_an_optional_build_dependency_is_dropped() -> None:
    # wasmtime 36: `macros` is a required normal dependency and an optional build dependency; `dep:macros` can only
    # switch on the build dependency, which the Loaf leaves out.
    line = parse("""{"name":"d","vers":"1.0.0","cksum":"3333333333333333333333333333333333333333333333333333333333333333","deps":[
{"name":"macros","req":"=1.0.0","features":[],"optional":false,"default_features":true,"target":null,"kind":"normal"},
{"name":"macros","req":"=1.0.0","features":[],"optional":true,"default_features":true,"target":null,"kind":"build"},
{"name":"slab","req":"1","features":[],"optional":true,"default_features":true,"target":null,"kind":"normal"}],
"features":{"runtime":["dep:slab","dep:macros"]}}""").unwrap()
    adoption = translate(line, demo_files("[package]\nname = \"d\"\nversion = \"1.0.0\"\n")).unwrap()
    assert_eq(adoption.features["runtime"], ["dep:slab"])


def test_a_proc_macro_and_its_default_name_come_from_the_manifest() -> None:
    line = parse("""{"name":"demo-macros","vers":"0.1.0","cksum":"2222222222222222222222222222222222222222222222222222222222222222","deps":[],"features":{}}""").unwrap()
    manifest = "[package]\nname = \"demo-macros\"\nversion = \"0.1.0\"\n\n[lib]\nproc-macro = true\n"
    adoption = translate(line, demo_files(manifest)).unwrap()
    assert_eq(adoption.rust_name, "demo_macros")
    assert_eq(adoption.rust_type, "proc-macro")
    assert_eq(adoption.edition, "2015")
    no_library = [TarEntry(path="Cargo.toml", executable=false, data=b"[package]\nname = \"demo-macros\"\n")]
    assert_eq(error_of(translate(line, no_library)), "demo-macros 0.1.0: the package declares no library target")


def test_the_adopted_manifest_states_the_rust_facet_grammar() -> None:
    manifest = render_adopted_manifest(translate(demo_line(), demo_files(demo_manifest())).unwrap())
    assert_true(manifest.startswith("[project]\nname = \"crates-io/demo\"\nversion = \"1.0.0\"\n\n[project.features]\n"))
    assert_true(manifest.contains("\nderive = [\"dep:serde\", \"serde/derive\"]\n"))
    assert_true(manifest.contains("\n[rust]\nname = \"demo\"\ntype = \"lib\"\nedition = \"2021\"\n"))
    assert_true(not manifest.contains("[rust.source]"))
    assert_true(manifest.contains("\nfutures = { loaf = \"crates-io/futures-util\", version = \"^0.3\", optional = true }\n"))
    assert_true(manifest.contains("\nlibc = [{ loaf = \"crates-io/libc\", version = \"^0.2.100\", features = [\"extra_traits\"], target = \"cfg(any(target_os = \\\"linux\\\", target_os = \\\"android\\\"))\" }, { loaf = \"crates-io/libc\", version = \"^0.2\", target = \"cfg(unix)\" }]\n"))
    assert_true(manifest.contains("\nlog = { loaf = \"crates-io/log\", version = \"0.4\", default-features = false }\n"))
    assert_true(not manifest.contains("proptest") and not manifest.contains("crates-io/cc"))
    archive = read_archive(source_archive(manifest, demo_files(demo_manifest())).unwrap()).unwrap()
    assert_eq(archive[1].path, "loaf.toml")
    assert_eq(archive[1].data, manifest.encode())


def test_a_pin_must_hold_what_the_default_features_activate_and_nothing_beyond() -> None:
    adoption = translate(demo_line(), demo_files(demo_manifest())).unwrap()
    mut keys: list[str] = []
    for dependency in required_dependencies(adoption):
        keys.append(dependency.key)
    # `default` reaches `std`, whose `log/std` names a required dependency and whose `serde?/std` is weak, so
    # neither optional dependency is active under the defaults.
    assert_eq(keys, ["libc", "libc", "log", "winapi"])
    line = parse("""{"name":"d","vers":"1.0.0","cksum":"3333333333333333333333333333333333333333333333333333333333333333","deps":[
{"name":"a","req":"1","features":[],"optional":true,"default_features":true,"target":null,"kind":"normal"},
{"name":"b","req":"1","features":[],"optional":true,"default_features":true,"target":null,"kind":"normal"},
{"name":"c","req":"1","features":[],"optional":true,"default_features":true,"target":null,"kind":"normal"}],
"features":{"default":["extra"],"extra":["dep:a","b/x"],"later":["c"]}}""").unwrap()
    manifest = "[package]\nname = \"d\"\nversion = \"1.0.0\"\n"
    mut active: list[str] = []
    for dependency in required_dependencies(translate(line, demo_files(manifest)).unwrap()):
        active.append(dependency.key)
    assert_eq(active, ["a", "b"])


def test_a_dependent_s_features_reach_the_dependencies_they_enable() -> None:
    # `extra` activates `a` and asks `x` of `b`, which activates it; `c` is always active and opts out of its
    # defaults; `weak` asks `y` of `a` and `z` of `b` without activating either.
    line = parse("""{"name":"d","vers":"1.0.0","cksum":"3333333333333333333333333333333333333333333333333333333333333333","deps":[
{"name":"a","req":"1","features":[],"optional":true,"default_features":true,"target":null,"kind":"normal"},
{"name":"b","req":"1","features":[],"optional":true,"default_features":true,"target":null,"kind":"normal"},
{"name":"c","req":"1","features":["k"],"optional":false,"default_features":false,"target":null,"kind":"normal"}],
"features":{"default":["extra"],"extra":["dep:a","b/x","c/m"],"weak":["a?/y","b?/z"]}}""").unwrap()
    adoption = translate(line, demo_files("[package]\nname = \"d\"\nversion = \"1.0.0\"\n")).unwrap()
    mut both: list[str] = []
    for activation in activations(adoption, ["default", "weak"]):
        both.append(activation.dependency.key + ":" + ",".join(activation.features))
    assert_eq(both, ["a:default,y", "b:default,x,z", "c:k,m"])
    mut weak_only: list[str] = []
    for activation in activations(adoption, ["weak"]):
        weak_only.append(activation.dependency.key + ":" + ",".join(activation.features))
    assert_eq(weak_only, ["c:k"])


def test_a_build_script_s_dependencies_follow_the_same_features() -> None:
    # `cc` always builds the script; `built` only when `stamp` is on, through its implicit feature; `pkg` never here.
    line = parse("""{"name":"d","vers":"1.0.0","cksum":"3333333333333333333333333333333333333333333333333333333333333333","deps":[
{"name":"cc","req":"1","features":["parallel"],"optional":false,"default_features":false,"target":null,"kind":"build"},
{"name":"built","req":"0.8","features":[],"optional":true,"default_features":true,"target":null,"kind":"build"},
{"name":"pkg","req":"0.3","features":[],"optional":true,"default_features":true,"target":null,"kind":"build"},
{"name":"log","req":"0.4","features":[],"optional":false,"default_features":true,"target":null,"kind":"normal"}],
"features":{"default":["stamp"],"stamp":["built"]}}""").unwrap()
    mut reached: list[str] = []
    for activation in build_activations(line, ["default"], "d 1.0.0").unwrap():
        reached.append(activation.dependency.key + ":" + ",".join(activation.features))
    assert_eq(reached, ["built:default", "cc:parallel"])
    mut bare: list[str] = []
    for activation in build_activations(line, [], "d 1.0.0").unwrap():
        bare.append(activation.dependency.key)
    assert_eq(bare, ["cc"])


def leaf(version: str) -> Adoption:
    return Adoption(
        package="leaf",
        version=version,
        checksum=digest_text("leaf " + version),
        rust_name="leaf",
        rust_type="lib",
        edition="2021",
        build_script=Some(false),
        about=None,
        files=None,
        root="src/lib.rs",
        features={"default": []},
        dependencies=[],
    )


def top() -> Adoption:
    return Adoption(
        package="top",
        version="1.0.0",
        checksum=digest_text("top"),
        rust_name="top",
        rust_type="lib",
        edition="2021",
        build_script=Some(false),
        about=None,
        files=None,
        root="src/lib.rs",
        features={},
        dependencies=[Dependency(key="leaf", package="leaf", req="^1.2", features=[], default_features=true, optional=false, target=None)],
    )


def adopt(root: Path, adoption: Adoption) -> None:
    payload = adoption_payload(adoption, digest_text(render_adopted_manifest(adoption)), digest_text("archive " + adoption.package))
    append_event(root, "adopt", adoption.package, adoption.version, "tests", payload).unwrap()


def refusal(root: Path) -> str:
    match replay(load_events(root).unwrap(), root):
        Ok(_) => return ""
        Err(message) => return message


def test_an_adoption_needs_its_dependencies_adopted_first() -> None:
    directory = TemporaryDirectory.try_new().unwrap()
    root = directory.path()
    adopt(root, leaf("1.1.0"))
    adopt(root, top())
    assert_eq(
        refusal(root),
        "events/000002-adopt-crates-io-top-1.0.0.json: dependency `leaf` (crates-io/leaf ^1.2) has no adopted version; adoption is closed under dependencies",
    )


def test_an_adopted_version_projects_its_resolution_facts_onto_the_index_line() -> None:
    directory = TemporaryDirectory.try_new().unwrap()
    root = directory.path()
    adopt(root, leaf("1.2.0"))
    adopt(root, top())
    adopt(root, top())
    events = load_events(root).unwrap()
    state = replay(events, root).unwrap()
    files = render_projections(state, events).unwrap()
    line = parse(files["index/crates-io/top"].strip()).unwrap()
    assert_eq(canonical(line.get("rust").unwrap()).unwrap(), "{\"build-script\":false,\"edition\":\"2021\",\"name\":\"top\",\"type\":\"lib\"}")
    assert_eq(canonical(line.get("deps").unwrap()).unwrap(), "[{\"default-features\":true,\"features\":[],\"loaf\":\"crates-io/leaf\",\"name\":\"leaf\",\"optional\":false,\"req\":\"^1.2\"}]")
    assert_eq(line.get("cksum").unwrap().as_str().unwrap(), digest_text("archive top"))
    assert_eq(line.get("name").unwrap().as_str().unwrap(), "crates-io/top")
    assert_true(files["crates-io/top/1.0.0/loaf.toml"].contains("\n[rust]\nname = \"top\"\n"))
    # The catalog lists both packages and gives each a page of its adopted versions under its scoped name.
    catalog = parse(files["catalog/index.json"]).unwrap()
    assert_eq(catalog.get("schema").unwrap().as_str().unwrap(), "loaves.pub/catalog/1")
    assert_eq(len(catalog.get("packages").unwrap().as_array().unwrap()), 2)
    # It names the last event it reflects, since it cannot name the commit that holds it.
    log = catalog.get("log").unwrap()
    assert_eq(log.get("events").unwrap().as_int().unwrap(), len(events))
    last = events[len(events) - 1]
    assert_eq(log.get("last").unwrap().get("id").unwrap().as_str().unwrap(), last.body.get("id").unwrap().as_str().unwrap())
    assert_eq(log.get("last").unwrap().get("at").unwrap().as_str().unwrap(), last.at)
    page = parse(files["catalog/crates-io/top.json"]).unwrap()
    assert_eq(page.get("name").unwrap().as_str().unwrap(), "crates-io/top")
    first = page.get("versions").unwrap().as_array().unwrap()[0]
    assert_eq(first.get("version").unwrap().as_str().unwrap(), "1.0.0")
    assert_eq(canonical(first.get("rust").unwrap()).unwrap(), "{\"build-script\":false,\"edition\":\"2021\",\"name\":\"top\",\"type\":\"lib\"}")
    # A version page carries the index line's declarations and where the version came from.
    assert_eq(canonical(first.get("dependencies").unwrap()).unwrap(), canonical(line.get("deps").unwrap()).unwrap())
    assert_eq(canonical(first.get("features").unwrap()).unwrap(), canonical(line.get("features").unwrap()).unwrap())
    assert_eq(string_member(first.get("upstream").unwrap(), "checksum"), string_member(line.get("adopted").unwrap(), "checksum"))
    assert_eq(first.get("archive").unwrap().as_str().unwrap(), line.get("cksum").unwrap().as_str().unwrap())


def test_an_adoption_is_immutable_and_its_manifest_digest_is_checked() -> None:
    directory = TemporaryDirectory.try_new().unwrap()
    root = directory.path()
    adopt(root, leaf("1.2.0"))
    original = leaf("1.2.0")
    changed = Adoption(
        package=original.package,
        version=original.version,
        checksum=original.checksum,
        rust_name=original.rust_name,
        rust_type=original.rust_type,
        edition="2018",
        build_script=Some(false),
        about=None,
        files=None,
        root=original.root,
        features=original.features,
        dependencies=original.dependencies,
    )
    adopt(root, changed)
    assert_eq(refusal(root), "events/000002-adopt-crates-io-leaf-1.2.0.json: revision 1 of leaf 1.2.0 is already adopted differently; a revision is immutable, and a correction is a new revision")
    other = TemporaryDirectory.try_new().unwrap()
    other_root = other.path()
    payload = adoption_payload(leaf("1.0.0"), digest_text("not the manifest"), digest_text("archive"))
    append_event(other_root, "adopt", "leaf", "1.0.0", "tests", payload).unwrap()
    assert_eq(refusal(other_root), "events/000001-adopt-crates-io-leaf-1.0.0.json: `manifest` is not the digest of the manifest this payload renders")


def correction(revision: int, edition: str) -> Dict[str, JsonValue]:
    """The next revision of `leaf 1.2.0`, whose translation came out with another edition."""
    mut corrected = leaf("1.2.0")
    corrected.edition = edition
    mut payload = adoption_payload(
        corrected, digest_text(render_adopted_manifest(corrected)), digest_text(f"archive leaf {edition}")
    )
    payload["revision"] = JsonValue.int(revision)
    payload["supersedes"] = JsonValue.int(revision - 1)
    payload["reason"] = JsonValue.string("the edition was read wrong")
    return payload


def without(payload: Dict[str, JsonValue], key: str) -> Dict[str, JsonValue]:
    mut out: Dict[str, JsonValue] = {}
    for name in payload.keys():
        if name != key:
            out[name] = payload[name]
    return out


def test_a_superseded_revision_finds_the_generated_inputs_of_its_version() -> None:
    """Facts belong to the version: a revision never changes the package's sources, so they hold across its revisions."""
    directory = TemporaryDirectory.try_new().unwrap()
    root = directory.path()
    adopt(root, leaf("1.2.0"))
    generated = b"pub const X: u8 = 1;\n"
    (root / "crates-io" / "leaf" / "1.2.0" / "out").mkdir(parents=true, exist_ok=true).unwrap()
    (root / "crates-io" / "leaf" / "1.2.0" / "out" / "gen.rs").write_bytes(generated).unwrap()
    mut fact: Dict[str, JsonValue] = {}
    fact["fact"] = parse(
        "{\"toolchain\":\"rustc 1.98.0 (88d9e12ae 2026-08-18)\",\"target\":\"aarch64-apple-darwin\",\"profile\":\"debug\","
        + "\"features\":[],\"cfg\":[],\"out\":[{\"name\":\"gen.rs\",\"path\":\"out/gen.rs\",\"digest\":\""
        + digest_bytes(generated)
        + "\"}]}"
    ).unwrap()
    fact["evidence"] = JsonValue.object({"method": JsonValue.string("test")})
    append_event(root, "fact", "leaf", "1.2.0", "tests", fact).unwrap()
    append_event(root, "adopt", "leaf", "1.2.0", "tests", correction(2, "2018")).unwrap()
    events = load_events(root).unwrap()
    files = render_projections(replay(events, root).unwrap(), events).unwrap()
    assert_true(files["crates-io/leaf/1.2.0/loaf.toml"].contains("path = \"out/gen.rs\""))
    assert_true(files["crates-io/leaf/1.2.0/r1/loaf.toml"].contains("path = \"../out/gen.rs\""))


def corrected_refusal(payload: Dict[str, JsonValue]) -> str:
    """What admission says of `payload` as the event after `leaf 1.2.0`'s first adoption."""
    directory = TemporaryDirectory.try_new().unwrap()
    root = directory.path()
    adopt(root, leaf("1.2.0"))
    append_event(root, "adopt", "leaf", "1.2.0", "tests", payload).unwrap()
    return refusal(root)


def test_a_correction_is_the_next_revision_and_every_revision_stays_addressable() -> None:
    directory = TemporaryDirectory.try_new().unwrap()
    root = directory.path()
    adopt(root, leaf("1.2.0"))
    first = load_events(root).unwrap()[0]
    append_event(root, "adopt", "leaf", "1.2.0", "tests", correction(2, "2018")).unwrap()
    events = load_events(root).unwrap()
    assert_eq(canonical(events[0].body).unwrap(), canonical(first.body).unwrap())
    state = replay(events, root).unwrap()
    assert_eq(state["leaf\t1.2.0"].revision, 2)
    files = render_projections(state, events).unwrap()
    # The highest revision keeps the version's directory, and the one it superseded says why it is one below.
    assert_true(files["crates-io/leaf/1.2.0/loaf.toml"].contains("edition = \"2018\""))
    assert_true(files["crates-io/leaf/1.2.0/r1/loaf.toml"].contains("edition = \"2021\""))
    assert_true(files["crates-io/leaf/1.2.0/r1/loaf.toml"].contains("# Superseded by revision 2: the edition was read wrong"))
    lines = files["index/crates-io/leaf"].strip().split("\n")
    assert_eq(len(lines), 2)
    older = parse(lines[0]).unwrap()
    newer = parse(lines[1]).unwrap()
    assert_eq(string_member(older, "manifest"), "crates-io/leaf/1.2.0/r1/loaf.toml")
    assert_eq(string_member(newer, "manifest"), "crates-io/leaf/1.2.0/loaf.toml")
    assert_eq(canonical(older.get("adopted").unwrap().get("revision").unwrap()).unwrap(), "1")
    assert_eq(canonical(newer.get("adopted").unwrap().get("revision").unwrap()).unwrap(), "2")
    assert_eq(string_member(older, "cksum"), digest_text("archive leaf"))
    assert_eq(string_member(newer, "cksum"), digest_text("archive leaf 2018"))


def test_a_single_revision_changes_no_path_and_says_it_is_revision_one() -> None:
    directory = TemporaryDirectory.try_new().unwrap()
    root = directory.path()
    adopt(root, leaf("1.2.0"))
    events = load_events(root).unwrap()
    files = render_projections(replay(events, root).unwrap(), events).unwrap()
    assert_true("crates-io/leaf/1.2.0/r1/loaf.toml" not in files)
    line = parse(files["index/crates-io/leaf"].strip()).unwrap()
    assert_eq(string_member(line, "manifest"), "crates-io/leaf/1.2.0/loaf.toml")
    assert_eq(canonical(line.get("adopted").unwrap().get("revision").unwrap()).unwrap(), "1")


def test_a_revision_is_immutable_and_revisions_are_contiguous() -> None:
    assert_eq(corrected_refusal(correction(2, "2018")), "")
    skipped = correction(3, "2018")
    assert_true(corrected_refusal(skipped).contains("revision 3 follows revision 1; revisions are contiguous"))
    # The same revision again is a no-op; another one under its number is refused.
    directory = TemporaryDirectory.try_new().unwrap()
    root = directory.path()
    adopt(root, leaf("1.2.0"))
    append_event(root, "adopt", "leaf", "1.2.0", "tests", correction(2, "2018")).unwrap()
    append_event(root, "adopt", "leaf", "1.2.0", "tests", correction(2, "2018")).unwrap()
    assert_eq(refusal(root), "")
    append_event(root, "adopt", "leaf", "1.2.0", "tests", correction(2, "2015")).unwrap()
    assert_true(refusal(root).contains("a revision is immutable, and a correction is a new revision"))


def test_a_correction_names_what_it_supersedes_and_why_and_changes_the_archive() -> None:
    unnamed = without(correction(2, "2018"), "supersedes")
    assert_true(corrected_refusal(unnamed).contains("names the revision it supersedes"))
    mut unexplained = correction(2, "2018")
    unexplained["reason"] = JsonValue.string("  ")
    assert_true(corrected_refusal(unexplained).contains("says why in `reason`"))
    mut same_archive = correction(2, "2018")
    same_archive["archive"] = JsonValue.string(digest_text("archive leaf"))
    assert_true(corrected_refusal(same_archive).contains("a correction changes the archive"))
    no_first_revision = correction(2, "2018")
    directory = TemporaryDirectory.try_new().unwrap()
    append_event(directory.path(), "adopt", "leaf", "1.2.0", "tests", no_first_revision).unwrap()
    assert_true(refusal(directory.path()).contains("revision 2 of a version with no revision 1"))


def test_a_revision_keeps_the_packages_sources() -> None:
    payload = JsonValue.object({"files": JsonValue.object({"license": JsonValue.string("registry"), "readme": JsonValue.string("package")})})
    source = TarEntry(path="src/lib.rs", executable=false, data=b"pub fn x() {}\n")
    manifest = TarEntry(path="loaf.toml", executable=false, data=b"a")
    license = TarEntry(path="LICENSE", executable=false, data=b"a")
    changed_manifest = TarEntry(path="loaf.toml", executable=false, data=b"b")
    changed_license = TarEntry(path="LICENSE", executable=false, data=b"b")
    assert_eq(
        error_of(revision_keeps_sources([source, manifest, license], [source, changed_manifest, changed_license], payload, payload, "leaf")),
        "",
    )
    changed = TarEntry(path="src/lib.rs", executable=false, data=b"pub fn y() {}\n")
    assert_eq(
        error_of(revision_keeps_sources([source, manifest], [changed, manifest], payload, payload, "leaf")),
        "leaf: a revision may not change the package's `src/lib.rs`",
    )
    added = TarEntry(path="src/more.rs", executable=false, data=b"")
    assert_eq(
        error_of(revision_keeps_sources([source], [source, added], payload, payload, "leaf")),
        "leaf: a revision may not add `src/more.rs` to the package's sources",
    )
    assert_eq(
        error_of(revision_keeps_sources([source, manifest], [manifest], payload, payload, "leaf")),
        "leaf: a revision may not change the package's `src/lib.rs`",
    )


def recorded_adoption_refusal(sequence: int, adoption: Adoption, body: JsonValue) -> str:
    event = Event(
        label="events/new",
        sequence=sequence,
        schema="loaves.pub/event/1",
        kind="adopt",
        at="now",
        actor="tests",
        name="leaf",
        version="1.2.0",
        body=body,
    )
    return error_of(check_recorded_adoption(event, adoption))


def test_a_new_adoption_states_its_revision_tool_and_build_script() -> None:
    stated = leaf("1.2.0")
    payload = adoption_payload(stated, "sha256:m", "sha256:a")
    assert_eq(recorded_adoption_refusal(first_recorded_form(), stated, JsonValue.object(payload)), "")
    # An event from before the rule stands as it was recorded; after it, the same event is refused.
    empty = JsonValue.object({})
    assert_eq(recorded_adoption_refusal(first_recorded_form() - 1, stated, empty), "")
    assert_eq(recorded_adoption_refusal(first_recorded_form(), stated, empty), "events/new: a new adoption states its `revision`")
    no_tool = without(adoption_payload(stated, "sha256:m", "sha256:a"), "tool")
    assert_eq(
        recorded_adoption_refusal(first_recorded_form(), stated, JsonValue.object(no_tool)),
        "events/new: a new adoption states the adoption tool version in `tool`",
    )
    mut unstated = leaf("1.2.0")
    unstated.build_script = None
    assert_eq(
        recorded_adoption_refusal(first_recorded_form(), unstated, JsonValue.object(payload)),
        "events/new: a new adoption states `[rust] build-script`",
    )


def test_an_adopted_name_is_lowercase_and_its_provenance_keeps_the_upstream_spelling() -> None:
    assert_eq(loaf_name("Inflector"), "crates-io/inflector")
    directory = TemporaryDirectory.try_new().unwrap()
    root = directory.path()
    mut upstream = leaf("0.11.4")
    upstream.package = "Inflector"
    upstream.checksum = digest_text("Inflector")
    manifest = render_adopted_manifest(upstream)
    assert_true(manifest.contains("name = \"crates-io/inflector\""))
    payload = adoption_payload(upstream, digest_text(manifest), digest_text("archive"))
    append_event(root, "adopt", "inflector", "0.11.4", "tests", payload).unwrap()
    assert_eq(refusal(root), "")
    events = load_events(root).unwrap()
    files = render_projections(replay(events, root).unwrap(), events).unwrap()
    line = parse(files["index/crates-io/inflector"].strip()).unwrap()
    assert_eq(string_member(line, "name"), "crates-io/inflector")
    assert_eq(string_member(line.get("adopted").unwrap(), "package"), "Inflector")
    page = parse(files["catalog/crates-io/inflector.json"]).unwrap()
    assert_eq(string_member(page.get("upstream").unwrap(), "package"), "Inflector")
    # A subject with a capital letter is refused, not folded.
    other = TemporaryDirectory.try_new().unwrap()
    append_event(other.path(), "adopt", "Inflector", "0.11.4", "tests", payload).unwrap()
    assert_true(error_of(load_events(other.path())).contains("a package name has no capital letter"))


def test_the_policy_is_published_with_the_catalog() -> None:
    directory = TemporaryDirectory.try_new().unwrap()
    root = directory.path()
    adopt(root, leaf("1.2.0"))
    events = load_events(root).unwrap()
    files = render_projections(replay(events, root).unwrap(), events).unwrap()
    policy = parse(files["catalog/policy.json"]).unwrap()
    assert_eq(string_member(policy, "schema"), "loaves.pub/policy/1")
    assert_true(is_reserved_scope("crates-io"))
    assert_true(is_reserved_scope("std"))
    assert_true(not is_reserved_scope("acme"))
    assert_true(canonical(policy.get("reserved-scopes").unwrap()).unwrap().contains("\"incan\""))
    assert_true(is_toolchain_identity(supported_toolchains()[0]))


def test_the_adoption_version_moves_with_the_bytes_adoption_writes() -> None:
    """A change this test catches changes what adoption writes: change `ADOPTION_VERSION` with it, then this digest."""
    adoption = translate(demo_line(), demo_files(demo_manifest())).unwrap()
    archive = source_archive(render_adopted_manifest(adoption), loaf_files(adoption, demo_files(demo_manifest()), "loaves.pub")).unwrap()
    assert_eq(ADOPTION_VERSION, "1")
    assert_true(digest_bytes(archive) == "sha256:67a30339d437b1bb5ccb832767afaf0c16aac625a9178fe0236d79ff59cfcbdb", digest_bytes(archive))
    # An adoption recorded while the registry was named incan.pub rebuilds to the archive its digest names.
    earlier = source_archive(render_adopted_manifest(adoption), loaf_files(adoption, demo_files(demo_manifest()), "incan.pub")).unwrap()
    assert_true(digest_bytes(earlier) == "sha256:df777a1f9e6981e8be53dda7fcd163c769586d59ae50f6a50fcb5bfa7e05bd1c", digest_bytes(earlier))


def test_adoption_states_whether_the_package_declares_a_build_script() -> None:
    """RFC 119 rule 1: a declared `build` path or a root `build.rs` makes `build-script = true`; otherwise false."""
    plain = translate(demo_line(), demo_files(demo_manifest())).unwrap()
    assert_eq(plain.build_script, Some(false))
    assert_true(render_adopted_manifest(plain).contains("\nedition = \"2021\"\nbuild-script = false\n"))
    mut files = demo_files(demo_manifest())
    files.append(TarEntry(path="build.rs", executable=false, data=b"fn main() {}\n"))
    scripted = translate(demo_line(), files).unwrap()
    assert_eq(scripted.build_script, Some(true))
    assert_true(render_adopted_manifest(scripted).contains("\nbuild-script = true\n"))
    turned_off = translate(demo_line(), demo_files(demo_manifest().replace("name = \"demo\"\nversion", "build = false\nname = \"demo\"\nversion"))).unwrap()
    assert_eq(turned_off.build_script, Some(false))
    mut elsewhere = demo_files(demo_manifest().replace("name = \"demo\"\nversion", "build = \"tools/gen.rs\"\nname = \"demo\"\nversion"))
    elsewhere.append(TarEntry(path="tools/gen.rs", executable=false, data=b"fn main() {}\n"))
    assert_eq(translate(demo_line(), elsewhere).unwrap().build_script, Some(true))


def test_an_adoption_made_before_build_script_was_stated_reads_back_unstated() -> None:
    """An older payload has no `build-script`; it reads back as unstated and renders exactly as it did."""
    mut older = translate(demo_line(), demo_files(demo_manifest())).unwrap()
    older.build_script = None
    manifest = render_adopted_manifest(older)
    assert_true(not manifest.contains("build-script"))
    payload = adoption_payload(older, digest_text(manifest), digest_text("archive"))
    mut body = JsonValue.object(payload)
    body.set("subject", JsonValue.object({"name": JsonValue.string("demo"), "version": JsonValue.string("1.0.0")})).unwrap()
    assert_eq(adoption_from_payload(body, "demo 1.0.0").unwrap().build_script, None)
    stated = translate(demo_line(), demo_files(demo_manifest())).unwrap()
    stated_body = JsonValue.object(adoption_payload(stated, digest_text(render_adopted_manifest(stated)), digest_text("archive")))
    assert_eq(adoption_from_payload(stated_body, "demo 1.0.0").unwrap().build_script, Some(false))


def text_of(file: TarEntry) -> str:
    # dev.8 has no Debug lowering for `unwrap` on a `decode` result.
    match file.data.decode():
        Ok(text) => return text
        Err(_) => return ""


def test_every_loaf_carries_a_license_and_a_readme() -> None:
    """The package's own files count; adoption writes a LICENSE or README.md only where the package ships none."""
    plain = translate(demo_line(), demo_files(demo_manifest())).unwrap()
    mut written: list[str] = []
    for file in loaf_files(plain, demo_files(demo_manifest()), "loaves.pub"):
        written.append(file.path)
        if file.path == "LICENSE":
            assert_true(text_of(file).contains("loaves.pub wrote this file when it adopted the package"))
        if file.path == "README.md":
            assert_true(text_of(file).contains("loaves.pub wrote this one when it adopted the package"))
    assert_true(written.contains("LICENSE"))
    assert_true(written.contains("README.md"))
    # The name is the registry's as the adoption was recorded, so an earlier adoption's files keep theirs.
    for file in loaf_files(plain, demo_files(demo_manifest()), "incan.pub"):
        if file.path == "LICENSE":
            assert_true(text_of(file).contains("incan.pub wrote this file when it adopted the package"))
    licensed_manifest = demo_manifest().replace("name = \"demo\"\nversion", "license = \"MIT OR Apache-2.0\"\nname = \"demo\"\nversion")
    mut shipped = demo_files(licensed_manifest)
    shipped.append(TarEntry(path="LICENSE-MIT", executable=false, data=b"MIT\n"))
    shipped.append(TarEntry(path="README.md", executable=false, data=b"# demo\n"))
    licensed = translate(demo_line(), shipped).unwrap()
    assert_eq(len(loaf_files(licensed, shipped, "loaves.pub")), len(shipped))
    match licensed.about:
        Some(about) => assert_eq(about.license, "MIT OR Apache-2.0")
        None => assert_true(false, "a new adoption records what its manifest says about the package")
    only_license = translate(demo_line(), demo_files(licensed_manifest)).unwrap()
    for file in loaf_files(only_license, demo_files(licensed_manifest), "loaves.pub"):
        if file.path == "LICENSE":
            match file.data.decode():
                Ok(text) => assert_true(text.contains("declares the license `MIT OR Apache-2.0`"))
                Err(_) => assert_true(false, "a generated license is text")


def test_about_records_authors_and_rust_version_for_the_package_environment() -> None:
    manifest = demo_manifest().replace(
        "name = \"demo\"\nversion",
        "authors = [\"Ada <ada@example.org>\", \"Grace\"]\nrust-version = \"1.70\"\nname = \"demo\"\nversion",
    )
    adoption = translate(demo_line(), demo_files(manifest)).unwrap()
    match adoption.about:
        Some(about) =>
            assert_eq(about.authors, ["Ada <ada@example.org>", "Grace"])
            assert_eq(about.rust_version, "1.70")
            payload = JsonValue.object(adoption_payload(adoption, "sha256:m", "sha256:a"))
            match about_from_json(payload):
                Some(read_back) =>
                    assert_eq(read_back.authors, about.authors)
                    assert_eq(read_back.rust_version, "1.70")
                None => assert_true(false, "the payload carries about")
        None => assert_true(false, "a new adoption records what its manifest says about the package")
    # A multi-line description is recorded as Cargo hands it over, last newline included; shown trims it.
    multi = demo_manifest().replace("name = \"demo\"\nversion", "description = \"\"\"\nTwo\nlines\n\"\"\"\nname = \"demo\"\nversion")
    match translate(demo_line(), demo_files(multi)).unwrap().about:
        Some(about) =>
            assert_eq(about.description, "Two\nlines\n")
            assert_eq(shown(about).description, "Two\nlines")
        None => assert_true(false, "a new adoption records about")
    # A plain manifest says neither, and an `about` recorded before either was read reads back empty.
    plain = translate(demo_line(), demo_files(demo_manifest())).unwrap()
    match plain.about:
        Some(about) =>
            assert_eq(about.authors, [])
            assert_eq(about.rust_version, "")
        None => assert_true(false, "a new adoption records about")


def test_an_adoption_without_about_keeps_its_files_exactly() -> None:
    mut older = translate(demo_line(), demo_files(demo_manifest())).unwrap()
    older.about = None
    assert_eq(len(loaf_files(older, demo_files(demo_manifest()), "loaves.pub")), len(demo_files(demo_manifest())))


def roles_and_paths(documents: JsonValue) -> str:
    mut out: list[str] = []
    for document in documents.as_array().unwrap():
        out.append(string_member(document, "role") + ":" + string_member(document, "path"))
    return ",".join(out)


def described_files() -> list[TarEntry]:
    manifest = b"[package]\nname = \"x\"\nversion = \"1.0.0\"\nreadme = \"crates-io.md\"\nkeywords = [\"parser\", \"json\"]\ncategories = [\"encoding\"]\n"
    return [
        TarEntry(path="Cargo.toml", executable=false, data=manifest),
        TarEntry(path="README.md", executable=false, data=b"# root readme\n"),
        TarEntry(path="crates-io.md", executable=false, data=b"# declared readme\n"),
        TarEntry(path="LICENSE-MIT", executable=false, data=b"MIT\n"),
        TarEntry(path="UNLICENSE", executable=false, data=b"Unlicense\n"),
        TarEntry(path="COPYING", executable=false, data=b"dual\n"),
        TarEntry(path="CHANGELOG.md", executable=false, data=b"# 1.0.0\n"),
        TarEntry(path="release.toml", executable=false, data=b"sign-commit = true\n"),
        TarEntry(path="src/lib.rs", executable=false, data=b"pub fn x() {}\n"),
        TarEntry(path=".cargo_vcs_info.json", executable=false, data=b"{\"git\":{\"sha1\":\"abc123\"},\"path_in_vcs\":\"crates/x\"}"),
    ]


def test_a_description_names_the_declared_readme_every_license_and_the_changelog() -> None:
    files = described_files()
    about = about_of_files(files, "x 1.0.0").unwrap()
    description = description_json(files, about, {"readme": "package", "license": "package"}, "x 1.0.0").unwrap()
    # The declared README wins over README.md; release.toml is not a changelog.
    assert_eq(
        roles_and_paths(description["documents"]),
        "readme:crates-io.md,license:COPYING,license:LICENSE-MIT,license:UNLICENSE,changelog:CHANGELOG.md",
    )
    first = description["documents"].as_array().unwrap()[0]
    assert_eq(string_member(first, "format"), "markdown")
    assert_eq(string_member(first, "origin"), "package")
    assert_eq(first.get("bytes").unwrap().as_int().unwrap(), 18)
    assert_eq(canonical(description["vcs"]).unwrap(), "{\"commit\":\"abc123\",\"path\":\"crates/x\",\"system\":\"git\"}")
    assert_eq(canonical(description["taxonomy"]).unwrap(), "{\"categories\":[\"encoding\"],\"keywords\":[\"parser\",\"json\"]}")


def test_a_registry_written_license_is_a_notice_and_a_package_without_vcs_info_has_none() -> None:
    files = [
        TarEntry(path="Cargo.toml", executable=false, data=b"[package]\nname = \"y\"\nversion = \"1.0.0\"\nlicense = \"MIT\"\n"),
        TarEntry(path="LICENSE", executable=false, data=b"y 1.0.0, as published on crates.io, carries no license file.\n"),
        TarEntry(path="README.md", executable=false, data=b"# y 1.0.0\n"),
    ]
    about = about_of_files(files, "y 1.0.0").unwrap()
    description = description_json(files, about, {"readme": "registry", "license": "registry"}, "y 1.0.0").unwrap()
    assert_eq(roles_and_paths(description["documents"]), "readme:README.md,license-notice:LICENSE")
    for document in description["documents"].as_array().unwrap():
        assert_eq(string_member(document, "origin"), "registry")
    assert_true(description["vcs"].is_null())
    assert_eq(canonical(description["taxonomy"]).unwrap(), "{\"categories\":[],\"keywords\":[]}")


def test_an_adoption_document_is_held_to_its_committed_bytes() -> None:
    directory = TemporaryDirectory.try_new().unwrap()
    root = directory.path()
    readme = b"# leaf\n"
    digest = digest_bytes(readme)
    adoption = leaf("1.2.0")
    mut payload = adoption_payload(adoption, digest_text(render_adopted_manifest(adoption)), digest_text("archive leaf"))
    payload["documents"] = JsonValue.array([JsonValue.object({
        "role": JsonValue.string("readme"),
        "path": JsonValue.string("README.md"),
        "digest": JsonValue.string(digest),
        "bytes": JsonValue.int(len(readme)),
        "format": JsonValue.string("markdown"),
        "origin": JsonValue.string("package"),
    })])
    append_event(root, "adopt", "leaf", "1.2.0", "tests", payload).unwrap()
    # Its bytes are not in the checkout yet, then are, then are not what the digest says.
    assert_true(refusal(root).contains("which the checkout lacks"))
    (root / "content" / "sha256").mkdir(parents=true, exist_ok=true).unwrap()
    (root / "content" / "sha256" / digest[7:]).write_bytes(readme).unwrap()
    assert_eq(refusal(root), "")
    (root / "content" / "sha256" / digest[7:]).write_bytes(b"# other\n").unwrap()
    assert_true(refusal(root).contains("does not hold its bytes"))
